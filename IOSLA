def _v012_graph(results:dict)->tuple[dict,dict]:
    """A directed graph over *observed BL callsites*. No edge inferred for BLR."""
    private={};out=[];summary={};unresolved={}
    for label,sc in results.items():
        imgs=sc.get('images',{})
        indices={k:_v011_function_lookup(v) for k,v in imgs.items()}
        nodes={}
        for key,img in imgs.items():
            for f in img.get('functions',[]):
                nodes[(key,f['vmaddr'])]={'incoming':Counter(),'outgoing':Counter(),
                                          'incoming_fingerprints':Counter(),
                                          'outgoing_fingerprints':Counter()}
        edges=Counter();outside=Counter()
        for from_img,img in imgs.items():
            for call in img.get('direct_calls',[]):
                src=call.get('from_function'); dst_img=call.get('image')
                if (from_img,src) not in nodes:
                    outside['origem_sem_funcao_indexada']+=1; continue
                if dst_img not in indices or call.get('state')!='secao_executavel_unica':
                    outside['destino_fora_do_foco']+=1;continue
                starts,funcs=indices[dst_img]
                target=_v011_owning_function(int(call['target_vmaddr'],16),starts,funcs)
                if not target:
                    outside['destino_sem_limites']+=1;continue
                dst=target['vmaddr']
                edges[(from_img,src,dst_img,dst)]+=1
        func_ref={(im,f['vmaddr']):f for im,img in imgs.items() for f in img.get('functions',[])}
        for (si,s,di,d),n in edges.items():
            src=nodes[(si,s)];dst=nodes[(di,d)]
            src['outgoing'][_v012_family(di)]+=n
            dst['incoming'][_v012_family(si)]+=n
            src['outgoing_fingerprints'][func_ref[(di,d)]['opcode_sha256'][:20]]+=1
            dst['incoming_fingerprints'][func_ref[(si,s)]['opcode_sha256'][:20]]+=1
        private[label]=nodes
        all_edges=sum(edges.values());ordered=sorted(edges.items(),key=lambda t:(-t[1],t[0]))
        out.append({'firmware':label,'function_nodes':len(nodes),'edges_unique':len(edges),
                    'bl_sites_mapped_in_graph':all_edges,
                    'unmapped':dict(outside),'edges_truncated_for_output':len(edges)>V012_GRAPH_OUTPUT_LIMIT,
                    'edges':[{'caller_image':e[0],'caller_function':e[1],
                              'target_image':e[2],'target_function':e[3], 'calls':n}
                             for e,n in ordered[:V012_GRAPH_OUTPUT_LIMIT]]})
        summary[label]={'function_nodes':len(nodes),'unique_edges':len(edges),
                         'resolved_call_sites':all_edges, 'ignored_call_sites':sum(outside.values())}
        unresolved[label]=dict(outside)
    return private,{'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'grafo dirigido de chamadas BL observadas nos componentes prioritários',
      'summary':summary,'firmwares':out,
      'limitations':['Somente chamadas BL com função de destino identificável.',
         'Ausência de uma aresta não prova ausência da chamada ou do vínculo em runtime.',
         'Chamadas indiretas autenticadas são contabilizadas à parte, sem destino inferido.']}


def _v012_context_features(g:dict|None)->tuple[set[str],int]:
    if not g:return set(),0
    feats=set()
    for key,val in g['incoming'].items():
        feats.add('IN_IMAGE:'+key)
    for key,val in g['outgoing'].items():
        feats.add('OUT_IMAGE:'+key)
    for key,val in g['incoming_fingerprints'].items():
        feats.add('IN_HASH:'+key)
    for key,val in g['outgoing_fingerprints'].items():
        feats.add('OUT_HASH:'+key)
    anchors=sum('HASH:' in x for x in feats)
    return feats,anchors


def _v012_match_context(f:dict,target_image:dict,source_context:dict|None,dest_context:dict|None,
                         image_name:str)->dict:
    """High-precision candidate supplement, not replacement for legacy match.

    Requires >=2 independent shared hash-context anchors and discriminative margin.
    Identical short functions alone are insufficient.
    """
    if not target_image or not target_image.get('functions') or not source_context or not dest_context:
        return {'state':'dados_insuficientes','candidates':[],'reason':'grafo_ou_funcoes_ausentes'}
    sf,na=_v012_context_features(source_context)
    if na<2:
        return {'state':'contexto_insuficiente','candidates':[],
                'reason':'menos_de_duas_ancoras_de_contexto_na_origem'}
    n=f['instructions_scanned']
    if n<2 or f.get('truncated'):
        return {'state':'inspecao_incompleta','candidates':[]}
    scores=[]
    for cand in target_image['functions']:
        m=cand['instructions_scanned']
        if cand.get('truncated') or m<2 or abs(n-m)>max(4,int(n*.26)):
            continue
        cf,nc=_v012_context_features(dest_context.get((image_name,cand['vmaddr'])))
        common=sf&cf
        anchored=sum('HASH:' in z for z in common)
        if anchored<2:
            continue
        jacc=len(common)/max(1,len(sf|cf))
        a=f['opcode_histogram']; b=cand['opcode_histogram']; keys=set(a)|set(b)
        overlap=1-sum(abs(a.get(k,0)/n-b.get(k,0)/m) for k in keys)/2
        length=1-abs(n-m)/max(n,m)
        score=.50*jacc+.30*overlap+.20*length
        if score>=.82:
            scores.append((score,anchored,cand))
    scores.sort(key=lambda t:(-t[0],-t[1],t[2]['vmaddr']))
    sample=[{'vmaddr':c['vmaddr'],'score':round(s,4),'shared_context_anchors':a}
            for s,a,c in scores[:V012_CANDIDATE_LIMIT]]
    if scores and scores[0][0]>=.89 and scores[0][1]>=2 and (
        len(scores)==1 or scores[0][0]-scores[1][0]>=.13):
        return {'state':'candidato_contextual_unico','candidates':sample[:1],
                'reason':'assinatura_de_fluxo_mais_contexto_independente',
                'abi_contract':'nao_demonstrado'}
    if scores:return {'state':'contexto_ambiguo','candidates':sample,
                      'reason':'sem_margem_discriminativa_suficiente'}
    return {'state':'contexto_sem_candidato','candidates':[],'reason':'nenhuma_correspondencia_aceita'}



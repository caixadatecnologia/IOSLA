def _v012_arm_audit(results:dict)->dict:
    images=[];total=Counter()
    for label,sc in results.items():
        for name,img in sc.get('images',{}).items():
            audit=img.get('v012_audit',{})
            if audit.get('status')!='analisado':continue
            counts=audit['instructions_by_class']; total.update(counts)
            images.append({'firmware':label,'image':name,'functions_scanned':len(img['functions']),
             'instructions_by_class':counts,'invalid_function_windows':audit['invalid_function_windows'],
             'auth_instruction_examples':audit['sample_auth_instructions'][:8],
             'truncation':img.get('coverage',{}).get('functions_with_instruction_limit',0)})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'auditoria conservadora da classificacao de instrucoes ARM64e',
            'summary':{'images_scanned':len(images),'instruction_classes':dict(total),
                       'llvm_external_validation':'comando_opcional_--v012-verify-llvm'},
            'images':images,
            'limitations':['Não é um desassemblador completo; algumas classes vêm do classificador legado.',
                           'Um zero em instruções indiretas reconhecidas NÃO prova sua ausência.',
                           'Alvos de BLRAA/BLRAB não são calculados sem análise de fluxo de dados.']}


def _v012_generate(results:dict, inputs:dict|None=None,snaps:dict|None=None,
                  device_report:dict|None=None,hardware_report:dict|None=None, errors:dict|None=None)->list[tuple[str,dict]]:
    _calls,cont=_v011_continuity(results)
    graph_priv,graph=_v012_graph(results)
    contextual=_v012_contextual(results,cont,graph_priv)
    abi=_v012_abi_evidence(results,contextual)
    hardware=_v012_hardware(inputs,snaps,device_report,hardware_report)
    audit=_v012_arm_audit(results)
    reports=[('ARM64E_AUDIT',audit),('CALL_GRAPH',graph),('CONTEXTUAL_MATCH',contextual),
             ('ABI_EVIDENCE',abi),('A12_COMPATIBILITY',hardware)]
    if errors:
        for _,rep in reports:rep['errors']=errors
    return reports



def _v009_self_test():
    import tempfile
    # Cross-image fileoff test: second Mach-O's executable code and __LINKEDIT
    # are far beyond the end of the next LC_FILESET_ENTRY range.
    blob=bytearray(12800)
    def pack_seg(segname,vmaddr,fileoff,filesize,section=None):
        sections = []
        if section:
            secname,addr,length,offset=section
            sections.append(struct.pack('<16s16sQQIIIIIIII',secname.encode().ljust(16,b'\0'),
                segname.encode().ljust(16,b'\0'),addr,length,offset,2,0,0,0x80000400,0,0,0))
        n=len(sections)
        return (struct.pack('<II16sQQQQiiII',LC_SEGMENT_64,72+80*n,
                segname.encode().ljust(16,b'\0'),vmaddr,filesize,fileoff,filesize,7,5,n,0)
                +b''.join(sections))
    # Two child entries. First child's segment data follows the NEXT entry's offset.
    entryname=b'com.apple.AGXG11P\0'
    item=struct.pack('<IIQQII',LC_FILESET_ENTRY,32+len(entryname),0x110000,512,32,0)+entryname
    secondname=b'com.example.Second\0'
    item2=struct.pack('<IIQQII',LC_FILESET_ENTRY,32+len(secondname),0x150000,2048,32,0)+secondname
    root_seg=pack_seg('__TEXT',0x10000,0,512)
    h=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,3,len(root_seg)+len(item)+len(item2),0,0)
    blob[0:len(h+root_seg+item+item2)]=h+root_seg+item+item2
    # Child text contains header, while its real executable code lives at 6000,
    # its LC_FUNCTION_STARTS is in __LINKEDIT around 9010.
    childseg=pack_seg('__TEXT',0x120000,512,512)
    executable=pack_seg('__TEXT_EXEC',0x130000,6000,120,('__text',0x130000,120,6000))
    linkedit=pack_seg('__LINKEDIT',0x140000,9000,100)
    fs=struct.pack('<IIII',V008_LC_FUNCTION_STARTS,16,9010,4)
    cb=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,4,
                   len(childseg)+len(executable)+len(linkedit)+len(fs),0,0)
    blob[512:512+len(cb+childseg+executable+linkedit+fs)]=cb+childseg+executable+linkedit+fs
    sec2=pack_seg('__TEXT',0x150000,2048,256)
    h2=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,1,len(sec2),0,0)
    blob[2048:2048+len(h2+sec2)]=h2+sec2
    blob[6000:6120]=b'\xaa\xbb\xcc\xdd'*30
    blob[9010:9014]=b'\x01\x02\x03\x00'
    scan=_v009_scan_decoded(bytes(blob),'teste fileset')
    assert len(scan['images'])==3
    driver=scan['images']['com.apple.AGXG11P']
    assert driver['coordinate_system']['model']=='fileset_absoluto',driver
    section=driver['sections']['__TEXT_EXEC,__text']
    assert section['file_mapping']['state']=='resolvido',section
    assert section['file_mapping']['offset']==6000
    assert driver['image_region_end']==2048, driver['image_region_end']
    assert section['file_mapping']['offset']>driver['image_region_end']
    assert section['file_mapping']['hash_sha256']==hashlib.sha256(bytes(blob[6000:6120])).hexdigest()
    assert driver['function_starts']['state']=='delimitado',driver['function_starts']
    assert driver['function_starts']['count']==3
    assert driver['function_starts']['file_offset']==9010
    assert _v009_outcome(driver,driver)['state']=='bytes_iguais'
    other={'sections':{'__TEXT_EXEC,__text':{'size':120,'file_mapping':{'state':'resolvido','hash_sha256':'f'*64}}}}
    assert _v009_outcome(driver,other)['state']=='bytes_diferentes'
    # Root Mach-O using image-relative fileoffs when image starts at >0.
    variant=bytearray(blob)
    # In child __TEXT fileoff field is at +32(header)+40 inside segment.
    struct.pack_into('<Q',variant,512+32+40,0)
    # Do not demand valid sections on the image-relative variant; anchor is enough.
    row=_v009_scan_image(bytes(variant),'com.apple.AGXG11P',512,12800)
    assert row['coordinate_system']['model']=='imagem_relativa',row['coordinate_system']
    # Incomparable A↔B must not prevent comparing the SAME iPhone 11 B↔C.
    def k(name,version):return Kext(name,version)
    a=Snapshot('ORIGEM','mock','synthetic',{'one':k('one','1')},ios_version='18.7.10',build='B',device='iPhone11,2')
    b=Snapshot('CONTROLE','mock','synthetic',{'one':k('one','1')},ios_version='18.6.2',build='A',device='iPhone12,1')
    c=Snapshot('DESTINO','mock','synthetic',{'one':k('one','2')},ios_version='27.0.1',build='C',device='iPhone12,1')
    tri=make_triangulation_v008({'ORIGEM':a,'CONTROLE':b,'DESTINO':c})
    assert tri['summary']['patterns']['mesmo_modelo_metadados_modificados']==1
    assert tri['summary']['control_vs_target_versions']['versao_alterada']==1
    assert 'nao_isola_hardware' in tri['pairwise_interpretation']['A_B']
    assert 'mesmo_modelo' in tri['pairwise_interpretation']['B_C']
    with tempfile.TemporaryDirectory(prefix='iosla9_') as td:
        for prefix,rep,renderer in [('ABI_DELTA',_v009_make_delta({'ORIGEM':scan,'DESTINO':scan}),_v009_delta_md),
                                    ('TRIANGULACAO',tri,_v009_triangulation_md)]:
            jp,md=_v008_export(prefix,rep,renderer,Path(td))
            assert jp.is_file() and md.is_file()
            assert json.loads(jp.read_text())['iosla_version']=='0.0.9'
    print('IOSLA v0.0.9: offsets globais fileset, __TEXT_EXEC, LC_FUNCTION_STARTS e triangulação por par OK.')



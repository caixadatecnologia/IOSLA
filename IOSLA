def analyze_drivers():
    header()
    section("ANALISE DE KERNELCACHES E DRIVERS")

    if not source and not target:
        print_error("Selecione pelo menos um IPSW.")
        pause()
        return

    for label, info in (
        ("FIRMWARE ORIGINAL", source),
        ("FIRMWARE DESTINO", target),
    ):

        if info is None:
            continue

        section(label)

        print()
        print(" iOS:", info["version"])
        print(" Kernelcaches localizados:", len(info["kernels"]))

        for kernel in info["kernels"][:30]:
            print(
                C.CYAN + " [KERNEL] " + C.RESET +
                shorten(kernel, 65)
            )

        print()
        print(" Componentes de firmware:")
        print()

        for name, paths in info["components"].items():

            if classify_component(name) in (
                "Kernel",
                "Hardware/Firmware",
                "Device Tree",
                "Secure Enclave",
            ):
                print(" ", C.BLUE + name + C.RESET)

                for path in paths[:3]:
                    print(
                        C.GRAY + "    " +
                        shorten(path, 67) +
                        C.RESET
                    )

        print()
        print(" KEXTs diretamente visiveis no ZIP:",
              len(info["kext_files"]))

        for item in info["kext_files"][:30]:
            print("  ", item)

        if not info["kext_files"]:
            print_info(
                "Nenhuma KEXT separada identificada. "
                "Drivers do iOS podem estar incorporados "
                "ao kernelcache."
            )

    section("LIMITACOES DA ANALISE")

    print("""
 Este analisador examina arquivos e manifestos IPSW.

 Para descobrir as KEXTs incorporadas, e necessario
 analisar o kernelcache com ferramentas adicionais.

 A existencia de uma KEXT antiga nao significa que
 ela funcionara em um kernel mais recente.
""")

    pause()



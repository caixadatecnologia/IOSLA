def read_plist(archive, filename):
    try:
        return plistlib.loads(archive.read(filename))
    except KeyError:
        return {}
    except (ValueError, TypeError, plistlib.InvalidFileException):
        return {}


def get_component_paths(build_manifest):
    """
    Reune referencias de componentes presentes
    nas identidades do BuildManifest.

    Nao extrai nem descompila os componentes.
    """

    components = {}

    identities = build_manifest.get("BuildIdentities", [])

    if not isinstance(identities, list):
        return components

    for identity in identities:

        manifest = identity.get("Manifest", {})

        if not isinstance(manifest, dict):
            continue

        for name, data in manifest.items():

            if not isinstance(data, dict):
                continue

            info = data.get("Info", {})

            if not isinstance(info, dict):
                continue

            path = info.get("Path")

            if isinstance(path, str):
                components.setdefault(name, set()).add(path)

    return {
        name: sorted(paths)
        for name, paths in sorted(components.items())
    }


def classify_component(name):
    lower = name.lower()

    categories = [
        (("kernel",), "Kernel"),
        (("sep", "sepfw"), "Secure Enclave"),
        (("baseband", "bbfw"), "Baseband"),
        (("devicetree",), "Device Tree"),
        (("trustcache",), "Trust Cache"),
        (("iboot", "ibec", "ibss", "llb"), "Boot"),
        (("ramdisk",), "Ramdisk"),
        (("restore",), "Restore"),
        (("aop", "isp", "ans", "wifi"), "Hardware/Firmware"),
    ]

    for words, category in categories:
        if any(word in lower for word in words):
            return category

    return "Outros"


def inspect_ipsw(path):
    """
    Analisa somente metadados e entradas ZIP.

    Nao altera o IPSW e nao extrai conteudo
    para o disco.
    """

    path = Path(path).expanduser().resolve()

    if not path.is_file():
        raise FileNotFoundError("Arquivo nao encontrado.")

    if not zipfile.is_zipfile(path):
        raise ValueError("O arquivo nao e um ZIP/IPSW valido.")

    with zipfile.ZipFile(path, "r") as archive:

        members = archive.infolist()

        names = [member.filename for member in members]

        name_set = set(names)

        manifest = read_plist(
            archive,
            "BuildManifest.plist"
        )

        restore = read_plist(
            archive,
            "Restore.plist"
        )

        version = (
            manifest.get("ProductVersion")
            or restore.get("ProductVersion")
            or "Desconhecida"
        )

        build = (
            manifest.get("ProductBuildVersion")
            or restore.get("ProductBuildVersion")
            or "Desconhecida"
        )

        devices = manifest.get(
            "SupportedProductTypes", []
        )

        if not isinstance(devices, list):
            devices = []

        components = get_component_paths(manifest)

        kernel_files = sorted(
            name for name in names
            if "kernelcache" in name.lower()
        )

        kext_files = sorted(
            name for name in names
            if ".kext/" in name.lower()
            or name.lower().endswith(".kext")
        )

        firmware_files = sorted(
            name for name in names
            if name.lower().startswith("firmware/")
        )

        zip_metadata = {
            member.filename: {
                "size": member.file_size,
                "crc": member.CRC
            }
            for member in members
            if not member.is_dir()
        }

    referenced = sorted({
        item
        for paths in components.values()
        for item in paths
    })

    missing_references = [
        item for item in referenced
        if item not in name_set
    ]

    return {
        "path": str(path),
        "filename": path.name,
        "file_size": path.stat().st_size,
        "version": str(version),
        "build": str(build),
        "devices": sorted(set(map(str, devices))),
        "components": components,
        "kernels": kernel_files,
        "kext_files": kext_files,
        "firmware_files": firmware_files,
        "files": names,
        "file_metadata": zip_metadata,
        "missing_references": missing_references,
        "file_count": len(names),
        "identity_count": len(
            manifest.get("BuildIdentities", [])
        ),
        "has_manifest": bool(manifest),
        "has_restore_plist": bool(restore),
    }



def _v014_examine(data:bytes,structural_scan:dict,name:str,region_starts:list[int],regions:list[dict])->dict:
    obj=_v014_old_examine(data,structural_scan,name,region_starts,regions)
    if obj.get('status')!='funcoes_e_chamadas_indexadas':return obj
    if name not in ('com.apple.AGXG11P','com.apple.AGXG12P','com.apple.iokit.IOGPUFamily',

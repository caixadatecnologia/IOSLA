def metadata_for(info, path):
    return info["file_metadata"].get(path)


def compare_component(name, old, new):

    old_paths = old["components"].get(name, [])
    new_paths = new["components"].get(name, [])

    if not old_paths:
        status = "ADICIONADO"

    elif not new_paths:
        status = "REMOVIDO"

    elif old_paths != new_paths:
        status = "CAMINHO DIFERENTE"

    else:
        changes = []

        for path in old_paths:

            old_meta = metadata_for(old, path)
            new_meta = metadata_for(new, path)

            if old_meta is None or new_meta is None:
                changes.append("SEM DADOS")
                continue

            same_crc = (
                old_meta["crc"] == new_meta["crc"]
                and old_meta["size"] == new_meta["size"]
            )

            changes.append(
                "IGUAL" if same_crc else "CONTEUDO DIFERENTE"
            )

        if all(x == "IGUAL" for x in changes):
            status = "IDENTICO"

        elif "CONTEUDO DIFERENTE" in changes:
            status = "CONTEUDO DIFERENTE"

        else:
            status = "NAO VERIFICADO"

    return {
        "name": name,
        "category": classify_component(name),
        "status": status,
        "old_paths": old_paths,
        "new_paths": new_paths,
    }


def run_comparison():
    if not source or not target:
        print_error("Selecione os dois IPSWs primeiro.")
        return None

    names = sorted(
        set(source["components"])
        | set(target["components"])
    )

    components = [
        compare_component(name, source, target)
        for name in names
    ]

    summary = {}

    for item in components:
        key = item["status"]
        summary[key] = summary.get(key, 0) + 1

    return {
        "date": datetime.now().isoformat(timespec="seconds"),
        "source": {
            "filename": source["filename"],
            "version": source["version"],
            "build": source["build"],
            "devices": source["devices"],
        },
        "target": {
            "filename": target["filename"],
            "version": target["version"],
            "build": target["build"],
            "devices": target["devices"],
        },
        "summary": summary,
        "components": components,
        "note": (
            "A comparacao usa caminhos, tamanhos e CRC32 "
            "das entradas ZIP. Nao verifica interfaces de "
            "kernel, dependencias de KEXTs ou compatibilidade "
            "de drivers. Referencias com caminhos diferentes "
            "nao sao necessariamente binarios diferentes."
        )
    }


def status_color(status):
    if status == "IDENTICO":
        return C.GREEN
    if status == "ADICIONADO":
        return C.CYAN
    if status == "REMOVIDO":
        return C.RED
    if status == "CONTEUDO DIFERENTE":
        return C.YELLOW
    return C.PURPLE


def show_comparison():
    global last_comparison

    header()
    section("COMPARACAO DE COMPONENTES")

    comparison = run_comparison()

    if comparison is None:
        pause()
        return

    last_comparison = comparison

    print()

                     'V013_REGRESSION_PROVENANCE')
V013_DOC_LIMIT = 250
V013_REPORT_MAX_BYTES = 40 * 1024 * 1024
V013_LEGACY_GOOD = frozenset(('bytes_identicos_unicos', 'estrutura_candidata_unica'))


def _v013_origin(row:dict)->tuple[str,str]:
    return (row.get('library',''),row.get('origin_target_function', row.get('function_origin','')))


def _v013_candidate(match:dict|None)->str|None:
    if not isinstance(match,dict) or match.get('state') not in (
        'bytes_identicos_unicos','estrutura_candidata_unica','candidato_contextual_unico'):
        return None
    candidates=match.get('candidates',[])
    return candidates[0].get('vmaddr') if len(candidates)==1 else None


def _v013_prioritize(row:dict)->tuple[str,list[str]]:
    reasons=[];count=row['calls'];status=row['a_to_c']['state']
    if row['issues']:
        reasons.append('revisar conflitos: '+', '.join(row['issues']))
    if not row['destination_candidates']['direct']:
        reasons.append('nenhum candidato único direto aceito')
    if status=='funcao_curta_ou_truncada':
        reasons.append('função curta ou instruções truncadas')
    if 'ambigu' in status or status=='padrao_ambiguo':
        reasons.append('múltiplos correspondentes plausíveis')
    if status=='sem_correspondencia_observada':
        reasons.append('sem correspondente aceito na comparação direta')
    if row['context_status']=='not_run':
        reasons.append('laboratório contextual ainda não executado para este alvo')
    if count>=10 and (row['issues'] or not row['destination_candidates']['direct']):
        return 'critica',reasons
    if count>=5 or row['issues'] or not row['destination_candidates']['direct']:
        return 'alta',reasons
    return 'normal',reasons


def _v013_make_triage(documents:dict)->tuple[dict,dict]:
    continuity=documents['ABI_CONTINUITY']; context=documents.get('CONTEXTUAL_MATCH',{})
    abi=documents.get('ABI_EVIDENCE',{})
    contextual_rows={_v013_origin(r):r for r in context.get('targets',[]) if isinstance(r,dict)}
    abi_rows={_v013_origin(r):r for r in abi.get('targets',[]) if isinstance(r,dict)}
    source=continuity.get('targets',[])
    if not isinstance(source,list) or len(source)>100000:
        raise IOSLAError('Relatório ABI_CONTINUITY contém alvos inválidos ou excessivos.')
    rows=[]; direct_destinations=Counter()
    for obj in source:
        if not isinstance(obj,dict):continue
        lib,address=_v013_origin(obj)
        direct=_v013_candidate(obj.get('a_to_c',{}))
        if direct:direct_destinations[(lib,direct)]+=1
    priorities=Counter();status_counts=Counter();reason_counts=Counter();weighted=Counter()
    for obj in source:
        if not isinstance(obj,dict):continue
        lib,address=_v013_origin(obj);count=max(0,int(obj.get('calls_from_agxg11p',0)))
        ab=_v013_candidate(obj.get('a_to_b'));bc=_v013_candidate(obj.get('b_to_c'))
        direct=_v013_candidate(obj.get('a_to_c'))
        ctx=contextual_rows.get((lib,address),{})
        inferred=ctx.get('contextual_A_C',{})
        contextual=_v013_candidate(inferred)
        issues=[]
        if direct and bc and direct!=bc:
            issues.append('direct_vs_two_step_disagreement')
        if direct and contextual and direct!=contextual:
            issues.append('direct_vs_context_disagreement')
        if direct and direct_destinations[(lib,direct)]>1:
            issues.append('candidate_shared_by_multiple_origin_functions')
        if contextual and not direct:
            context_status='contextual_candidate_needs_independent_validation'
        elif ctx:
            context_status=inferred.get('state','not_calculated')
        else:context_status='not_run'
        abi_rec=abi_rows.get((lib,address),{}).get('memory_loadstore_x0_to_x7_and_sp',{})
        evidence_state=abi_rec.get('state','not_run')
        base=obj.get('a_to_c',{}).get('state','desconhecido')
        row={'library':lib,'origin_function':address,'calls':count,
             'callers':obj.get('origin_unique_callers'),
             'a_to_b':obj.get('a_to_b',{}).get('state','unknown'),
             'a_to_c':{'state':base,'candidate_count':len(obj.get('a_to_c',{}).get('candidates',[]))},
             'b_to_c':obj.get('b_to_c',{}).get('state','unknown'),
             'triangulation':obj.get('triangulation_state','unknown'),
             'destination_candidates':{'direct':direct,'via_control':bc,'contextual':contextual},
             'context_status':context_status,'abi_observation':evidence_state,
             'issues':issues,'source_callsite_examples':obj.get('callsite_examples',[])[:3],
             'abi_contract':'nao_demonstrado'}
        row['priority'],row['review_reasons']=_v013_prioritize(row)
        priorities[row['priority']]+=1;status_counts[base]+=1;weighted[base]+=count
        reason_counts.update(issues)
        rows.append(row)
    ranks={'critica':0,'alta':1,'normal':2}
    rows.sort(key=lambda row:(ranks[row['priority']],-row['calls'],row['library'],row['origin_function']))
    for i,row in enumerate(rows,1):row['research_order']=i
    summary={'targets':len(rows),'total_calls_to_target_libraries':sum(x['calls'] for x in rows),
             'priority_counts':dict(priorities),'baseline_states':dict(status_counts),
             'callsite_weighted_baseline_states':dict(weighted),
             'consistency_issues':dict(reason_counts),
             'contextual_report_available':bool(context),'abi_evidence_report_available':bool(abi)}
    report={'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'triagem explicável dos alvos gráficos por frequência e incerteza',
            'summary':summary,'targets':rows,
            'limitations':['Prioridade ordena pesquisa, NÃO é pontuação de viabilidade ou compatibilidade.',
               'Ausência de candidato observado não significa ausência de função equivalente.',
               'Sem relatório contextual, nenhuma nova correspondência é inferida.',
               'Evidências ABI e hardware não foram verificadas por execução.']}
    private={'context':contextual_rows,'abi':abi_rows,'continuity':{_v013_origin(r):r for r in source if isinstance(r,dict)}}
    return report,private


def _v013_match_audit(triage:dict)->dict:
    issues=Counter();multi=[];same=[];candidate_count=Counter()
    for row in triage['targets']:
        issues.update(row['issues'])
        for field,target in row['destination_candidates'].items():
            if target:candidate_count[field]+=1
        if row['issues']:
            multi.append({'library':row['library'],'origin_function':row['origin_function'],
                          'calls':row['calls'],'issues':row['issues'],
                          'candidates':row['destination_candidates']})
        if row['destination_candidates']['direct'] and row['destination_candidates']['via_control'] == row['destination_candidates']['direct']:
            same.append({'library':row['library'],'origin_function':row['origin_function'],
                         'destination_candidate':row['destination_candidates']['direct'],
                         'calls':row['calls']})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
        'mode':'auditoria de consistência de correspondências entre passes e fontes',
        'summary':{'targets_compared':len(triage['targets']), 'issues_by_type':dict(issues),
                   'unique_candidates_by_method':dict(candidate_count),
                   'direct_and_chain_same_candidate':len(same),
                   'direct_and_chain_disagreement':issues['direct_vs_two_step_disagreement']},
        'disagreements_and_collisions':multi[:V013_DOC_LIMIT],
        'consistent_candidate_examples':same[:50],
        'limitations':['Concordância entre métodos relacionados NÃO demonstra independência nem ABI compatível.',
             'Múltiplas funções antigas associadas ao mesmo candidato recente exigem revisão.',
             'Não é um verificador de ABI ou de nomes/protótipos simbólicos.']}


def _v013_dossier(triage:dict,private:dict,documents:dict)->dict:
    details=[]
    for row in triage['targets'][:V013_DOC_LIMIT]:
        key=(row['library'],row['origin_function'])
        origin=private['continuity'].get(key,{})
        ctx=private['context'].get(key,{})
        abi=private['abi'].get(key,{})
        details.append({'research_order':row['research_order'], 'library':row['library'],
            'origin_function':row['origin_function'], 'calls':row['calls'], 'priority':row['priority'],
            'origin_caller_count':row['callers'],
            'origin_fingerprint':origin.get('source_fingerprint',{}),
            'source_callsite_examples':row['source_callsite_examples'],
            'direct_match':origin.get('a_to_c',{}),'match_via_control':origin.get('b_to_c',{}),
            'contextual_match':ctx.get('contextual_A_C',{'state':'not_run','candidates':[]}),
            'memory_evidence':abi.get('memory_loadstore_x0_to_x7_and_sp',{'state':'not_run'}),
            'consistency_issues':row['issues'],'questions_to_verify':row['review_reasons'],
            'evidence_level':'binaria_estatica_observacional','abi_contract':'nao_demonstrado'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
        'mode':'dossiês auditáveis de funções referenciadas pelo driver gráfico',
        'summary':{'dossiers':len(details),'available':len(triage['targets']),
                   'export_limit':V013_DOC_LIMIT,'records_truncated':len(triage['targets'])>V013_DOC_LIMIT},
        'dossiers':details,
        'limitations':['Os protótipos e layouts C++ continuam desconhecidos.',
            'Comparar X0–X7/SP e padrões LDR/STR não recupera argumentos de forma confiável.',
            'Dossiês servem à revisão técnica, não ao carregamento ou modificação de drivers.']}


def _v013_hardware_bridge(documents:dict)->dict:
    fw=documents.get('GPU_FIRMWARE',{}).get('firmwares',[])
    hardware=documents.get('A12_COMPATIBILITY',{})
    evidence=documents.get('EVIDENCIAS',{})
    byfw={}
    for f in fw:
        if not isinstance(f,dict):continue
        paths=f.get('manifest_component_paths',{})
        byfw[f.get('firmware','?')]={'device':f.get('device'), 'ios_version':f.get('ios_version'),
              'build':f.get('build'), 'GFX_paths':paths.get('GFX',[]),
              'graphical_kext_versions':f.get('graphical_kext_versions',{}),
              'firmware_payload_inspected':f.get('firmware_payload_inspection','unknown')}
    matches=[]
    for r in evidence.get('associations',[]):
        if not isinstance(r,dict) or r.get('kext') not in ('com.apple.AGXG11P','com.apple.AGXG12P'):
            continue
        if len(matches)>=30:break
        matches.append({'firmware':r.get('device'), 'driver':r.get('kext'),
            'device_tree_node':r.get('node_path'), 'personality':r.get('personality'),
            'matching_keys':r.get('observed_matching_keys',[]),
            'unverified_conditions':r.get('unverified_conditions',[]),
            'assessment':r.get('assessment','somente coincidencia textual')})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
        'mode':'separação de pistas entre kernel, hardware gráfico e firmwares auxiliares',
        'summary':{'firmwares_with_metadata':len(byfw),'gpu_iokit_text_witnesses':len(matches),
                   'device_tree_report_available':bool(documents.get('DEVICETREE')),
                   'hardware_report_available':bool(documents.get('HARDWARE'))},
        'firmwares':byfw,'gpu_iokit_evidence':matches,
        'device_tree_counts':(documents.get('DEVICETREE',{}).get('comparison',{})),
        'previous_a12_dossier':{'summary':hardware.get('summary',{}),
            'requirements_unverified':hardware.get('requirements_unverified',[])},
        'questions_unresolved':['A12/G11P and A13/G12P GPU hardware are different',
                 'GFX firmware payload protocol and runtime negotiation not verified',
                 'IOKit personality text matches do not validate runtime provider matching',
                 'A/B use different iOS 18 builds; hardware effect cannot be isolated'],
        'limitations':['Firmware paths are not binary firmware identities; content was not compared.',
             'Reports cannot demonstrate ABI equivalence, executable firmware compatibility, or boot.']}


def _v013_regression_provenance(documents:dict,provenance:dict,triage:dict,baseline:dict|None=None)->dict:
    current=triage['summary'];base=(baseline or {}).get('ABI_CONTINUITY',{}).get('summary',{})
    prev=(baseline or {}).get('V013_UNRESOLVED_TRIAGE',{}).get('summary',{})
    current_source=documents['ABI_CONTINUITY'].get('summary',{})
    comparison={'state':'baseline_not_supplied'}
    if base:
        keys=('source_direct_calls_stored','targets_identified','with_unique_A_C_candidate')
        comparison={'state':'descriptive_comparison_only',
             'metrics':{key:{'baseline':base.get(key), 'current':current_source.get(key),
                'difference':(current_source.get(key)-base.get(key) if
                     isinstance(current_source.get(key),(int,float)) and isinstance(base.get(key),(int,float)) else None)}
                   for key in keys}}
        if baseline.get('_baseline_fingerprints') and baseline['_baseline_fingerprints'].get('ABI_CONTINUITY')==provenance.get('ABI_CONTINUITY',{}).get('sha256'):
            comparison['state']='same_baseline_report_no_new_measurement'
    if prev:
        comparison['old_triage_priorities']=prev.get('priority_counts',{})
    source_count=current_source.get('targets_reported')
    coverage={'target_summary_matches_rows':source_count==len(documents['ABI_CONTINUITY'].get('targets',[])),
       'triage_matches_continuity':current['targets']==len(documents['ABI_CONTINUITY'].get('targets',[])),
       'calls_to_targets_match':current['total_calls_to_target_libraries']==current_source.get('calls_to_reported_targets'),
       'contextual_report_loaded':'CONTEXTUAL_MATCH' in documents,
       'real_macos_kernelcache_redecoded_in_this_audit':False}
    source_versions={key:doc.get('iosla_version') for key,doc in documents.items()}
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'trilha de proveniência SHA-256 dos relatórios e comparação descritiva de regressão',
       'summary':{'input_reports':len(provenance),'coverage_checks_passed':sum(bool(v) for k,v in coverage.items() if k in
           ('target_summary_matches_rows','triage_matches_continuity','calls_to_targets_match')),
           'coverage_checks_total':3,'regression_state':comparison['state']},
       'input_reports':provenance,'input_report_versions':source_versions,
       'consistency_checks':coverage,'regression':comparison,
       'limitations':['O modo --audit-reports examina relatórios anteriores; não descomprime o kernelcache novamente.',
                      'Comparação de métricas não mede melhora de precisão ou compatibilidade de firmware.',
                      'SHA-256 é rastreabilidade do arquivo JSON, não autenticação do conteúdo.']}


def _v013_documents(documents:dict,provenance:dict|None=None,baseline:dict|None=None)->list[tuple[str,dict]]:
    if not all(isinstance(documents.get(k),dict) for k in V013_REQUIRED):
        missing=[k for k in V013_REQUIRED if k not in documents]
        raise IOSLAError('Relatórios obrigatórios ausentes: '+', '.join(missing))
    triage,private=_v013_make_triage(documents)
    match=_v013_match_audit(triage)
    dossier=_v013_dossier(triage,private,documents)
    hardware=_v013_hardware_bridge(documents)
    provenance_report=_v013_regression_provenance(documents,provenance or {},triage,baseline)
    return list(zip(V013_REPORT_TYPES,(triage,match,dossier,hardware,provenance_report)))


def _v013_md(report:dict)->str:
    title=report.get('mode','Pesquisa de compatibilidade por evidência')
    lines=[f'# IOSLA v{APP_VERSION} — {title}','','**Relatório experimental, somente leitura. Nenhuma ABI, port ou inicialização demonstrados.**','',
        '## Resumo','','```json',json.dumps(report.get('summary',{}),ensure_ascii=False,indent=2),'```','']
    if 'targets' in report:
        lines+=['## Investigação priorizada','','| # | Biblioteca | Função origem | Chamadas | Prioridade | A↔C | Revisão |',
           '|---:|---|---|---:|---|---|---|']
        for x in report['targets'][:75]:
            state=x.get('a_to_c',{}).get('state','?')
            lines.append('| {} | `{}` | `{}` | {} | {} | {} | {} |'.format(x['research_order'],
                x['library'].split('.')[-1],x['origin_function'],x['calls'],x['priority'],state,
                ', '.join(x['issues']) or '—'))
        lines+=['',f'Exibindo {min(75,len(report["targets"]))} de {len(report["targets"])} alvos; JSON contém todos.','']
    if 'disagreements_and_collisions' in report:
        lines+=['## Conflitos observados','']
        for r in report['disagreements_and_collisions'][:30]:
            lines.append('- `{}` ({}) — {} chamadas: {}'.format(r['origin_function'],r['library'],r['calls'],', '.join(r['issues'])))
        if not report['disagreements_and_collisions']:lines+=['Nenhum conflito desses tipos foi identificado na amostra.']
        lines+=['']
    if 'dossiers' in report:
        lines+=['## Alvos mais relevantes','']
        for x in report['dossiers'][:20]:
            lines+=['### '+x['library'].split('.')[-1]+' — `'+x['origin_function']+'`','',
              '- Chamadas observadas: '+str(x['calls']),
              '- Candidato direto: '+str(x['direct_match'].get('state','?')),
              '- Contexto: '+str(x['contextual_match'].get('state','not_run')),
              '- Evidência de acesso à memória: '+str(x['memory_evidence'].get('state','not_run')),
              '- ABI: não demonstrada','']
    if 'firmwares' in report:
        lines+=['## Inventário de hardware e firmware','','```json',
              json.dumps(report['firmwares'],ensure_ascii=False,indent=2),'```','']
    if 'regression' in report:
        lines+=['## Regressão / proveniência','','```json',json.dumps(report['regression'],ensure_ascii=False,indent=2),'```','']
    if 'consistency_checks' in report:
        lines+=['## Checagens de coerência','','```json',json.dumps(report['consistency_checks'],ensure_ascii=False,indent=2),'```','']
    lines+=['## Limitações','']+['- '+x for x in report.get('limitations',[])]+['']
    return '\n'.join(lines)


def _v013_load_reports(directory:Path)->tuple[dict,dict]:
    if not directory.is_dir():raise IOSLAError('Pasta de relatórios não encontrada: '+str(directory))
    docs={};provenance={}
    for prefix in (*V013_REQUIRED,*V013_OPTIONAL):
        files=sorted(directory.glob('IOSLA_'+prefix+'_*.json'),key=lambda p:(p.stat().st_mtime_ns,p.name),reverse=True)
        if not files:continue
        file=files[0]
        if file.stat().st_size>V013_REPORT_MAX_BYTES:
            if prefix in V013_REQUIRED:raise IOSLAError('Relatório obrigatório muito grande: '+file.name)
            continue
        blob=file.read_bytes();parsed=json.loads(blob)
        if not isinstance(parsed,dict):raise IOSLAError('Relatório JSON não é um objeto: '+file.name)
        docs[prefix]=parsed
        provenance[prefix]={'file':file.name,'size_bytes':len(blob),'sha256':hashlib.sha256(blob).hexdigest()}
    return docs,provenance



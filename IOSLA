              'com.apple.driver.AppleT8020', 'com.apple.driver.usb.AppleUSBHostT8020',
              'com.apple.driver.AppleH11ANEInterface')


def _v007_subsystem(identifier: str) -> str:
    for pattern, label in V007_PRIORITY:
        if re.search(pattern, identifier, re.I):
            return label
    return 'Outros'


def _v007_probe_one(node: dict, rules: dict) -> dict:
    """Tri-state ADT textual witness, NOT IORegistry matching or runtime execution.

    All declared text rules must have a witness, and any *observable* mismatch
    is marked as a textual divergence, not as proof of non-loading.
    """
    witnesses, contradictions, unresolved = [], [], []
    names = {x for name in V006_STABLE_NAMES for x in (_v006_text_values(node, name) or [])}
    for key in ('IONameMatch', 'IONameMatched'):
        if key not in rules:
            continue
        values = rules[key]
        if isinstance(values, str):
            values = [values]
        values = [s for s in values if isinstance(s, str)] if isinstance(values, list) else []
        if not values:
            unresolved.append(key + ': regra não textual')
        elif any(s in names for s in values):
            witnesses.append({'rule': key, 'value': next(s for s in values if s in names)})
        elif names:
            contradictions.append(key + ': sem coincidência textual no nó')
        else:
            unresolved.append(key + ': nó sem nomes decodificáveis')
    if 'IOPropertyMatch' in rules:
        props = rules['IOPropertyMatch']
        if not isinstance(props, dict):
            unresolved.append('IOPropertyMatch: estrutura não comparável')
        else:
            for key, value in sorted(props.items()):
                values = [value] if isinstance(value, str) else (value if isinstance(value, list) else [])
                values = [s for s in values if isinstance(s, str)]
                node_values = _v006_text_values(node, key)
                if not values or node_values is None:
                    unresolved.append('IOPropertyMatch.' + key + ': dados textuais insuficientes')
                elif set(values).intersection(node_values):
                    witnesses.append({'rule': 'IOPropertyMatch.' + key,
                                      'value': sorted(set(values).intersection(node_values))[0]})
                else:
                    contradictions.append('IOPropertyMatch.' + key + ': valores textuais distintos')
    for k in ('IOProviderClass', 'IOClass'):
        if k in rules:
            unresolved.append(k + ': depende do IORegistry em execução')
    if contradictions:
        status = 'divergencia_textual'
    elif witnesses:
        status = 'indicio_textual_com_condicoes_nao_validadas'
    else:
        status = 'sem_evidencia_textual'
    return {'status': status, 'witnesses': witnesses, 'divergences': contradictions,
            'unverified': unresolved}


def _v007_probe_tree(kext: Kext, nodes: dict, max_details: int = 5) -> dict:
    if not nodes:
        return {'status': 'nao_avaliado', 'reason': 'DeviceTree não disponível ou não decodificado',
                'match_count': 0, 'details': []}
    if not kext.personality_matching:
        return {'status': 'sem_regras_recuperadas', 'reason': 'Nenhuma personalidade IOKit textual disponível',
                'match_count': 0, 'details': []}
    positive, diverging = [], 0
    for pname, rules in sorted(kext.personality_matching.items()):
        if not isinstance(rules, dict):
            continue
        for path, node in nodes.items():
            test = _v007_probe_one(node, rules)
            if test['status'] == 'divergencia_textual':
                diverging += 1
            if test['status'] == 'indicio_textual_com_condicoes_nao_validadas':
                positive.append({'personality': pname, 'node_path': path, **test})
    return {'status': ('indicios_textuais' if positive else 'nenhuma_correspondencia_textual_observada'),
            'match_count': len(positive), 'details': positive[:max_details],
            'divergent_personality_node_pairs': diverging,
            'notes': 'Não simula IORegistry, IOKit ProbeScore, classes provedoras ou carregamento real.'}


def _v007_transitive_deps(identifier: str, origin: Snapshot, dest: Snapshot,
                            depth_limit: int = 4, max_nodes: int = 256) -> dict:
    """Declared dependency graph only; bounded/cycle safe, no version inference."""
    queue = [(identifier, 0)]
    visited = {identifier}
    edges = []
    names = set()
    cut = False
    while queue:
        current, depth = queue.pop(0)
        kext = origin.kexts.get(current)
        if kext is None:
            continue
        if depth >= depth_limit:
            if kext.dependencies:
                cut = True
            continue
        for dep in sorted(kext.dependencies):
            edges.append({'from': current, 'to': dep, 'requested_version': kext.dependencies[dep],
                          'observed_in_target_inventory': dep in dest.kexts})
            names.add(dep)
            if dep in origin.kexts and dep not in visited:
                if len(visited) >= max_nodes:
                    cut = True
                    continue
                visited.add(dep)
                queue.append((dep, depth + 1))
    unknown = sorted(name for name in names if name not in dest.kexts)
    return {'dependency_names': len(names), 'edges_examined': len(edges),
            'not_observed_in_target': unknown[:50], 'not_observed_count': len(unknown),
            'traversal_limited': cut, 'depth_limit': depth_limit,
            'notes': 'Arestas provêm de OSBundleLibraries; ausência não prova inexistência.'}


def _v007_new_driver_candidates(identifier: str, dest: Snapshot) -> list[dict]:
    """Exact-ID or narrowly renamed successor candidates: name heuristics only."""
    variants = [(identifier, 'mesmo_identificador')]
    for pattern, repl, rule in ((r'G11P', 'G12P', 'renomeacao_g11p_g12p'),
                                (r'T8020', 'T8030', 'renomeacao_t8020_t8030'),
                                (r'H11', 'H12', 'renomeacao_h11_h12')):
        translated = re.sub(pattern, repl, identifier, flags=re.I)
        if translated != identifier:
            variants.append((translated, rule))
    result, seen = [], set()
    for name, rule in variants:
        if name in dest.kexts and name not in seen:
            result.append({'identifier': name, 'relation': rule,
                           'warning': 'Mesmo nome ou nome parecido NÃO demonstra implementação equivalente.'})
            seen.add(name)
    return result


def make_portability_research(inputs: dict, snapshots: dict, evidence: dict | None = None,
                              abi: dict | None = None, *, decoded_trees: dict | None = None) -> dict:
    """Investigates OLD KEXT rules against NEW board; does NOT produce any patched binary."""
    src, dst = snapshots.get('ORIGEM'), snapshots.get('DESTINO')
    trees = decoded_trees or {}
    warning = []
    if not src or not dst:
        warning.append('São necessários dois inventários de KEXTs interpretáveis.')
    if not trees.get('DESTINO', {}).get('nodes'):
        warning.append('DeviceTree do destino não interpretado; teste cruzado de regras não executado.')
    if not trees.get('ORIGEM', {}).get('nodes'):
        warning.append('DeviceTree da origem não interpretado; testemunhas de referência limitadas.')
    old_nodes = trees.get('ORIGEM', {}).get('nodes', {})
    new_nodes = trees.get('DESTINO', {}).get('nodes', {})
    previous = (evidence or {}).get('associations', [])
    by_source_id = {}
    for item in previous:
        if item.get('device') == 'ORIGEM':
            by_source_id.setdefault(item.get('kext'), []).append(item)
    dossier = []
    if src and dst:
        # Source inventory is authoritative for list of OLD drivers, not for portability.
        for identifier, kext in sorted(src.kexts.items()):
            direct = []
            for dep, needed in sorted(kext.dependencies.items()):
                other = dst.kexts.get(dep)
                direct.append({'id': dep, 'requested_version': needed,
                               'observed_in_target': other is not None,
                               'target_reported_version': other.version if other else None,
                               'version_abi_validated': False})
            origin_test = _v007_probe_tree(kext, old_nodes) if old_nodes else {
                'status': 'nao_avaliado', 'match_count': len(by_source_id.get(identifier, [])),
                'details': [], 'reason': 'Associações herdadas da v0.0.6, sem ADT decodificado'}
            dest_test = _v007_probe_tree(kext, new_nodes)
            dep_chain = _v007_transitive_deps(identifier, src, dst)
            # Contraprova complementar: drivers NOVOS no ADT do XS (hardware real
            # imaginado para um possível iOS mais recente no A12).
            target_candidates = []
            for candidate in _v007_new_driver_candidates(identifier, dst):
                candidate_probe = _v007_probe_tree(dst.kexts[candidate['identifier']], old_nodes, max_details=3)
                target_candidates.append({**candidate, 'new_driver_on_old_board': candidate_probe})
            missing_direct = [p['id'] for p in direct if not p['observed_in_target']]
            gates = {
                'source_driver_found': True,
                'same_identifier_observed_in_target': identifier in dst.kexts,
                'direct_dependencies_not_observed': missing_direct,
                'transitive_dependencies_not_observed': dep_chain['not_observed_in_target'],
                'source_board_textual_match': origin_test['status'],
                'target_board_textual_match': dest_test['status'],
                'abi_compatibility': 'nao_demonstrada',
                'runtime_iokit_binding': 'nao_verificado',
                'secure_boot_and_signing': 'nao_verificados',
                'driver_extraction_or_loading': 'nao_implementados',
            }
            priority = ('foco' if identifier in V007_FOCUS else
                        'investigar' if missing_direct or (dest_test['status'] == 'nenhuma_correspondencia_textual_observada'
                        and origin_test['match_count'] > 0) else 'referencia')
            dossier.append({
                'identifier': identifier, 'category': _v007_subsystem(identifier),
                'source_version': kext.version,
                'target_version_if_present': dst.kexts[identifier].version if identifier in dst.kexts else None,
                'personalities_recovered': len(kext.personality_matching),
                'direct_dependencies': direct,
                'direct_dependencies_count': len(direct),
                'direct_dependencies_not_observed_count': len(missing_direct),
                'transitive_dependency_analysis': dep_chain,
                'source_device_tree_probe': origin_test,
                'target_device_tree_probe': dest_test,
                'newer_driver_candidate_on_original_board': target_candidates,
                'readiness_gates': gates,
                'research_priority': priority,
                'conclusion': 'INCONCLUSIVO: nenhum suporte à execução, ABI ou assinatura demonstrado',
            })
    focus = sorted(dossier, key=lambda r: (r['research_priority'] != 'foco',
                    r['research_priority'] != 'investigar', r['identifier']))
    device_info = {
        'origin': {'device': src.device if src else 'iPhone11,2',
                   'ios_version': src.ios_version if src else inputs.get('ORIGEM',{}).get('meta',{}).get('ios_version','?')},
        'target': {'device': dst.device if dst else 'iPhone12,1',
                   'ios_version': dst.ios_version if dst else inputs.get('DESTINO',{}).get('meta',{}).get('ios_version','?')},
    }
    abi_available = bool((abi or {}).get('summary', {}).get('origin_images_with_symbols', 0)
                         and (abi or {}).get('summary', {}).get('target_images_with_symbols', 0))
    return {'iosla_version': APP_VERSION, 'generated_at': datetime.now(timezone.utc).isoformat(),
            'mode': 'read-only / testes cruzados textuais / auditoria de dependências',
            'devices': device_info,
            'coverage': 'parcial' if src and dst else 'insuficiente',
            'summary': {
                'source_drivers_audited': len(dossier),
                'drivers_with_direct_dependency_names_missing': sum(bool(x['direct_dependencies_not_observed_count']) for x in dossier),
                'drivers_with_target_textual_witness': sum(x['target_device_tree_probe']['match_count'] > 0 for x in dossier),
                'drivers_with_source_witness_and_no_target_witness': sum(x['source_device_tree_probe']['match_count'] > 0 and
                      x['target_device_tree_probe']['status'] == 'nenhuma_correspondencia_textual_observada' for x in dossier),
                'newer_driver_candidates_with_original_board_textual_witness': sum(any(
                    c['new_driver_on_old_board']['match_count'] > 0 for c in x['newer_driver_candidate_on_original_board']) for x in dossier),
                'target_devicetree_test_executed': bool(new_nodes),
                'binary_abi_observed_on_both_sides': abi_available,
            },
            'research_focus': [x['identifier'] for x in focus[:12]],
            'drivers': dossier,
            'warnings': warning,
            'interpretation': {
                'observed': 'Versões, regras IOKit, nomes de dependências, DeviceTree e indicadores observáveis.',
                'not_proven': 'Compatibilidade binária, execução de KEXTs, boot, assinatura e funcionamento.',
                'target_match': 'Correspondência textual antiga no novo ADT é pista; ausência de pista não é falha comprovada.',
                'reverse_target_match': 'Testa também regras de KEXTs mais novas contra ADT do XS, representando o hardware desejado; não executa kernel novo no XS.',
                'target_version': 'Lida dos metadados do IPSW; análise aceita iOS 26, 27 ou outra versão compatível com os arquivos de entrada.'},
            'research_next_steps': [
                'Obter interfaces ABI efetivamente observáveis para IOGPUFamily, IOSurface e KPIs; sem símbolos o diagnóstico permanece limitado.',
                'Comparar as regras e dependências do AGXG11P com AGXG12P e parâmetros do controlador sgx nas duas placas.',
                'Separar dependências de kernel e diferenças elétricas/registradores do GPU e gerenciamento de energia.',
                'Conferir requisitos de firmware gráfico, microcontroladores e componentes de boot usando evidências estáticas.',

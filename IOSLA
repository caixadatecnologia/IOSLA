V006_RELEVANT_SUBSYSTEMS = tuple(GROUP_PATTERNS)
V006_STABLE_NAMES = ('name', 'compatible', 'device_type')
V006_PROVIDER_RULES = ('IOProviderClass', 'IOClass', 'IOPathMatch',
                       'IOLocationMatch', 'IOResourceMatch', 'IOMatchCategory')
V006_KEXT_FILTERS = {
    'Câmera e ISP': re.compile(r'Camera|(?<!d)ISP|AppleH(?:10|11|12|13|14)(?:Camera|ISP)|AppleAVD|AppleAVE', re.I),
    'Armazenamento': re.compile(r'AppleANS|NVMe|NAND|Storage|AppleFS|APFS|AppleSIO|IONVMe|IONAND', re.I),
    'Áudio e háptica': re.compile(r'Audio|Haptic|Codec|Speaker|AOPAudio|AOPHaptic', re.I),
}


def _v006_text_values(node: dict, property_name: str) -> list[str] | None:
    """None = não há dados textuais observáveis; [] = textual conhecido mas vazio.

    Uma propriedade com bytes não interpretados não autoriza inferir incompatibilidade.
    """
    raw = node.get('text', {}).get(property_name)
    if isinstance(raw, list):
        return [item for item in raw if isinstance(item, str)]
    return None


def _v006_check_personality(node: dict, name: str, rules: dict) -> dict | None:
    """Somente testemunhas textuais; NÃO emula o matching do IOKit.

    Uma correspondência isolada não valida conjunções, classe provedora, precedência
    de regras, IORegistry em execução, IOProbeScore ou a ABI da extensão.
    """
    evidence = []
    unresolved = []
    textual_conflict = False
    rule_keys = sorted(rules)
    generic_values = {v for key in V006_STABLE_NAMES
                      for v in (_v006_text_values(node, key) or [])}
    for field in ('IONameMatch', 'IONameMatched'):
        declared = rules.get(field, [])
        if isinstance(declared, str):
            declared = [declared]
        if not isinstance(declared, list):
            continue
        for value in declared:
            if not isinstance(value, str):
                continue
            if value in generic_values:
                evidence.append({'rule': field, 'value': value,
                                 'matched_in': [key for key in V006_STABLE_NAMES
                                                if value in (_v006_text_values(node, key) or [])]})
        if declared and not any(e['rule'] == field for e in evidence):
            unresolved.append(field + ': nome não coincidiu com os textos disponíveis')
    prop_rules = rules.get('IOPropertyMatch', {})
    if isinstance(prop_rules, dict):
        for key, decl in prop_rules.items():
            declared = [decl] if isinstance(decl, str) else (decl if isinstance(decl, list) else [])
            declared = [val for val in declared if isinstance(val, str)]
            node_values = _v006_text_values(node, key)
            if node_values is None:
                unresolved.append('IOPropertyMatch.' + key + ': valor textual não disponível')
            elif declared:
                common = sorted(set(declared) & set(node_values))
                if common:
                    for value in common:
                        evidence.append({'rule': 'IOPropertyMatch.' + key,
                                         'value': value, 'matched_in': [key]})
                else:
                    textual_conflict = True
                    unresolved.append('IOPropertyMatch.' + key + ': valores textuais divergentes')
    for key in V006_PROVIDER_RULES:
        if key in rules:
            unresolved.append(key + ': não comparável diretamente a um nó ADT')
    if not evidence or textual_conflict:
        return None
    return {'personality': name, 'observed_matching_keys': rule_keys,
            'textual_evidence': evidence, 'unverified_conditions': sorted(set(unresolved)),
            'assessment': 'COINCIDÊNCIA TEXTUAL — binding e ABI não demonstrados'}


def _v006_all_associations(snapshots: dict, trees: dict) -> dict:
    """Indexa associações apenas uma vez por dispositivo/nó/KEXT/personality.

    Não limita a busca a pares que partilham uma categoria heurística.
    """
    items = []
    unverified_provider_rules = 0
    declared_personalities = 0
    for label in ('ORIGEM', 'DESTINO'):
        snap = snapshots.get(label)
        nodes = trees.get(label, {}).get('nodes', {})
        if snap is None or not isinstance(nodes, dict):
            continue
        for kid, kext in sorted(snap.kexts.items()):
            for pname, rules in sorted(kext.personality_matching.items()):
                declared_personalities += 1
                if any(key in rules for key in V006_PROVIDER_RULES):
                    unverified_provider_rules += 1
                if not isinstance(rules, dict):
                    continue
                # Inspecionar somente regras com testemunhas textuais possíveis.
                if not any(key in rules for key in ('IONameMatch', 'IONameMatched', 'IOPropertyMatch')):
                    continue
                for path, node in nodes.items():
                    matching = _v006_check_personality(node, pname, rules)
                    if matching is None:
                        continue
                    items.append({'device': label, 'kext': kid,
                                  'node_path': path, **matching})
    items.sort(key=lambda r: (r['device'], r['kext'], r['node_path'], r['personality']))
    # A identidade da associação não depende da categoria na qual ela aparecerá.
    dedup = {}
    for item in items:
        identity = (item['device'], item['kext'], item['node_path'], item['personality'])
        dedup[identity] = item
    return {'items': list(dedup.values()),
            'counts': {'unique_textual_associations': len(dedup),
                       'declared_personalities_with_rules': declared_personalities,
                       'personalities_with_provider_conditions': unverified_provider_rules}}


def _v006_classify_kext(name: str, group: str) -> bool:
    if group in V006_KEXT_FILTERS:
        return bool(V006_KEXT_FILTERS[group].search(name))
    return bool(GROUP_PATTERNS[group][1].search(name))


def _v006_classify_node(path: str, node: dict, group: str) -> bool:
    values = [v for key in ('name', 'compatible', 'device_type')
              for v in (_v006_text_values(node, key) or [])]
    return bool(GROUP_PATTERNS[group][0].search(' '.join([path, *values])))


def _v006_dependency_audit(snapshots: dict, associations: list[dict]) -> dict:
    """Checa PRESENÇA em inventário parcial; não valida versões nem ABI."""
    src = snapshots.get('ORIGEM')
    dst = snapshots.get('DESTINO')
    if src is None or dst is None:
        return {'coverage': 'indisponivel', 'items': [], 'notes': ['Inventário de um dos firmwares indisponível.']}
    ids = {item['kext'] for item in associations if item['device'] == 'ORIGEM'}
    # Inclui os drivers críticos mesmo quando não possuem personalidade decodificada.
    ids.update(key for key in src.kexts if re.search(r'AGXG11P|IOGPUFamily|IOSurface|AppleARMPlatform|AppleH11ANE', key, re.I))
    result = []
    for identifier in sorted(ids):
        kext = src.kexts.get(identifier)
        if kext is None:
            continue
        dependencies = kext.dependencies
        found = []
        unobserved = []
        for dep, required in sorted(dependencies.items()):
            target = dst.kexts.get(dep)
            record = {'id': dep, 'requested_version': required}
            if target is None:
                unobserved.append(record)
            else:
                found.append({**record, 'target_declared_version': target.version})
        result.append({'source_kext': identifier, 'observed_in_target_inventory': identifier in dst.kexts,
                       'source_version': kext.version, 'target_version': dst.kexts[identifier].version if identifier in dst.kexts else None,
                       'declared_dependencies_count': len(dependencies),
                       'dependencies_observed_in_target': found,
                       'dependencies_not_observed_in_target': unobserved,
                       'status': 'INCONCLUSIVO — presença nominal não valida versão mínima nem símbolos'})
    return {'coverage': 'parcial', 'items': result,
            'notes': ['Dependência não observada NÃO significa ausência do firmware ou falha de carregamento.',
                      'Versões de KEXT e KPI registradas não são teste de ABI nem verificação de restrições.']}


def _v006_abi_observations(abi_report: dict | None) -> dict:
    if not isinstance(abi_report, dict):
        return {'state': 'não_verificado', 'notes': ['Relatório ABI não disponível.']}
    summary = abi_report.get('summary', {})
    diagnostics = abi_report.get('macho_structure_diagnostics', {})
    images_with_symbols = {side: diagnostics.get(side, {}).get('symtab_states', {})
                           for side in ('origin', 'target')}
    a = summary.get('origin_images_with_symbols', 0)
    b = summary.get('target_images_with_symbols', 0)
    return {'state': 'inventario_binario_parcial' if a or b else 'simbolos_nao_recuperados',
            'images_with_symbols': {'origin': a, 'target': b},
            'structure_states': images_with_symbols,
            'linkedit_counts': {side: diagnostics.get(side, {}).get('images_with_linkedit', 0)
                                for side in ('origin', 'target')},
            'notes': ['Indicadores LC_SYMTAB e __LINKEDIT são estruturais, não prova de interfaces compatíveis.',
                      'Zero imports observados com cobertura incompleta NÃO significa zero imports necessários.']}


def make_evidence_validation(inputs: dict, snapshots: dict, dt_report: dict | None = None,
                             hw_report: dict | None = None, abi_report: dict | None = None,
                             *, decoded_trees: dict | None = None) -> dict:
    """Matriz qualitativa, auditável e sem prognóstico automático de boot."""
    trees = decoded_trees if decoded_trees is not None else {}
    warnings = []
    if not trees:
        for label in ('ORIGEM', 'DESTINO'):
            p = (dt_report or {}).get('sources', {}).get(label, {}).get('path')
            if not p:
                warnings.append(label + ': DeviceTree não disponível')
                continue
            try:
                trees[label] = parse_apple_devicetree(Path(p).read_bytes())
            except (OSError, DeviceTreeFormatError, KernelFormatError, ValueError) as exc:
                warnings.append(label + ': ' + str(exc))
    association = _v006_all_associations(snapshots, trees)
    items = association['items']
    audit = _v006_dependency_audit(snapshots, items)
    diffs = _v005_property_diff(trees.get('ORIGEM', {}), trees.get('DESTINO', {}))
    changed = {row['path']: row for row in diffs['significant_paths']}
    matrix = []
    for group in V006_RELEVANT_SUBSYSTEMS:
        sides = {}
        for label, side in (('ORIGEM', 'origin'), ('DESTINO', 'target')):
            snap = snapshots.get(label)
            nodes = trees.get(label, {}).get('nodes', {})
            classified_nodes = sorted(path for path, node in nodes.items()
                                      if _v006_classify_node(path, node, group))
            classified_kexts = sorted(k for k in snap.kexts if _v006_classify_kext(k, group)) if snap else []
            assoc = [row for row in items if row['device'] == label and
                     (row['node_path'] in classified_nodes or row['kext'] in classified_kexts)]
            sides[side] = {'node_count': len(classified_nodes),
                           'kext_count': len(classified_kexts),
                           'matched_associations': len(assoc),
                           'matched_pairs': [{'kext': v['kext'], 'node': v['node_path'],
                                              'personality': v['personality']} for v in assoc[:25]],
                           'node_paths': classified_nodes,
                           'kext_ids': classified_kexts}
        src, dst = sides['origin'], sides['target']
        common = set(src['node_paths']) & set(dst['node_paths'])
        paths = [changed[p] for p in sorted(common) if p in changed]
        diff_kext = sorted(set(src['kext_ids']) - set(dst['kext_ids']))
        priority = 'investigação prioritária' if any(x['critical_properties'] for x in paths) else (
                   'investigação complementar' if diff_kext or src['matched_associations'] else
                   'dados insuficientes')
        matrix.append({'subsystem': group, 'research_priority': priority,
                       'conclusion': 'INCONCLUSIVO — nenhuma viabilidade de patch demonstrada',
                       'origin': src, 'target': dst,
                       'shared_node_paths': len(common),
                       'changed_shared_nodes': len(paths),
                       'critical_property_changes': [{
                           'path': row['path'], 'properties': row['critical_properties']
                       } for row in paths if row['critical_properties']][:30],
                       'kexts_not_observed_in_target': diff_kext[:40]})
    old_meta = inputs.get('ORIGEM', {}).get('meta', {})
    new_meta = inputs.get('DESTINO', {}).get('meta', {})
    coverage = ('parcial' if len(trees) == 2 and len(snapshots) == 2 else 'insuficiente')
    result = {'iosla_version': APP_VERSION,
              'generated_at': datetime.now(timezone.utc).isoformat(),
              'mode': 'pesquisa de evidências — offline, somente leitura',
              'devices': {'origin': {'id': 'iPhone11,2', 'ios': old_meta.get('ios_version','?')},
                          'target': {'id': 'iPhone12,1', 'ios': new_meta.get('ios_version','?')}},
              'coverage': coverage,
              'summary': {**association['counts'],
                          'semantic_changed_paths': diffs['counts'].get('caminhos_com_sinais', 0),
                          'kexts_audited_for_dependencies': len(audit['items']),
                          'abi_symbols_available': bool(_v006_abi_observations(abi_report).get('images_with_symbols', {}).get('origin') or
                                                        _v006_abi_observations(abi_report).get('images_with_symbols', {}).get('target'))},
              'associations': association['items'],
              'declared_dependency_audit': audit,
              'macho_structure': _v006_abi_observations(abi_report),
              'compatibility_matrix': matrix,
              'previous_hardware_summary': (hw_report or {}).get('summaries', {}),
              'evidence_policy': {
                  'observed': 'Texto idêntico em regras IOKit e em propriedades ADT, nomes e dependências declaradas.',
                  'hypothesis': 'Uma KEXT pode estar relacionada ao nó; não foi verificado seu carregamento.',
                  'not_verified': 'Ligação IOKit real, símbolos/ABI, versões mínimas, inicialização, assinaturas e funcionamento.'},
              'warnings': warnings,
              'limitations': [
                  'Análise de firmwares de dispositivos diferentes; ausência em inventário parcial não demonstra remoção.',
                  'IOProviderClass/IOClass descrevem classes de serviços em execução e não podem ser validados com um ADT estático.',
                  'IONameMatch e IOPropertyMatch apenas coincidem textualmente; condições complexas do IOKit não são simuladas.',
                  'As classificações por subsistema são heurísticas; números de grupos podem se sobrepor.',
                  'A matriz não é porcentagem de viabilidade, não aplica patches e não modifica arquivos IPSW.',
              ]}
    return result


def evidence_validation_markdown(report: dict) -> str:
    rows = [f'# IOSLA v{APP_VERSION} — Compatibility Evidence Validator', '',
            '**Relatório somente leitura. Não comprova suporte, boot ou patch funcional.**', '',
            '## Firmwares', '',
            '- Origem: iPhone XS / ' + report['devices']['origin']['ios'],
            '- Destino: iPhone 11 / ' + report['devices']['target']['ios'],
            '- Cobertura: **' + report['coverage'] + '**', '', '## Resultados verificáveis', '']
    summary = report['summary']
    for key in ('unique_textual_associations', 'declared_personalities_with_rules',
                'personalities_with_provider_conditions', 'semantic_changed_paths',
                'kexts_audited_for_dependencies'):
        rows.append('- ' + key + ': **' + str(summary.get(key, 0)) + '**')
    rows += ['', 'Uma associação textual é um indício, não uma vinculação IOKit confirmada.', '',
             '## Matriz de investigação', '',
             '| Subsistema | Nós origem/destino | KEXTs origem/destino | Associações textuais origem/destino | Prioridade |',
             '|---|---:|---:|---:|---|']
    for g in report['compatibility_matrix']:
        a, b = g['origin'], g['target']
        rows.append('| ' + g['subsystem'] + ' | ' + str(a['node_count']) + '/' + str(b['node_count']) +
                    ' | ' + str(a['kext_count']) + '/' + str(b['kext_count']) +
                    ' | ' + str(a['matched_associations']) + '/' + str(b['matched_associations']) +
                    ' | ' + g['research_priority'] + ' |')
    rows += ['', '## Associações textuais sem duplicação', '']
    for side, text in (('ORIGEM', 'iPhone XS'), ('DESTINO', 'iPhone 11')):
        elements = [a for a in report['associations'] if a['device'] == side]
        rows += ['### ' + text, '', str(len(elements)) + ' associações únicas.', '']
        for a in elements[:45]:
            witness = '; '.join(e['rule'] + '=' + str(e['value'])
                                for e in a['textual_evidence'][:3])
            rows.append('- `' + a['kext'].replace('`','') + '` → `' + a['node_path'].replace('`','') +
                        '` (' + a['personality'].replace('`','') + '): ' + witness)
            if a['unverified_conditions']:
                rows.append('  - Condições não verificadas: ' + ', '.join(a['unverified_conditions'][:4]))
        if len(elements) > 45:
            rows += ['', '*Lista abreviada; consulte o JSON para todas as associações.*']
        rows.append('')
    rows += ['## Dependências declaradas — inventário parcial', '']
    audit = report['declared_dependency_audit']
    rows.append('KEXTs investigadas: **' + str(len(audit['items'])) + '**. Uma dependência não observada não indica falha.')
    rows.append('')
    for item in audit['items'][:65]:
        missing = item['dependencies_not_observed_in_target']
        if missing:
            rows.append('- `' + item['source_kext'] + '`: não observadas no inventário destino: ' +
                        ', '.join('`' + d['id'] + '`' for d in missing[:8]))
    rows += ['', '## Evidências de estrutura binária', '']
    structural = report['macho_structure']
    rows.append('- Situação: **' + structural.get('state', 'não avaliada') + '**')
    for side, counts in structural.get('structure_states', {}).items():
        rows.append('- ' + side + ' LC_SYMTAB: ' + ', '.join(k + '=' + str(v) for k,v in counts.items()))
    rows.extend(['', 'Sem símbolos observáveis suficientes, **a ABI permanece inconclusiva**.',
                 '', '## Limitações', ''])
    rows.extend('- ' + limit for limit in report['limitations'])
    if report['warnings']:
        rows += ['', '## Avisos', ''] + ['- ' + warning for warning in report['warnings']]
    return '\n'.join(rows) + '\n'


def export_evidence_validation(report: dict, directory: Path) -> tuple[Path, Path]:
    directory.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    a = directory / ('IOSLA_EVIDENCIAS_' + stamp + '.json')
    b = directory / ('IOSLA_EVIDENCIAS_' + stamp + '.md')
    a.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding='utf-8')
    b.write_text(evidence_validation_markdown(report), encoding='utf-8')
    return a, b


def _v006_find_json(files: list[Path], prefix: str) -> dict | None:
    for file in reversed(files):
        if file.name.startswith(prefix) and file.suffix.lower() == '.json':
            try:
                obj = json.loads(file.read_text(encoding='utf-8'))
                return obj if isinstance(obj, dict) else None
            except (OSError, ValueError):
                return None
    return None



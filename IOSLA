    (r'AGXG11P|AGXFirmware|IOGPUFamily|IOSurface|Apple.*Display', 'GPU e tela'),
    (r'AppleT8020|AppleARMPlatform|AppleARMPMU|ApplePMGR|Apple.*Clock', 'Plataforma e energia'),
    (r'ANE|Neural', 'ANE'),
    (r'USBHostT8020|AppleUSB|USB', 'USB'),
    (r'SEP|AppleImage4|trust|Security', 'Segurança/SEP'),
    (r'Baseband|WLAN|Wifi|Bluetooth', 'Conectividade'),
)

def _v014_firmware_file(path:str|Path,member:str)->dict:
    """Hash *bounded* IPSW payload, with no extraction to disk."""
    p=Path(path).expanduser().resolve()
    info={'archive':p.name,'member':member,'state':'not_inspected'}
    if not p.is_file():return {**info,'state':'archive_missing'}
    try:
        with zipfile.ZipFile(p,'r') as z:
            record=z.getinfo(member)
            if record.file_size>V014_MAX_FW_BYTES:
                return {**info,'state':'exceeds_read_limit','bytes_declared':record.file_size}
            h=hashlib.sha256();total=0;prefix=b'';snippet=b''
            with z.open(record,'r') as stream:
                while True:
                    chunk=stream.read(min(1024*1024,V014_MAX_FW_BYTES-total+1))
                    if not chunk:break
                    total+=len(chunk)
                    if total>V014_MAX_FW_BYTES:return {**info,'state':'read_limit_exceeded'}
                    if not prefix:prefix=chunk[:48]
                    if len(snippet)<256*1024:snippet+=chunk[:256*1024-len(snippet)]
                    h.update(chunk)
            # Strings are clues only; no parsing/decompilation of code or protocol.
            import re as _re
            strings=[m.group(0).decode('ascii','replace')[:100] for m in
                     _re.finditer(rb'[ -~]{8,100}',snippet)]
            strings=list(dict.fromkeys(strings))[:24]
            return {**info,'state':'bytes_hashed','size_bytes':total,'sha256':h.hexdigest(),
                    'container_hint':'IM4P' if prefix[:4]==b'IM4P' or b'IM4P' in prefix[:16] else 'unknown',
                    'printable_strings_sample':strings,'string_scan_bytes':len(snippet),
                    'inner_firmware_disassembled':False}
    except (OSError,KeyError,zipfile.BadZipFile,RuntimeError) as exc:
        return {**info,'state':'read_error','reason':type(exc).__name__}


def _v014_gpu_firmware(inputs:dict|None)->dict:
    inspected=[]
    for label,item in (inputs or {}).items():
        meta=item.get('meta',{});ipsw=item.get('path')
        paths=meta.get('component_paths',{}).get('GFX',[])
        for member in paths[:3]:
            if not isinstance(member,str) or '..' in Path(member).parts:continue
            r=_v014_firmware_file(ipsw,member) if ipsw else {'state':'ipsw_unavailable','member':member}
            inspected.append({'firmware':label,'device':meta.get('devices',[]),**r})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'hash e metadados limitados do payload GFX dentro do IPSW',
      'summary':{'referenced':len(inspected),'hashed':sum(x['state']=='bytes_hashed' for x in inspected)},
      'payloads':inspected,
      'limitations':['Hash nao prova protocolo ou compatibilidade de GPU.',
        'Amostras de strings do contêiner nao sao protocolos; nenhum payload e executado, descompilado, modificado ou gravado.',
        'Analise de contêiner nao revela semantica do firmware auxiliar.']}



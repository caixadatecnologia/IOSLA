            'report_types_generated':len(documented),
            'target_functions':v11_calls.get('targets_identified'),
            'indexed_direct_calls':v11_calls.get('source_direct_calls_stored'),
            'direct_call_truncation':v11_calls.get('source_direct_calls_truncated'),
            'unique_direct_candidates':v11_cont.get('with_unique_A_C_candidate'),
            'new_contextual_unique':v12_context.get('new_contextual_unique'),
            'arm64e_images_scanned':v12_arm.get('images_scanned'),
        },
        'firmwares':versions,
        'reports':documented,
        'errors':errors or {},
        'limitations':[
            'Resumo de dez tipos de relatório; o índice não cria novas provas de ABI.',
            'Equivalência funcional, classes C++, firmware e execução não foram comprovados.',
            'Os dados dos relatórios individuais permanecem a fonte primária.',

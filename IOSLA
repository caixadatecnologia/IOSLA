def _v016_branch(word:int, pc:int) -> tuple[str,int|None,bool,bool]:
    """kind, target, conditional, terminates; recognized AArch64 only."""
    typ,target=_v014_branch(word,pc)
    if typ=='BL':return ('CALL_DIRECT',target,False,False)
    if typ=='B':return ('B',target,False,True)
    if typ in ('B_COND','CBZ_CBNZ'):return (typ,target,True,True)
    if word & 0x7e000000 == 0x36000000:  # TBZ/TBNZ, signed imm14
        imm=_v010_signed_imm((word>>5)&0x3fff,14)*4
        return ('TBZ_TBNZ',pc+imm,True,True)
    dec=_v012_decode(word,pc)
    cl=dec.get('class','')
    if cl in ('RETURN','RETURN_AUTH'):
        return ('RETURN',None,False,True)
    if cl in ('BRANCH_INDIRECT','BRANCH_INDIRECT_AUTH'):
        return ('UNRESOLVED_INDIRECT_BRANCH',None,False,True)
    if cl in ('CALL_INDIRECT','CALL_INDIRECT_AUTH'):
        return ('UNRESOLVED_INDIRECT_CALL',None,False,False)
    return ('OTHER',None,False,False)


def _v016_cfg(raw:bytes,base:int)->dict:
    """Bounded CFG, with no speculative successors for indirect branches."""
    n=min(len(raw)//4,V016_MAX_INSN)
    words=[int.from_bytes(raw[4*i:4*i+4],'little') for i in range(n)]
    leaders={0};instructions=[];external=[];unresolved=Counter()
    for i,w in enumerate(words):
        pc=base+4*i
        kind,dest,cond,terminal=_v016_branch(w,pc)
        instructions.append((kind,dest,cond,terminal))
        if terminal and i+1<n:leaders.add(i+1)
        if dest is not None and kind!='CALL_DIRECT':
            if base<=dest<base+4*n and (dest-base)%4==0:
                leaders.add((dest-base)//4)
            else:
                external.append({'site':hex(pc),'kind':kind,'destination':hex(dest)})
        if kind=='UNRESOLVED_INDIRECT_BRANCH':unresolved[kind]+=1
        if kind=='UNRESOLVED_INDIRECT_CALL':unresolved[kind]+=1
    splits=sorted(leaders)
    all_blocks=[(splits[i],splits[i+1] if i+1<len(splits) else n) for i in range(len(splits))]
    owner={j:k for k,(start,end) in enumerate(all_blocks) for j in range(start,end)}
    edges=[];branch_kinds=Counter();unfinished=[]
    for bid,(start,end) in enumerate(all_blocks):
        if end<=start:continue
        last=end-1;kind,dest,cond,terminal=instructions[last]
        branch_kinds[kind]+=1
        if terminal:
            if dest is not None and base<=dest<base+4*n and (dest-base)%4==0:
                target_id=owner.get((dest-base)//4)
                if target_id is not None:edges.append((bid,target_id,'taken'))
            if cond and end<n:edges.append((bid,owner[end],'fallthrough'))
            if kind=='UNRESOLVED_INDIRECT_BRANCH':unfinished.append(bid)
        elif end<n:edges.append((bid,owner[end],'fallthrough'))
    selected_blocks=[]
    for bid,(start,end) in enumerate(all_blocks[:V016_MAX_BLOCKS]):
        selected_blocks.append({'id':bid,'start':hex(base+4*start),
            'end_exclusive':hex(base+4*end),'instructions':end-start})
    selected_edges=[{'from':a,'to':b,'kind':kind} for a,b,kind in edges[:V016_MAX_EDGES]]
    return {'instruction_count':n,'instruction_limit_reached':len(raw)//4>n,
        'block_count':len(all_blocks),'edge_count':len(edges),
        'blocks':selected_blocks,'edges':selected_edges,
        'blocks_limited':len(all_blocks)>V016_MAX_BLOCKS,
        'edges_limited':len(edges)>V016_MAX_EDGES,
        'out_of_window_branches':external[:24],
        'out_of_window_branches_limited':len(external)>24,
        'unresolved_indirect':dict(unresolved),
        'unresolved_terminator_blocks':unfinished[:24],
        'branch_kinds':dict(branch_kinds),
        '_all_blocks':all_blocks,'_all_edges':edges,'_words':words,
        '_base':base}


def _v016_apply(word:int,pc:int,regs:dict,events:list,seen_events:set,
                stats:Counter,block_id:int)->None:
    """Limited transfer function. Absence of model => kill apparent destination.

    This is an evidence-gatherer, not type recovery or a sound full AArch64 IR.
    """
    # MOV Xd,Xm (ORR alias)
    if (word & 0xffe0ffe0)==0xaa0003e0:
        dst=word&31;src=(word>>16)&31
        if dst<31:regs[dst]=regs.get(src)
        stats['recognized_MOV']+=1;return
    # ADD/SUB immediate 64-bit (no flag-setting variants)
    if (word&0x7f000000) in (0x11000000,0x51000000) and word>>31&1:
        dst=word&31;src=(word>>5)&31
        off=((word>>10)&0xfff) << (12 if (word>>22)&1 else 0)
        if word&0x40000000:off=-off
        srcval=regs.get(src)
        if dst<31:regs[dst]=(srcval[0],srcval[1]+off) if srcval is not None else None
        stats['recognized_ADD_SUB']+=1;return
    m=_v014_mem(word)
    if m:
        base=(word>>5)&31;dst=word&31
        origin=regs.get(base) if base!=31 else ('SP',0)
        if origin is not None:
            key=(pc,m['operation'],origin[0],origin[1]+m['offset'],m['width'])
            if key not in seen_events and len(events)<V016_MAX_EVENTS:
                seen_events.add(key)
                events.append({'site':hex(pc),'block':block_id,'operation':m['operation'],
                   'source_root':origin[0],'relative_byte_offset':origin[1]+m['offset'],
                   'width':m['width']})
        if m['operation']=='LDR' and dst<31:regs[dst]=None
        stats['recognized_MEMORY']+=1;return
    kind,dest,cond,terminal=_v016_branch(word,pc)
    if kind in ('CALL_DIRECT','UNRESOLVED_INDIRECT_CALL'):
        # Save best-effort register origins BEFORE clobbering at calls.
        key=(pc,kind)
        if key not in seen_events and len(events)<V016_MAX_EVENTS:
            seen_events.add(key)
            args={f'X{i}':f'{regs[i][0]}{regs[i][1]:+d}' for i in range(8)
                  if regs.get(i) is not None}
            events.append({'site':hex(pc),'block':block_id,
                'operation':kind,'destination':hex(dest) if dest is not None else None,
                'argument_origins':args,'callee_abi':'not_demonstrated'})
        for i in range(19):regs[i]=None
        stats[kind]+=1;return
    if kind!='OTHER':
        stats[kind]+=1;return
    if word in (0xd503201f,0xd503205f,0xd503207f):
        stats['NOP_HINT']+=1;return
    # Unknown opcode: conservatively invalidate a possible destination, and
    # record the modeling gap. No ability to prove liveness or aliases.
    dst=word&31
    if dst<31:regs[dst]=None
    stats['unmodeled_instruction_effect']+=1


def _v016_join(a:dict|None,b:dict)->dict:
    if a is None:return dict(b)
    return {k:a.get(k) if a.get(k)==b.get(k) else None for k in range(31)}


def _v016_dataflow(cfg:dict)->dict:
    """Forward must-origin analysis; emit only post-fixpoint evidence.

    Crucially, a temporary observation from one path must not survive the
    discovery of a conflicting predecessor. Collect final events in a second
    pass using converged incoming states, not during worklist iteration.
    """
    blocks=cfg['_all_blocks'];edges=cfg['_all_edges'];words=cfg['_words'];base=cfg['_base']
    succ={i:[] for i in range(len(blocks))}
    for a,b,_ in edges:succ[a].append(b)
    entry={i:('X'+str(i),0) for i in range(8)}
    entry.update({i:None for i in range(8,31)})
    incoming={0:entry};queue=deque([0]);steps=0
    while queue and steps<V016_MAX_STEPS:
        bid=queue.popleft();steps+=1
        st=dict(incoming[bid]);start,end=blocks[bid]
        for insn in range(start,end):
            _v016_apply(words[insn],base+4*insn,st,[],set(),Counter(),bid)
        for dst in succ.get(bid,[]):
            merged=_v016_join(incoming.get(dst),st)
            if incoming.get(dst)!=merged:
                incoming[dst]=merged
                if dst not in queue:queue.append(dst)
    stable=not bool(queue)
    events=[];seen=set();stats=Counter()
    if stable:
        # Derive events only from final must-origin states. Counterexamples
        # from other predecessors force unknown and suppress asserted origins.
        for bid,st_in in sorted(incoming.items()):
            st=dict(st_in);start,end=blocks[bid]
            for insn in range(start,end):
                _v016_apply(words[insn],base+4*insn,st,events,seen,stats,bid)
    sampled=[{'block':i,'known_registers':{f'X{k}':f'{v[0]}{v[1]:+d}'
        for k,v in sorted(st.items()) if v is not None and k<8}} for i,st in list(sorted(incoming.items()))[:20]]
    return {'reachable_blocks':len(incoming),'total_blocks':len(blocks),
        'iterations':steps,'fixpoint_completed':stable,'iteration_limit':V016_MAX_STEPS,
        'tracked_origins_at_block_entry':sampled,
        'events':events,'events_limited':len(events)>=V016_MAX_EVENTS,
        'operation_counts':dict(stats),
        'semantics':'bounded_must_origin_join; post_fixpoint_observations_only',
        'limitations':['Partial ARM64 abstract interpretation; not full SSA or decompilation.',
            'No memory alias tracking, dynamic code, exceptions, or PAC resolution.',
            'Unknown/unsupported instruction effects can reduce precision.',
            'Indirect branch targets are not reconstructed.']}


def _v016_contract_signature(cfg:dict,flow:dict)->dict:
    if not cfg or not flow:return {'state':'insufficient_binary_evidence'}
    # Preserve both evidence and measurement flags so matching cannot hide truncation.
    mem=sorted(set((e['operation'],e['source_root'],e['relative_byte_offset'],e['width'])
       for e in flow.get('events',[]) if e.get('operation') in ('LDR','STR')))
    calls=sum(1 for e in flow.get('events',[]) if e.get('operation','').startswith(('CALL','UNRESOLVED_INDIRECT_CALL')))
    feat={'mem':mem[:48], 'block_count':cfg['block_count'],
       'edge_count':cfg['edge_count'],'call_events':calls,
       'branch_kinds':cfg.get('branch_kinds',{})}
    h=hashlib.sha256(json.dumps(feat,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    complete=bool(not cfg['instruction_limit_reached'] and
       not cfg['blocks_limited'] and not cfg['edges_limited'] and
       flow.get('fixpoint_completed') and not flow.get('events_limited'))
    return {'state':'limited_structural_observation','observation_sha256':h,
       'features':feat,'observed_window_complete':complete,
       'abi_equivalent':None}



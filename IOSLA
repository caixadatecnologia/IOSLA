    versions={}
    for label in ('ORIGEM','CONTROLE','DESTINO'):
        meta=(inputs or {}).get(label,{}).get('meta',{})
        if meta:
            versions[label]={'ios':meta.get('ios_version'), 'build':meta.get('build'),
                             'device':(meta.get('devices') or [None])[0]}
    documented={}
    for path in files:
        for prefix in V012_UNIFIED_REPORTS:
            if path.name.startswith('IOSLA_'+prefix+'_'):
                documented.setdefault(prefix,[]).append(path.name)
                break
    return {
        'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
        'mode':'indice consolidado dos laboratorios de interfaces, ARM64e e contexto',
        'summary':{

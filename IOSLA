def portability_markdown(report: dict) -> str:
    a, b = report['devices']['origin'], report['devices']['target']
    summary = report['summary']
    rows = [f'# IOSLA v{APP_VERSION} — KEXT Portability Research', '',
            '**Pesquisa estática, somente leitura. NÃO cria patches nem comprova boot.**', '',
            f"Origem: {a['device']} / iOS {a['ios_version']} · Destino: {b['device']} / iOS {b['ios_version']}", '',
            '## Diagnóstico', '',
            f"- KEXTs de origem auditadas: **{summary['source_drivers_audited']}**",
            f"- KEXTs com dependências diretas não observadas no destino: **{summary['drivers_with_direct_dependency_names_missing']}**",
            f"- KEXTs com pelo menos uma coincidência textual no DeviceTree destino: **{summary['drivers_with_target_textual_witness']}**",
            f"- Testes com testemunha na origem e sem testemunha no destino: **{summary['drivers_with_source_witness_and_no_target_witness']}**",
            f"- Teste cruzado de DeviceTree executado: **{summary['target_devicetree_test_executed']}**",
            f"- Possíveis KEXTs novas com indício textual no ADT original: **{summary['newer_driver_candidates_with_original_board_textual_witness']}**",
            '- ABI compatível: **não demonstrada**',
            '- Assinatura e boot: **não verificados**', '',
            '## Drivers para investigação', '',
            '| KEXT do sistema antigo | Dependências não observadas | Regras no hardware de destino |',
            '|---|---:|---|']
    focused = [next((x for x in report['drivers'] if x['identifier'] == ident), None)
               for ident in report['research_focus']]
    for item in focused:
        if item:
            rows.append('| `' + item['identifier'].replace('|', '') + '` | ' +
                        str(item['direct_dependencies_not_observed_count']) + ' | ' +
                        item['target_device_tree_probe']['status'].replace('_', ' ') + ' |')
    rows += ['', '## Dossiês técnicos', '']
    for item in focused[:10]:
        if item is None:
            continue
        rows.extend([f"### `{item['identifier']}`", '',
                     f"- Versão na origem: `{item['source_version']}`; versão no destino: `{item['target_version_if_present']}`.",
                     f"- Personalidades recuperadas: {item['personalities_recovered']}.",
                     f"- Regras no DeviceTree de origem: {item['source_device_tree_probe']['status']}.",
                     f"- Regras aplicadas ao DeviceTree de destino: **{item['target_device_tree_probe']['status']}**.",
                     f"- Dependências transitivas (nomes): {item['transitive_dependency_analysis']['dependency_names']} ",
                     f"- Dependências transitivas não observadas: {', '.join(item['transitive_dependency_analysis']['not_observed_in_target'][:8]) or 'nenhuma na amostra'}", ''])
        for dep in item['direct_dependencies'][:22]:
            rows.append('- `' + dep['id'] + '` — ' + ('identificador observado' if dep['observed_in_target'] else 'não observado') +
                        ' (versão requisitada: ' + dep['requested_version'] + ', destino: ' + str(dep['target_reported_version']) + ')')
        rows.append('')
        for candidate in item['newer_driver_candidate_on_original_board']:
            rows.append('- Driver do sistema novo com nome correspondente: `' + candidate['identifier'] +
                        '` (' + candidate['relation'] + ') → teste no ADT do XS: ' +
                        candidate['new_driver_on_old_board']['status'] +
                        ' **(heurística; não demonstra equivalência binária)**')
        for match in item['target_device_tree_probe']['details'][:3]:
            rows.append('- Testemunha ADT destino: `' + match['node_path'] + '` / `' + match['personality'] + '`: ' +
                        ', '.join(w['rule'] + '=' + w['value'] for w in match['witnesses'][:3]))
        rows.append('')
    rows += ['## Próximos experimentos de pesquisa', '']
    rows += ['- ' + p for p in report['research_next_steps']]
    rows += ['', '## Escopo e limitações', '',
             '- Não calcula probabilidade de port ou marca ABI como compatível a partir de nomes.',
             '- Não produz KEXTs transplantadas, altera binários, quebra assinaturas ou instala iOS.',
             '- DeviceTree e inventários são parciais e diferenças de SoC não podem ser resolvidas apenas com metadados.',
             '- Depender de uma versão mínima não significa ser semanticamente compatível com qualquer versão maior.',
             '- Firmwares A12/iOS 18 vs A13/iOS mais recente diferem em SoC **e** versão: resultados não isolam causa.', '']
    if report['warnings']:
        rows += ['## Avisos', ''] + ['- ' + s for s in report['warnings']] + ['']
    return '\n'.join(rows)


def export_portability(report: dict, directory: Path) -> tuple[Path, Path]:
    directory.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    jp = directory / f'IOSLA_PORTABILIDADE_{stamp}.json'
    md = directory / f'IOSLA_PORTABILIDADE_{stamp}.md'
    jp.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding='utf-8')
    md.write_text(portability_markdown(report), encoding='utf-8')
    return jp, md


def _v007_parse_trees(dt_report: dict | None) -> tuple[dict, list[str]]:
    result, errors = {}, []
    for label in ('ORIGEM', 'DESTINO'):
        path = (dt_report or {}).get('sources', {}).get(label, {}).get('path')
        if not path:
            errors.append(label + ': DeviceTree local não indicado no relatório')
            continue
        try:
            result[label] = parse_apple_devicetree(Path(path).read_bytes())
        except (OSError, ValueError, DeviceTreeFormatError, KernelFormatError) as exc:
            errors.append(label + ': ' + str(exc))
    return result, errors



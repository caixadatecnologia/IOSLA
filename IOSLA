# ==========================================================================
# IOSLA v0.0.10 — BINARY FUNCTION ANALYSIS & INTERFACE RESEARCH
# ==========================================================================
# Bounded read-only ARM64 inspection.  These patterns are intentionally a small
# subset of AArch64 instructions; neither disassembly nor recovered call edges
# constitute a reconstructed ABI or a loader/linker for proprietary drivers.

V010_FOCUS = ('com.apple.AGXG11P','com.apple.AGXG12P',
              'com.apple.iokit.IOGPUFamily','com.apple.iokit.IOSurface',
              'com.apple.driver.AppleARMPlatform')
V010_MAX_FNS = 1500
V010_MAX_FUNCTION_STARTS = 100000
V010_MAX_INSN_PER_FN = 512
V010_MAX_SECTION_BYTES = 24 * 1024 * 1024
V010_MAX_MATCHES_PER_PAIR = 80
V010_MAX_REFERENCES_PER_IMAGE = 500


def _v010_signed_imm(value: int, bits: int) -> int:
    flag = 1 << (bits-1)
    return (value ^ flag) - flag


def _v010_classify(word: int, vmaddr: int) -> tuple[str, int | None]:
    """Small ARM64 instruction classifier; only B/BL immediate have direct targets."""
    op = word & 0xfc000000
    if op == 0x94000000:
        return 'BL', vmaddr + (_v010_signed_imm(word & 0x03ffffff,26) << 2)
    if op == 0x14000000:
        return 'B', vmaddr + (_v010_signed_imm(word & 0x03ffffff,26) << 2)
    if (word & 0xfffffc1f) == 0xd65f0000 or word in (0xd65f0bff,0xd65f0fff):
        return 'RET',None
    if (word & 0xfffffc1f) == 0xd63f0000:
        return 'BLR',None
    if (word & 0xfffffc1f) == 0xd61f0000:
        return 'BR',None
    if word in (0xd503233f,0xd503237f,0xd50323bf,0xd50323ff):
        return 'PAC',None
    if (word & 0xff000010) == 0x54000000:
        return 'BCOND',None
    if (word & 0x7e000000) == 0x34000000 or (word & 0x7e000000)==0x36000000:
        return 'BCOND',None
    if (word & 0x9f000000) == 0x90000000:
        return 'ADRP',None
    if (word & 0x9f000000) == 0x10000000:
        return 'ADR',None
    if (word & 0x3b000000) == 0x18000000:
        return 'LDRLIT',None
    if (word & 0x0a000000) == 0x08000000:
        return 'LOADSTORE',None
    if (word & 0x1c000000) in (0x10000000,0x14000000):
        return 'ALU',None
    if (word & 0x0e000000) == 0x0e000000:
        return 'SIMD',None
    return 'OTHER',None


def _v010_function_offsets(data: bytes, image: dict) -> dict:
    """Decode actual LC_FUNCTION_STARTS ULEB deltas; do not guess boundaries."""
    fs = image.get('function_starts',{})
    lc = image.get('load_commands',{}).get('LC_FUNCTION_STARTS',{})
    mapping = lc.get('file_mapping',{})
    text = image.get('mappings',{}).get('__TEXT',{})
    base = text.get('vmaddr')
    if fs.get('state') != 'delimitado' or mapping.get('state') != 'resolvido' or not isinstance(base,int):
        return {'state':'limites_de_funcoes_nao_verificaveis','vmaddrs':[],
                'reason':fs.get('state','comando_ausente')}
    point, size = mapping['offset'], lc.get('data_size',0)
    if not _v009_within(point,size,len(data)) or size > 2*1024*1024:
        return {'state':'tabela_de_funcoes_nao_verificavel','vmaddrs':[]}
    buf = memoryview(data)[point:point+size]
    position = 0
    relative = 0
    addresses = []
    try:
        for _ in range(V010_MAX_FUNCTION_STARTS):
            if position >= len(buf):
                return {'state':'tabela_sem_terminador','vmaddrs':[]}
            delta,position = _abi_uleb(buf,position,len(buf))
            if delta == 0:
                if fs.get('count') != len(addresses):
                    return {'state':'contagem_inconsistente','vmaddrs':[]}
                return {'state':'limites_lidos','vmaddrs':addresses,'total':len(addresses)}
            relative += delta
            if relative > (1<<48):
                return {'state':'overflow_relativo','vmaddrs':[]}
            addresses.append(base+relative)
    except (IndexError,ValueError,OverflowError,struct.error):
        return {'state':'uleb_invalido','vmaddrs':[]}
    return {'state':'limite_de_funcoes_excedido','vmaddrs':[]}


def _v010_vm_index(scan:dict) -> list[dict]:
    """Index *validated executable sections*, not entire image ranges."""
    regions=[]
    for name,img in scan.get('images',{}).items():
        for sectname,sec in img.get('sections',{}).items():
            if not sectname.endswith(',__text'):
                continue
            m=sec.get('file_mapping',{})
            if m.get('state')=='resolvido' and sec.get('size',0)>0:
                base=sec.get('vmaddr')
                if isinstance(base,int):
                    regions.append({'start':base,'end':base+sec['size'],
                                    'image':name,'section':sectname})
    return sorted(regions,key=lambda x:(x['start'],x['end'],x['image']))


def _v010_resolve_call(vmaddr:int, index:list[dict]) -> dict:
    matches=[{'image':r['image'],'section':r['section']} for r in index
             if r['start']<=vmaddr<r['end']]
    if len(matches)==1:
        return {'state':'secao_executavel_unica','target':matches[0]}
    if len(matches)>1:
        return {'state':'alvo_ambiguo','matching_sections':len(matches)}
    return {'state':'alvo_nao_localizado_em_secao_mapeada'}


def _v010_extract_functions(data:bytes, scan:dict, identifier:str, index:list[dict]) -> dict:
    img=scan.get('images',{}).get(identifier)
    result={'identifier':identifier,'status':'imagem_nao_observada',
            'function_start_status':'indisponivel','functions':[],
            'instruction_categories':{},'direct_references':[],
            'notes':[],'limits':{'max_functions':V010_MAX_FNS,'max_instructions_per_function':V010_MAX_INSN_PER_FN}}
    if not img:
        return result
    position=img.get('image_offset')
    if img.get('cpu_type') != CPU_TYPE_ARM64 or not isinstance(position,int) or data[position:position+4] != MH_MAGIC_64:
        result['status']='arquitetura_ou_endian_nao_suportado'
        return result
    main = _v009_best_text(img)
    if not main:
        result['status']='secao_executavel_nao_observada'
        return result
    section_name, sec = main
    mapping = sec.get('file_mapping',{})
    result['section']=section_name
    result['section_mapping']=mapping.get('state')
    if mapping.get('state') != 'resolvido':
        result['status']='secao_executavel_nao_mapeada'
        return result
    size, start = sec['size'],mapping['offset']
    base_vm=sec['vmaddr']
    result['section_vmaddr']=base_vm
    result['section_size']=size
    if size > V010_MAX_SECTION_BYTES or not _v009_within(start,size,len(data)):
        result['status']='secao_executavel_excede_limite_de_pesquisa'
        return result
    starts=_v010_function_offsets(data,img)
    result['function_start_status']=starts['state']
    if starts['state']!='limites_lidos':
        result['status']='codigo_mapeado_sem_limites_de_funcoes_verificados'
        result['notes'].append('Nenhuma função foi inferida sem LC_FUNCTION_STARTS válido.')
        return result
    selected=sorted(set(x for x in starts['vmaddrs'] if base_vm<=x<base_vm+size and (x-base_vm)%4==0))
    result['starts_in_section']=len(selected)
    result['starts_not_in_section']=starts['total']-len(selected)
    if not selected:
        result['status']='sem_limites_de_funcoes_na_secao'
        return result
    instructions_total=Counter()
    calls=[]
    for idx,fnvm in enumerate(selected[:V010_MAX_FNS]):
        next_vm=selected[idx+1] if idx+1<len(selected) else base_vm+size
        span=min(max(0,next_vm-fnvm)//4,V010_MAX_INSN_PER_FN)
        if span <= 0:
            continue
        begin=start+fnvm-base_vm
        categories=[]
        word_bytes=data[begin:begin+span*4]
        indirect_calls=0
        for j in range(span):
            word=int.from_bytes(word_bytes[j*4:j*4+4],'little')
            cat,target=_v010_classify(word,fnvm+j*4)
            categories.append(cat)
            instructions_total[cat]+=1
            if cat=='BLR':
                indirect_calls+=1
            if cat=='BL' and target is not None and len(calls)<V010_MAX_REFERENCES_PER_IMAGE:
                calls.append({'from_function':hex(fnvm),'at_vmaddr':hex(fnvm+j*4),
                              'target_vmaddr':hex(target), **_v010_resolve_call(target,index)})
        seq='|'.join(categories)
        hist=Counter(categories)
        grams=sorted(set(seq.split('|')[i]+'_'+seq.split('|')[i+1] for i in range(len(categories)-1)))
        result['functions'].append({'vmaddr':hex(fnvm),'instruction_count':span,
            'span_bytes_declared':next_vm-fnvm,
            'truncated_inspection':(next_vm-fnvm)>V010_MAX_INSN_PER_FN*4,
            'sha256_raw':hashlib.sha256(word_bytes).hexdigest(),
            'sha256_opcode_classes':hashlib.sha256(seq.encode()).hexdigest(),
            'opcode_sequence':categories if span<=80 else categories[:80],
            'opcode_sequence_truncated':span>80,
            'categories':dict(hist),'adjacent_category_pairs':grams[:128],
            'indirect_calls_without_target':indirect_calls})
    result['status']='instrucoes_e_limites_observados'
    result['functions_found']=len(result['functions'])
    result['functions_limit_reached']=len(selected)>V010_MAX_FNS
    result['instruction_categories']=dict(instructions_total)
    result['direct_references']=calls
    result['direct_references_limit_reached']=len(calls)>=V010_MAX_REFERENCES_PER_IMAGE
    result['notes']=['Somente chamadas BL com deslocamento imediato são relacionadas a endereços.',
       'Chamadas BLR/indiretas, PAC, vtables e ABI C++ não são resolvidas por esse método.',
       'Offsets de funções dependem de LC_FUNCTION_STARTS e de uma seção executável mapeada.',
       'Um limite de função ou assinatura de opcodes não prova semântica/ABI.']
    return result


def _v010_analyze_kernel(path:str|Path, structural_scan:dict, labels:tuple[str,...]=V010_FOCUS) -> dict:
    p=Path(path).expanduser().resolve()
    if p.stat().st_size>MAX_INPUT:
        raise KernelFormatError('Arquivo excede o tamanho máximo permitido.')
    data,fmt,notes=_unwrap(p.read_bytes())
    if len(data)>MAX_DECODED:
        raise KernelFormatError('Kernelcache decodificado excede o limite.')
    idx=_v010_vm_index(structural_scan)
    items={name:_v010_extract_functions(data,structural_scan,name,idx) for name in labels}
    return {'status':'analisado','format':fmt,'decoded_bytes':len(data),
            'parser_notes':notes,'images':items,
            'indexed_executable_sections':len(idx)}


def _v010_similarity(a:dict,b:dict) -> dict:
    af=a.get('functions',[])
    bf=b.get('functions',[])
    if not af or not bf:
        return {'status':'funcoes_nao_observadas_em_ambos','source_functions':len(af),
                'target_functions':len(bf),'candidates':[]}
    # Candidate generation is deliberately bounded: only identical normalized
    # code-class sequences or similar lengths and shared category bigrams.
    buckets={}
    by_size={}
    for j,f in enumerate(bf):
        buckets.setdefault(f['sha256_opcode_classes'],[]).append(j)
        by_size.setdefault(f['instruction_count']//8,[]).append(j)
    raw={}
    for j,f in enumerate(bf):
        raw.setdefault(f['sha256_raw'],[]).append(j)
    proposals=[]
    for i,f in enumerate(af):
        exact = raw.get(f['sha256_raw'],[])
        normalized = buckets.get(f['sha256_opcode_classes'],[])
        if exact and len(exact)==1:
            proposals.append((1.0,'bytes_identicos',i,exact[0]))
        elif normalized and len(normalized)==1 and f['instruction_count']>=6:
            proposals.append((0.94,'categorias_de_instrucoes_iguais',i,normalized[0]))
        elif 12<=f['instruction_count']<=V010_MAX_INSN_PER_FN:
            options=[]
            n=f['instruction_count']
            eligible=[]
            for band in range(max(0,(n-max(4,n//10))//8), (n+max(4,n//10))//8+1):
                eligible.extend(by_size.get(band,[]))
            for j in eligible:
                g=bf[j]
                n,m=f['instruction_count'],g['instruction_count']
                if m<12 or abs(n-m)>max(4,n//10):
                    continue
                agrams=set(f['adjacent_category_pairs'])
                bgrams=set(g['adjacent_category_pairs'])
                if len(agrams)<3 or len(bgrams)<3:
                    continue
                jc=len(agrams&bgrams)/max(1,len(agrams|bgrams))
                score=.6*jc+.4*(1-abs(n-m)/max(n,m))
                if score>=.90:
                    options.append((score,j))
            if options:
                options.sort(reverse=True)
                if len(options)==1 or options[0][0]-options[1][0]>=0.08:
                    proposals.append((options[0][0],'semelhanca_estrutural',i,options[0][1]))
    # One-to-one and no ambiguous assertion: don't report collisions as pairs.
    props=sorted(proposals,key=lambda t:(-t[0],t[2],t[3]))
    matched_a=set();matched_b=set();candidates=[]
    for score,method,i,j in props:
        if i in matched_a or j in matched_b:
            continue
        matched_a.add(i);matched_b.add(j)
        candidates.append({'origin_vmaddr':af[i]['vmaddr'], 'target_vmaddr':bf[j]['vmaddr'],
                           'method':method,'structural_similarity':round(score,3),
                           'instructions_origin':af[i]['instruction_count'],
                           'instructions_target':bf[j]['instruction_count'],
                           'caution':'Semelhança de código não comprova equivalência funcional ou ABI.'})
        if len(candidates)>=V010_MAX_MATCHES_PER_PAIR:
            break
    return {'status':'candidatos_estruturais','source_functions':len(af),
            'target_functions':len(bf),'candidates':candidates,
            'limit_reached':len(candidates)>=V010_MAX_MATCHES_PER_PAIR}



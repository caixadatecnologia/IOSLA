def _v009_triangulation(snaps:dict[str,Snapshot],inputs:dict|None=None)->dict:
    report=_original_triangulation_v008(snaps,inputs)
    a,b,c=[snaps.get(x) for x in ('ORIGEM','CONTROLE','DESTINO')]
    if not(a and b and c):
        report['pairwise_interpretation']={'A_B':'controle_nao_fornecido','B_C':'controle_nao_fornecido'}
        return report
    comparable_ab=report['conditions']['xs_and_control_same_version_and_build']
    comparable_bc=report['conditions']['control_and_recent_same_model']
    counts=Counter()
    versions=Counter()
    for item in report['comparison']:
        ab,bc=item['xs_vs_control'],item['control_vs_recent']
        if not comparable_ab:
            item['ab_interpretation']='mesma_versao_build_nao_confirmada; metadados_apenas'
        else:
            item['ab_interpretation']=ab
        if comparable_bc:
            item['bc_interpretation']='mesmo_modelo: '+bc
            item['pattern']=('mesmo_modelo_metadados_modificados' if bc=='metadados_diferentes_no_inventario'
                             else 'mesmo_modelo_metadados_preservados' if bc=='metadados_iguais_no_inventario'
                             else 'mesmo_modelo_presenca_nao_observada') if not comparable_ab else item['pattern']
            old,new=item['versions']['CONTROL'],item['versions']['RECENT']
            if old is not None and new is not None:
                versions['versao_alterada' if old!=new else 'versao_igual']+=1
        else:
            item['bc_interpretation']='modelos_distintos_ou_desconhecidos'
        counts[item['pattern']]+=1
    report['summary']['patterns']=dict(counts)
    report['summary']['control_vs_target_versions']=dict(versions)
    report['pairwise_interpretation']={'A_B':('mesma_build_e_versao; diferencas_observacionais_de_hardware'
                                                   if comparable_ab else 'versoes_ou_builds_distintos; nao_isola_hardware'),
                                       'B_C':('mesmo_modelo; evolucao_observacional_de_versoes_e_metadados'
                                                   if comparable_bc else 'modelos_diferentes; nao_isola_evolucao_do_sistema')}
    report['warnings'].append('Comparação B↔C é preservada por par mesmo quando A↔B usa builds distintos.')
    return report


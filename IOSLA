HOME_DIR = Path.home() / 'Downloads' / 'IOSLA'
KERNEL_ROOT = HOME_DIR / 'kernelcaches'
REPORT_ROOT = HOME_DIR / 'relatorios'
DIAG_ROOT = HOME_DIR / 'diagnosticos'
FILESET_ROOT = HOME_DIR / 'regioes_fileset'


def ensure_home() -> Path:
    try:
        for folder in (HOME_DIR, KERNEL_ROOT, REPORT_ROOT, DIAG_ROOT, FILESET_ROOT):
            folder.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise IOSLAError(f'Não foi possível criar a pasta {HOME_DIR}: {exc}. Verifique as permissões do Downloads.') from exc
    return HOME_DIR


def safe_name(value: str, maxlen: int = 60) -> str:
    return re.sub(r'[^A-Za-z0-9._-]', '_', str(value))[:maxlen].strip('.') or 'desconhecido'


def snapshot_folder(label: str, metadata: dict[str, Any], archive: str) -> Path:
    """Mantém builds diferentes separados e extrai somente para ~/Downloads/IOSLA."""
    archive_path = Path(archive).expanduser().resolve()
    # Identidade da entrada local inclui path + tamanho + mtime para evitar colisões.
    stat = archive_path.stat()
    fingerprint = hashlib.sha256(f'{archive_path}:{stat.st_size}:{stat.st_mtime_ns}'.encode()).hexdigest()[:10]
    folder = KERNEL_ROOT / label.lower() / (
        safe_name(metadata.get('ios_version', 'iOS')) + '_'
        + safe_name(metadata.get('build', 'build')) + '_' + fingerprint
    )
    return folder


def write_diagnostic(name: str, payload: dict[str, Any]) -> Path:
    ensure_home()
    destination = DIAG_ROOT / (safe_name(name) + '.json')
    destination.write_text(json.dumps(payload, indent=2, ensure_ascii=False, default=str), encoding='utf-8')
    return destination


def minimal_metadata(metadata: dict[str, Any]) -> dict[str, Any]:
    return {
        'ios_version': metadata.get('ios_version'),
        'build': metadata.get('build'),
        'devices': metadata.get('devices', []),
        'zip_entries': metadata.get('zip_entries', 0),
        'kernel_references': metadata.get('kernel_references', []),
        'component_paths': metadata.get('component_paths', {}),
    }


def patch_review(old: Snapshot, new: Snapshot, report: dict[str, Any]) -> dict[str, Any]:
    """Levantamento de hipóteses, não detecção automática de patches válidos."""
    rows = []
    for row in report['comparison']:
        # Itens presentes no XS e ausentes no iPhone 11 são apenas hipóteses.
        reasons = []
        if row['status'] == 'REMOVIDA':
            reasons.append('Só listada no inventário de origem: verificar função e presença no destino.')
        elif row['status'] == 'ADICIONADA':
            reasons.append('Só listada no inventário de destino: verificar dependências novas.')
        elif row['status'] != 'SEM DIFERENÇAS DETECTADAS':
            reasons.append('Metadados divergem: investigar ABI e interface com o kernel.')
        if row['added_dependency_names'] or row['removed_dependency_names']:
            reasons.append('Dependências declaradas mudaram; revisar versões e símbolos.')
        if row['references_not_listed_old'] or row['references_not_listed_new']:
            reasons.append('Há dependências não inventariadas; NÃO equivale a dependência ausente no iOS.')
        if not reasons:
            continue
        cat = row['category']
        priority = ('Alta — investigar' if cat in {'GPU', 'GPU/Tela', 'Tela', 'Segurança', 'Armazenamento'}
                    else 'Normal — investigar')
        rows.append({
            'identifier': row['id'], 'category': cat,
            'source_version': row['old_version'], 'target_version': row['new_version'],
            'observed_status': row['status'], 'research_priority': priority,
            'observations': reasons,
            'conclusion': 'INCONCLUSIVO — não comprova compatibilidade ou possibilidade de patch',
        })
    return {
        'iosla_version': APP_VERSION,
        'generated_at': datetime.now(timezone.utc).isoformat(),
        'mode': 'levantamento estático de hipóteses (somente leitura)',
        'origin': {'ios': old.ios_version, 'device': old.device, 'coverage': old.coverage},
        'target': {'ios': new.ios_version, 'device': new.device, 'coverage': new.coverage},
        'candidate_count': len(rows),
        'candidates': rows,
        'missing_evidence': [
            'Análise de símbolos importados/exportados e ABI do kernel XNU',
            'Compatibilidade DeviceTree e identificadores de hardware',
            'Drivers e firmware de GPU, tela, touchscreen, Wi-Fi, modem e câmeras',
            'Verificações de boot, assinaturas e Secure Enclave',
            'Testes reais em dispositivo, ainda não realizados',
        ],
        'warning': 'Diferenças entre iPhone XS e iPhone 11 também refletem hardware diferente. '
                   'A lista NÃO confirma que uma KEXT precisa ser portada nem que um patch é viável.'
    }


def patch_review_markdown(data: dict[str, Any]) -> str:
    lines = [
        f'# IOSLA v{APP_VERSION} — Investigação de compatibilidade para patch', '',
        '**Resultado: inconclusivo. Este arquivo não aplica patches.**', '',
        f"Data: {data['generated_at']}", '',
        '## Fontes', '',
        f"- Origem: {data['origin']['ios']} — {data['origin']['device']}",
        f"- Destino: {data['target']['ios']} — {data['target']['device']}",
        f"- Cobertura origem: {data['origin']['coverage']}",
        f"- Cobertura destino: {data['target']['coverage']}", '',
        '## Observações a investigar', '',
    ]
    for row in data['candidates']:
        lines.extend([
            f"### {row['identifier']}", '',
            f"- Grupo: {row['category']}",
            f"- Prioridade de pesquisa: {row['research_priority']}",
            f"- Diferença observada: {row['observed_status']}",
        ])
        for note in row['observations']:
            lines.append(f'- {note}')
        lines.extend(['- Conclusão: inconclusiva', ''])
    if not data['candidates']:
        lines.extend(['Nenhuma diferença inventariada. Isso **não** comprova compatibilidade.', ''])
    lines.extend(['## Evidências ainda necessárias', ''])
    lines.extend(f'- {item}' for item in data['missing_evidence'])
    lines.extend(['', '## Limitação', '', data['warning'], ''])
    return '\n'.join(lines)


def export_patch_report(old: Snapshot, new: Snapshot, report: dict[str, Any]) -> tuple[Path, Path]:
    ensure_home()
    data = patch_review(old, new, report)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    jp = REPORT_ROOT / f'IOSLA_PATCH_{stamp}.json'
    md = REPORT_ROOT / f'IOSLA_PATCH_{stamp}.md'
    jp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')
    md.write_text(patch_review_markdown(data), encoding='utf-8')
    return jp, md


class Style:
    enabled = sys.stdout.isatty() and not os.environ.get('NO_COLOR')
    BLUE = '\033[94m' if enabled else ''
    CYAN = '\033[96m' if enabled else ''
    GREEN = '\033[92m' if enabled else ''
    YELLOW = '\033[93m' if enabled else ''
    RED = '\033[91m' if enabled else ''
    RESET = '\033[0m' if enabled else ''



class Terminal:
    """Interface guiada: somente números e caminho do IPSW arrastado."""

    def __init__(self):
        self.inputs: dict[str, dict[str, Any]] = {}
        self.snapshots: dict[str, Snapshot] = {}
        self.last_summary: dict[str, Any] | None = None
        self.generated: list[Path] = []

    @staticmethod
    def normalize_drop(raw: str) -> Path:
        """Aceita caminhos comuns, escapados, entre aspas e URLs file:// locais."""
        raw = raw.strip()
        if not raw:
            raise IOSLAError('Nenhum arquivo informado.')
        if raw.startswith('file://'):
            parsed = urlparse(raw)
            if parsed.netloc not in ('', 'localhost'):
                raise IOSLAError('Arraste um arquivo local, não uma URL remota.')
            raw = unquote(parsed.path)
        else:
            # O terminal do VS Code no macOS costuma colar espaços como \ .
            try:
                tokens = shlex.split(raw)
            except ValueError as exc:
                raise IOSLAError('Caminho mal formatado: verifique as aspas.') from exc
            if tokens:
                raw = ' '.join(tokens)
        path = Path(os.path.expandvars(raw)).expanduser().resolve()
        if not path.is_file():
            raise IOSLAError('IPSW não encontrado: ' + str(path))
        return path

    def show(self):
        print('\n' + Style.BLUE + '═' * 62 + Style.RESET)
        print('          IOSLA v0.0.7  |  KEXT PORTABILITY RESEARCH')
        print('              Offline · Somente leitura')
        print(Style.BLUE + '═' * 62 + Style.RESET)
        for label, title in (('ORIGEM', 'iPhone XS (iOS 18)'),
                             ('DESTINO', 'iPhone 11 (destino)')):
            item = self.inputs.get(label)
            if item:
                info = item['meta']
                print(f" {title:25} [OK] iOS {info['ios_version']} / {info['build']}")
            else:
                print(f' {title:25} [ ] Aguardando IPSW')
        print('\n [1] Arrastar IPSW do iPhone XS')
        print(' [2] Arrastar IPSW do iPhone 11')
        print(' [3] ANALISAR TUDO E GERAR RELATÓRIOS')
        print(' [4] Ver resultados e abrir pasta Downloads/IOSLA')
        print(' [0] Sair')
        print('\n Digite apenas o número da opção.')

    def load(self, label: str):
        title = {'ORIGEM': 'iPhone XS — referência iOS 18', 'DESTINO': 'iPhone 11 — iOS recente', 'CONTROLE': 'iPhone 11 — CONTROLE iOS 18'}[label]
        print('\n' + Style.CYAN + 'CARREGAR: ' + title + Style.RESET)
        raw = input(' Arraste o IPSW aqui e pressione ENTER: ')
        if not raw.strip():
            print(' [AVISO] Nenhum arquivo selecionado.')
            return
        path = self.normalize_drop(raw)
        print(' [..] Lendo informações do IPSW...')
        meta = inspect_ipsw(path)
        expected = 'iPhone11,2' if label == 'ORIGEM' else 'iPhone12,1'
        devices = meta.get('devices', [])
        if devices and expected not in devices:
            raise IOSLAError(f'IPSW não declara suporte a {expected}. '
                             f'Dispositivos identificados: {", ".join(map(str, devices))}')
        self.inputs[label] = {'path': path, 'meta': meta}
        self.snapshots.pop(label, None)
        self.last_summary = None
        self.generated.clear()
        print(f" [OK] {path.name}")
        print(f"      iOS {meta['ios_version']} · build {meta['build']}")
        print(f"      Kernelcaches disponíveis: {len(meta['kernel_references'])}")
        if not meta['kernel_references']:
            print(' [AVISO] Nenhum kernelcache foi localizado. O diagnóstico')
            print('         e a comparação de manifestos ainda serão gerados.')
        if 'ORIGEM' in self.inputs and 'DESTINO' in self.inputs:
            print(' [PRONTO] Escolha [3] para iniciar toda a análise.')

    @staticmethod
    def choose_kernel(meta: dict[str, Any], label: str) -> tuple[str | None, str]:
        entries = meta.get('kernel_references', [])
        if not entries:
            return None, 'Nenhum kernelcache encontrado'
        # Prioriza release e a família de hardware correspondente.
        family = 'iphone11' if label == 'ORIGEM' else 'iphone12'
        def score(name: str) -> tuple[int, int, int, str]:
            low = name.lower()
            base = Path(low).name
            return (
                1 if family in base else 0,
                1 if 'release' in base else 0,
                1 if 'kernelcache' in base else 0,
                low,
            )
        selected = sorted(entries, key=score, reverse=True)[0]
        note = ('Seleção automática: ' + selected
                + (' (outras variantes disponíveis; conferir se necessário)' if len(entries) > 1 else ''))
        return selected, note

    def _snapshot(self, label: str) -> tuple[Snapshot | None, dict[str, Any]]:
        item = self.inputs[label]
        meta = item['meta']
        origin = item['path']
        device = 'iPhone11,2' if label == 'ORIGEM' else 'iPhone12,1'
        selected, selection_note = self.choose_kernel(meta, label)
        diag: dict[str, Any] = {
            'ipsw': str(origin),
            'device': device,
            'firmware': minimal_metadata(meta),
            'automatic_selection': selection_note,
            'status': 'não analisado',
        }
        if selected is None:
            diag['status'] = 'sem kernelcache'
            return None, diag
        extracted: Path | None = None
        try:
            folder = snapshot_folder(label, meta, str(origin))
            print('      Extraindo o kernelcache selecionado...')
            extracted = extract_kernel(str(origin), folder, label, selection=selected)
            diag['kernelcache'] = str(extracted)
            print('      Identificando KEXTs e dependências...')
            snap = load_kernel(
                extracted, label,
                ios_version=meta['ios_version'], build=meta['build'],
                device=device, origin=str(origin), kind='ipsw-local',
                manifest_components=meta['component_names'],
            )
            diag.update({
                'status': 'analisado parcialmente', 'coverage': snap.coverage,
                'kext_count': len(snap.kexts), 'notes': snap.analysis_notes,
            })
            return snap, diag
        except (IOSLAError, KernelFormatError, OSError, ValueError, MemoryError) as exc:
            diag.update({
                'status': 'kernelcache não interpretado',
                'error': str(exc),
                'kernelcache': str(extracted) if extracted else None,
            })
            return None, diag

    def analyze(self):
        if any(key not in self.inputs for key in ('ORIGEM', 'DESTINO')):
            raise IOSLAError('Antes, escolha [1] e [2] e arraste os dois IPSWs.')
        ensure_home()
        print('\n' + Style.BLUE + '══ ANÁLISE AUTOMÁTICA ══' + Style.RESET)
        self.snapshots.clear()
        self.generated.clear()
        snapshots_diag: dict[str, Any] = {}
        for label in ('ORIGEM', 'DESTINO'):
            print('\n  >', 'iPhone XS / origem' if label == 'ORIGEM' else 'iPhone 11 / destino')
            snapshot, diag = self._snapshot(label)
            snapshots_diag[label] = diag
            diagnostic = write_diagnostic(label.lower() + '_ultima_analise', diag)
            self.generated.append(diagnostic)
            if snapshot:
                self.snapshots[label] = snapshot
                print(f"  [OK] {len(snapshot.kexts)} entradas de KEXT ({snapshot.coverage}).")
                if len(snapshot.kexts) == 0:
                    print('  [AVISO] Zero identificadas não significa ausência de drivers.')
            else:
                print('  [AVISO] Kernelcache não interpretado; detalhe no diagnóstico.')
                if diag.get('error'):
                    print('          ' + diag['error'])

        # Comparação de componentes funciona independentemente do kernelcache.
        manifests = compare_ipsw_manifests(
            self.inputs['ORIGEM']['meta'], self.inputs['DESTINO']['meta']
        )
        stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
        manifest_path = REPORT_ROOT / f'IOSLA_MANIFESTOS_{stamp}.json'
        manifest_path.write_text(json.dumps(manifests, ensure_ascii=False, indent=2), encoding='utf-8')
        self.generated.append(manifest_path)
        overview: dict[str, Any] = {
            'iosla_version': APP_VERSION,
            'generated_at': datetime.now(timezone.utc).isoformat(),
            'mode': 'análise local, somente leitura',
            'firmwares': snapshots_diag,
            'manifest_changes': len([row for row in manifests if row['status'] != 'MESMO TAMANHO/CRC32']),
            'kernel_and_kext_analysis': 'indisponível',
            'warning': 'Comparações estáticas não comprovam compatibilidade nem patch funcional.',
            'files': [],
        }
        if (len(self.snapshots) == 2 and
                all(len(s.kexts) > 0 for s in self.snapshots.values())):
            old, new = self.snapshots['ORIGEM'], self.snapshots['DESTINO']
            report = compare_kexts(old, new)
            json_path, md_path = export_report(report, REPORT_ROOT)
            patch_json, patch_md = export_patch_report(old, new, report)
            self.generated.extend((json_path, md_path, patch_json, patch_md))
            overview['kernel_and_kext_analysis'] = 'parcial, com dados identificados'
            overview['kext_comparison_summary'] = report['summary']
            overview['patch_observations'] = len(patch_review(old, new, report)['candidates'])
        else:
            overview['kernel_and_kext_analysis'] = (
                'não concluída: pelo menos um kernelcache falhou ou não apresentou KEXTs'
            )
            print('\n  [AVISO] Sem inventários de KEXTs suficientes para comparação.')
            print('          Relatórios de manifestos e de diagnóstico foram salvos.')
        overview['files'] = [str(f) for f in self.generated]
        report_json = REPORT_ROOT / f'IOSLA_RESUMO_{stamp}.json'
        report_md = REPORT_ROOT / f'IOSLA_RESUMO_{stamp}.md'
        report_json.write_text(json.dumps(overview, ensure_ascii=False, indent=2), encoding='utf-8')
        report_md.write_text(
            f'# IOSLA v{APP_VERSION} — Resultado da análise\n\n'
            + f"- Data: {overview['generated_at']}\n"
            + f"- Comparação de KEXTs: {overview['kernel_and_kext_analysis']}\n"
            + f"- Componentes de manifesto divergentes: {overview['manifest_changes']}\n"
            + '\n## Diagnóstico por IPSW\n'
            + ''.join(f"\n### {label}\n- Status: {d['status']}\n- Seleção: {d['automatic_selection']}\n"
                      + (f"- Erro: {d['error']}\n" if d.get('error') else '')
                      for label, d in snapshots_diag.items())
            + '\n## Observação\n\n' + overview['warning'] + '\n',
            encoding='utf-8'
        )
        self.generated.extend((report_json, report_md))
        overview['files'].extend((str(report_json), str(report_md)))
        report_json.write_text(json.dumps(overview, ensure_ascii=False, indent=2), encoding='utf-8')
        self.last_summary = overview
        print('\n  [CONCLUÍDO] Arquivos salvos em:')
        print('  ' + str(REPORT_ROOT))
        print('  Selecione [4] para consultar e abrir a pasta.')

    def results(self):
        print('\n══ RESULTADOS ══')
        if not self.last_summary:
            print(' Nenhuma análise nesta sessão. Selecione [3] para analisar.')
            print(' Pasta padrão:', HOME_DIR)
            return
        summary = self.last_summary
        print(' KEXTs:', summary['kernel_and_kext_analysis'])
        print(' Diferenças nos manifestos:', summary['manifest_changes'])
        if 'patch_observations' in summary:
            print(' Hipóteses para investigação:', summary['patch_observations'])
        print(' Arquivos gerados:', len(self.generated))
        print(' Pasta:', REPORT_ROOT)
        if sys.platform == 'darwin':
            try:
                subprocess.run(['open', str(REPORT_ROOT)], check=True)
            except (OSError, subprocess.CalledProcessError):
                print(' Não foi possível abrir o Finder automaticamente.')
        elif sys.platform == 'win32':
            try:
                os.startfile(str(REPORT_ROOT))  # type: ignore[attr-defined]
            except OSError:
                pass
        # Outros sistemas: o caminho da pasta já está mostrado no terminal.

    def run(self):
        ensure_home()
        while True:
            try:
                self.show()
                option = input(Style.CYAN + ' Número > ' + Style.RESET).strip()
                if option == '0':
                    print(' IOSLA encerrado.')
                    return
                if option == '1':
                    self.load('ORIGEM')
                elif option == '2':
                    self.load('DESTINO')
                elif option == '3':
                    self.analyze()
                elif option == '4':
                    self.results()
                else:
                    print(' [AVISO] Escolha um número de 0 a 4.')
            except (EOFError, KeyboardInterrupt):
                print('\n IOSLA encerrado.')
                return
            except (IOSLAError, KernelFormatError, OSError, ValueError, zipfile.BadZipFile) as exc:
                print(Style.RED + ' [ERRO] ' + str(exc) + Style.RESET)


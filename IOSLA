                     'V014_EVIDENCE_VALIDATION')


def _v014_mem(word:int)->dict|None:
    """Well-defined ARM64 immediate-offset loads/stores only; no type inference."""
    top=word & 0xffc00000
    forms={0xf9400000:('LDR',8),0xf9000000:('STR',8),
           0xb9400000:('LDR',4),0xb9000000:('STR',4),
           0x79400000:('LDR',2),0x79000000:('STR',2),
           0x39400000:('LDR',1),0x39000000:('STR',1)}
    info=forms.get(top)
    if info is None:return None
    operation,width=info;base=(word>>5)&31;rt=word&31
    return {'operation':operation,'width':width,'base':'SP' if base==31 else 'X'+str(base),
            'register':'ZR' if rt==31 else 'X'+str(rt),'offset':((word>>10)&4095)*width,
            'addressing':'unsigned_scaled_imm12'}


def _v014_branch(word:int,vm:int)->tuple[str,int|None]:
    """Direct B, BL, B.cond, CBZ/CBNZ; not an exhaustive CFG decoder."""
    if word&0xfc000000==0x94000000:
        return 'BL',vm+_v010_signed_imm(word&0x03ffffff,26)*4
    if word&0x7c000000==0x14000000:
        return 'B',vm+_v010_signed_imm(word&0x03ffffff,26)*4
    if word&0xff000010==0x54000000:
        return 'B_COND',vm+_v010_signed_imm((word>>5)&0x7ffff,19)*4
    if word&0x7e000000==0x34000000:
        return 'CBZ_CBNZ',vm+_v010_signed_imm((word>>5)&0x7ffff,19)*4
    return '',None


def _v014_function_semantics(raw:bytes,addr:int)->dict:
    """Conservative limited instruction abstract interpretation (not C++ decompile)."""
    count=len(raw)//4
    mem=Counter();flows=Counter();base_registers=Counter();arg_reads=Counter();ret_write=0
    branch_targets=set();out_of_window=0
    for j in range(count):
        w=int.from_bytes(raw[j*4:j*4+4],'little');pc=addr+j*4
        m=_v014_mem(w)
        if m:
            k=(m['operation'],m['width'],m['base'],m['offset'])
            mem[k]+=1;base_registers[m['base']]+=1
            if m['base'] in ('X'+str(x) for x in range(8)):
                arg_reads[m['base']]+=1
            if m['operation']=='LDR' and m['register']=='X0':ret_write+=1
        d=_v012_decode(w,pc)
        flows[d['class']]+=1
        t,target=_v014_branch(w,pc)
        if t:
            flows['branch_kind_'+t]+=1
            if t!='BL' and target is not None:
                if addr<=target<addr+len(raw):branch_targets.add(target)
                else:out_of_window+=1
        # SUB/ADD immediate on SP, observes adjustment but not ABI stack frame proof.
        if (w&0x1f)==31 and ((w>>5)&31)==31 and (w&0x1f000000)==0x11000000:
            flows['sp_immediate_arithmetic']+=1
    patterns=[{'operation':k[0],'width':k[1],'base':k[2],'offset':k[3],'count':n}
              for k,n in mem.most_common(64)]
    return {'instruction_count':count,'memory_patterns':patterns,
            'memory_patterns_truncated':len(mem)>64,
            'arg_register_based_loadstores':dict(arg_reads),'base_register_access_counts':dict(base_registers),
            'x0_load_observations':ret_write,'control_flow':dict(flows),
            'local_branch_targets':len(branch_targets), 'branch_targets_outside_window':out_of_window,
            'block_boundaries_lower_bound':len(branch_targets)+1,
            'confidence':'observacoes_de_instrucoes_selecionadas',
            'limitations':['Uso de X0-X7 não demonstra tipo nem direção de argumento.',
                           'Não resolve aliases, liveness, exceções, memória dinâmica ou despacho indireto.']}



def _v014_ptr_region(addr:int,starts:list[int],regions:list[dict])->str|None:
    k=bisect.bisect_right(starts,addr)-1
    if k<0:return None
    choices=[r for r in regions[max(0,k-12):k+1] if r['start']<=addr<r['end']]
    return choices[0]['image'] if len(choices)==1 else None


def _v014_fixups_metadata(data:bytes,img:dict)->dict:
    """Inspect presence/bounds of LC_DYLD_CHAINED_FIXUPS; do NOT decode fixup chains."""
    start=img.get('image_offset')
    if not isinstance(start,int) or not _v009_within(start,32,len(data)):
        return {'state':'macho_header_unavailable'}
    if data[start:start+4]!=MH_MAGIC_64:return {'state':'macho_header_unrecognized'}
    ncmds=int.from_bytes(data[start+16:start+20],'little')
    sizeofcmds=int.from_bytes(data[start+20:start+24],'little')
    if ncmds>4096 or sizeofcmds>2_000_000 or not _v009_within(start+32,sizeofcmds,len(data)):
        return {'state':'load_commands_out_of_bounds'}
    at=start+32;last=start+32+sizeofcmds
    for _ in range(ncmds):
        if at+8>last:return {'state':'load_commands_truncated'}
        cmd,size=struct.unpack_from('<II',data,at)
        if size<8 or at+size>last:return {'state':'load_commands_invalid'}
        if cmd==0x80000034:
            if size<16:return {'state':'fixups_command_truncated'}
            offset,length=struct.unpack_from('<II',data,at+8)
            # Fileset linkedit offsets may be absolute or image relative. Do not guess.
            locations=[]
            for model,base in (('fileset_absolute',0),('image_relative',start)):
                absolute=base+offset
                if length>=28 and length<4*1024*1024 and _v009_within(absolute,length,len(data)):
                    try:
                        h=struct.unpack_from('<7I',data,absolute)
                        if h[0] in (0,1) and all(v < length for v in h[1:4]):
                            locations.append({'model':model,'offset':absolute,
                              'header':{'fixups_version':h[0], 'starts_offset':h[1],
                                        'imports_offset':h[2],'symbols_offset':h[3],
                                        'imports_count':h[4],'imports_format':h[5],
                                        'symbols_format':h[6]}})
                    except struct.error:pass
            return {'state':'header_candidates' if locations else 'command_present_header_not_validated',
                    'dataoff':offset,'datasize':length,'header_candidates':locations,
                    'payload_interpreted':False,'fixup_chains_decoded':False,
                    'coordinate_model':'unresolved' if len(locations)!=1 else locations[0]['model']}
        at+=size
    return {'state':'command_absent','payload_interpreted':False}


def _v014_pointer_inventory_for_image(data:bytes,img:dict,starts:list[int],regions:list[dict])->dict:
    """Read exact raw data pointers; PAC-encoded/fixed pointers may be invisible."""
    summary={'image':img.get('identifier'),'fixups':_v014_fixups_metadata(data,img),
             'data_bytes_scanned':0,'exact_executable_pointers':0,'pointer_runs':[],
             'truncated':False,'raw_matches_only':True}
    runs=[];matched=0;bytes_total=0
    for segname in ('__DATA_CONST','__DATA'):
        s=img.get('mappings',{}).get(segname,{})
        mp=s.get('file_mapping',{})
        if mp.get('state')!='resolvido':continue
        offset=mp.get('offset');size=min(s.get('filesize',0),V014_MAX_PTR_BYTES_PER_IMAGE-bytes_total)
        if not isinstance(offset,int) or size<=0 or not _v009_within(offset,size,len(data)):continue
        if s.get('filesize',0)>size:summary['truncated']=True
        bytes_total+=size
        run=[]
        for pos in range(offset,offset+size-7,8):
            val=int.from_bytes(data[pos:pos+8],'little')
            owner=_v014_ptr_region(val,starts,regions)
            if owner:
                matched+=1
                run.append({'data_file_offset':pos,'target_vmaddr':hex(val),'target_image':owner})
                if len(run)>100:run=run[:100];summary['truncated']=True
            else:
                if len(run)>=3 and len(runs)<V014_MAX_CODE_POINTER_RUNS:
                    runs.append({'section':segname,'length':len(run),
                       'samples':run[:8],'candidate_kind':'raw_code_pointer_array_not_proven_vtable'})
                run=[]
        if len(run)>=3 and len(runs)<V014_MAX_CODE_POINTER_RUNS:
            runs.append({'section':segname,'length':len(run),'samples':run[:8],
                         'candidate_kind':'raw_code_pointer_array_not_proven_vtable'})
    summary['data_bytes_scanned']=bytes_total
    summary['exact_executable_pointers']=matched
    summary['pointer_runs']=runs
    summary['pointer_run_limit_reached']=len(runs)>=V014_MAX_CODE_POINTER_RUNS
    return summary



# ==========================================================================
# IOSLA ABI ENGINE v0.0.3 — inspeção estática conservadora de símbolos Mach-O
# ==========================================================================

ABI_LIMIT_PER_IMAGE = 250_000
ABI_MAX_IMAGES = 2_048
LC_SYMTAB_ABI = 0x2
LC_DYLD_INFO_ABI = 0x22
LC_DYLD_EXPORTS_TRIE_ABI = 0x80000033


def _abi_uleb(data: bytes, pos: int, end: int) -> tuple[int, int]:
    result, shift = 0, 0
    while pos < end and shift < 70:
        b = data[pos]
        pos += 1
        result |= (b & 127) << shift
        if not (b & 128):
            return result, pos
        shift += 7
    raise ValueError('ULEB128 inválido/truncado')


def _abi_exports_trie(buf: bytes) -> set[str]:
    """Lê somente nomes da trie; não tenta resolver reexports, ordinais ou ABI."""
    names: set[str] = set()
    stack = [(0, '', frozenset())]
    examined = 0
    while stack and examined < ABI_LIMIT_PER_IMAGE:
        off, prefix, parents = stack.pop()
        examined += 1
        if off >= len(buf) or off in parents or len(prefix) > 1024:
            continue
        try:
            terminal, p = _abi_uleb(buf, off, len(buf))
            if p + terminal >= len(buf):
                continue
            if terminal:
                names.add(prefix)
            p += terminal
            children = buf[p]
            p += 1
            for _ in range(children):
                endname = buf.find(b'\x00', p)
                if endname < 0 or endname - p > 512:
                    raise ValueError('nome da trie inválido')
                edge = buf[p:endname].decode('utf-8', 'replace')
                target, p = _abi_uleb(buf, endname + 1, len(buf))
                if edge:
                    stack.append((target, prefix + edge, parents | {off}))
        except (ValueError, IndexError):
            continue
    return names


def _abi_valid_symbol(name: str) -> bool:
    return bool(name and len(name) <= 768 and all(32 <= ord(c) <= 126 for c in name))


def _abi_symtab(data: bytes, base: int, endian: str, command: tuple[int,int,int,int]):
    symoff, nsyms, stroff, strsize = command
    if nsyms < 1 or nsyms > ABI_LIMIT_PER_IMAGE or strsize > 96 * 1024 * 1024:
        return set(), set(), 'symtab ausente/fora do limite'
    candidates = []
    for delta in dict.fromkeys((0, base)):
        symbol_start, string_start = delta + symoff, delta + stroff
        if symbol_start < 0 or string_start < 0 or symbol_start + nsyms * 16 > len(data) or string_start + strsize > len(data):
            continue
        symbols, undefined, quality, considered = set(), set(), 0, 0
        strings = data[string_start:string_start + strsize]
        for index in range(nsyms):
            p = symbol_start + index * 16
            strx, typ, sect, desc, value = struct.unpack_from(endian + 'IBBHQ', data, p)
            if strx == 0 or strx >= len(strings) or (typ & 0xE0):
                continue
            considered += 1
            z = strings.find(b'\x00', strx, min(len(strings), strx + 768))
            if z < 0:
                continue
            name = strings[strx:z].decode('utf-8', 'replace')
            if not _abi_valid_symbol(name):
                continue
            quality += 1
            typecode = typ & 0x0e
            if typecode == 0 and (typ & 1):
                undefined.add(name)
            elif typecode in (0x0e, 0x02) and (typ & 1):
                symbols.add(name)
        # Rejeita leituras deslocadas/espúrias mesmo que encontrem alguns nomes.
        if considered and quality / considered >= 0.80:
            candidates.append((quality, symbols, undefined, delta))
    if not candidates:
        return set(), set(), 'LC_SYMTAB presente, mas offsets/strings não verificáveis'
    _, exports, imports, delta = max(candidates, key=lambda x: x[0])
    return exports, imports, f'LC_SYMTAB ({"offset de fileset" if delta == 0 else "offset relativo"})'




def _abi_chained_imports(buf: bytes) -> set[str]:
    """Import names from dyld_chained_fixups_header, if unambiguously readable.

    Only reads import name metadata; does not fix pointers or execute dyld logic.
    """
    if len(buf) < 28:
        return set()
    version, starts, imports, symbols, count, imp_format, symbol_format = struct.unpack_from('<7I', buf, 0)
    if version != 0 or count > ABI_LIMIT_PER_IMAGE or imp_format not in (1, 2, 3):
        return set()
    if imports > len(buf) or symbols > len(buf):
        return set()
    symbol_pool = buf[symbols:]
    if symbol_format == 1:
        try:
            symbol_pool = zlib.decompress(symbol_pool)
        except zlib.error:
            return set()
    elif symbol_format != 0:
        return set()
    stride = {1:4, 2:8, 3:16}[imp_format]
    if imports + count * stride > len(buf):
        return set()
    names=set()
    for index in range(count):
        entry=imports+index*stride
        if imp_format == 3:
            value=struct.unpack_from('<Q',buf,entry)[0]
            name_offset=(value >> 32) & 0xffffffff
        else:
            value=struct.unpack_from('<I',buf,entry)[0]
            name_offset=value >> 9
        if name_offset >= len(symbol_pool):
            continue
        end=symbol_pool.find(b'\0',name_offset,min(len(symbol_pool),name_offset+768))
        if end < 0:
            continue
        candidate=symbol_pool[name_offset:end].decode('utf-8','replace')
        if _abi_valid_symbol(candidate):
            names.add(candidate)
    return names

def _abi_parse_image(data: bytes, offset: int, identifier: str) -> dict:
    """Mach-O 64: coleta nomes exportados/importados expostos em load commands."""
    empty = {'id':identifier, 'exports':set(), 'imports':set(), 'methods':[], 'notes':[], 'has_symbols':False}
    if offset + 32 > len(data) or data[offset:offset+4] not in (MH_MAGIC_64, MH_CIGAM_64):
        empty['notes'].append('Mach-O inválido/ausente')
        return empty
    endian = '<' if data[offset:offset+4] == MH_MAGIC_64 else '>'
    try:
        _, _, _, _, ncmds, sizeofcmds, _, _ = struct.unpack_from(endian+'IiiIIIII', data, offset)
    except struct.error:
        empty['notes'].append('Cabeçalho Mach-O truncado')
        return empty
    if ncmds > 100000 or sizeofcmds > len(data) - offset - 32:
        empty['notes'].append('Comandos Mach-O inválidos')
        return empty
    p, end = offset+32, offset+32+sizeofcmds
    symtab = None
    trie = []
    chained = []
    for _ in range(ncmds):
        if p+8 > end:
            break
        cmd, size = struct.unpack_from(endian+'II', data, p)
        if size < 8 or p+size > end:
            break
        if cmd == LC_SYMTAB_ABI and size >= 24:
            symtab = struct.unpack_from(endian+'IIII', data, p+8)
        if cmd == LC_DYLD_EXPORTS_TRIE_ABI and size >= 16:
            trie.append(struct.unpack_from(endian+'II', data, p+8))
        if cmd == 0x80000034 and size >= 16:
            chained.append(struct.unpack_from(endian+'II', data, p+8))
        if cmd in (LC_DYLD_INFO_ABI, LC_DYLD_INFO_ABI | 0x80000000) and size >= 48:
            trie.append(struct.unpack_from(endian+'II', data, p+40))
        p += size
    if symtab:
        exports, imports, method = _abi_symtab(data, offset, endian, symtab)
        empty['exports'].update(exports)
        empty['imports'].update(imports)
        empty['methods'].append(method)
        if exports or imports:
            empty['has_symbols'] = True
    for fileoff, size in trie:
        if size == 0 or size > 32 * 1024 * 1024:
            continue
        # Um offset de export trie pode ser relativo à imagem ou ao fileset.
        candidates = []
        for pos in dict.fromkeys((fileoff, offset + fileoff)):
            if pos + size <= len(data):
                names = _abi_exports_trie(data[pos:pos + size])
                if names:
                    candidates.append(names)
        if candidates:
            empty['exports'].update(max(candidates, key=len))
            empty['methods'].append('LC_DYLD_EXPORTS_TRIE / dyld_info')
            empty['has_symbols'] = True
    for fileoff, size in chained:
        if size <= 0 or size > 48 * 1024 * 1024:
            continue
        candidates=[]
        for pos in dict.fromkeys((fileoff, offset+fileoff)):
            if pos+size <= len(data):
                names=_abi_chained_imports(data[pos:pos+size])
                if names:
                    candidates.append(names)
        if candidates:
            empty['imports'].update(max(candidates,key=len))
            empty['methods'].append('LC_DYLD_CHAINED_FIXUPS: nomes de import observáveis')
            empty['has_symbols']=True
    if not empty['has_symbols']:
        empty['notes'].append('Sem símbolos recuperáveis via symtab/trie/fixups; possivelmente stripped.')
    return empty


def extract_kernel_abi(path: str | Path) -> dict:
    """Carrega kernelcache local e retorna apenas evidências observáveis (somente leitura)."""
    p = Path(path).expanduser().resolve()
    if p.stat().st_size > MAX_INPUT:
        raise KernelFormatError('Kernelcache acima do limite de leitura')
    decoded, descriptor, parser_notes = _unwrap(p.read_bytes())
    entries, _ = _read_macho(decoded)
    if len(entries) > ABI_MAX_IMAGES:
        raise KernelFormatError('Excesso de imagens fileset no kernelcache')
    images = {'com.apple.kernel': _abi_parse_image(decoded, 0, 'com.apple.kernel')}
    errors = 0
    for e in entries:
        name = e.get('name', '')
        offset = e.get('offset', -1)
        if not name or not isinstance(offset,int) or offset <= 0 or name in images:
            continue
        item = _abi_parse_image(decoded, offset, name)
        if item['notes'] and 'Mach-O inválido/ausente' in item['notes']:
            errors += 1
        images[name] = item
    return {
        'path': str(p), 'format': descriptor, 'decoded_bytes': len(decoded),
        'entries': len(entries), 'images_analyzed': len(images), 'invalid_images': errors,
        'images_with_symbols': sum(x['has_symbols'] for x in images.values()),
        'images': images, 'notes': parser_notes,
    }


def _abi_inventory_info(snapshot, identifier: str) -> dict:
    k = snapshot.kexts.get(identifier) if snapshot else None
    if not k:
        return {'version': None, 'dependencies': {}}
    return {'version': k.version, 'dependencies': dict(k.dependencies)}


def make_abi_report(old: dict | None, new: dict | None, old_snap=None, new_snap=None,
                    errors: dict | None = None) -> dict:
    """Resultados conservadores. Nunca conclui ABI compatível só por símbolos presentes."""
    errors = errors or {}
    old_images = old['images'] if old else {}
    new_images = new['images'] if new else {}
    all_exports = set().union(*(item['exports'] for item in new_images.values())) if new_images else set()
    target_complete = False  # Mesmo com símbolos presentes, caches Apple geralmente não fornecem cobertura total.
    rows = []
    for name in sorted(set(old_images) | set(new_images)):
        a, b = old_images.get(name), new_images.get(name)
        old_meta, new_meta = _abi_inventory_info(old_snap, name), _abi_inventory_info(new_snap, name)
        status = ('APENAS ORIGEM' if not b else 'APENAS DESTINO' if not a else 'NOS DOIS')
        if a and b and a['has_symbols'] and b['has_symbols']:
            missing = sorted(a['imports'] - all_exports)
            check = 'PARCIAL: símbolos observáveis comparados, sem validação de ABI'
        elif a and b:
            missing = []
            check = 'INCONCLUSIVO: tabela de símbolos insuficiente'
        else:
            missing = []
            check = 'INCONCLUSIVO: imagem não presente no outro inventário'
        rows.append({
            'identifier': name, 'presence': status,
            'source_kext_version': old_meta['version'], 'target_kext_version': new_meta['version'],
            'source_declared_dependencies': old_meta['dependencies'],
            'target_declared_dependencies': new_meta['dependencies'],
            'source_export_count': len(a['exports']) if a else 0,
            'source_import_count': len(a['imports']) if a else 0,
            'target_export_count': len(b['exports']) if b else 0,
            'target_import_count': len(b['imports']) if b else 0,
            'source_methods': a['methods'] if a else [], 'target_methods': b['methods'] if b else [],
            'source_notes': a['notes'] if a else [], 'target_notes': b['notes'] if b else [],
            'unobserved_import_count': len(missing),
            'unobserved_import_examples': missing[:25],
            'assessment': check,
        })
    priority = lambda r: (0 if any(v in r['identifier'].lower() for v in ('agx','iogpu','iosurface','armplatform','devicetree')) else 1,
                          0 if r['source_import_count'] else 1, r['identifier'])
    rows.sort(key=priority)
    return {
        'iosla_version': '0.0.3', 'mode':'ABI estática exploratória — somente leitura',
        'generated_at': datetime.now(timezone.utc).isoformat(),
        'origin': {k:old[k] for k in ('path','format','entries','images_analyzed','invalid_images','images_with_symbols') } if old else None,
        'target': {k:new[k] for k in ('path','format','entries','images_analyzed','invalid_images','images_with_symbols')} if new else None,
        'errors':errors,
        'summary':{
            'images_compared':len(rows),
            'images_in_both':sum(r['presence']=='NOS DOIS' for r in rows),
            'images_only_source':sum(r['presence']=='APENAS ORIGEM' for r in rows),
            'images_only_target':sum(r['presence']=='APENAS DESTINO' for r in rows),
            'source_imports_total_observed':sum(r['source_import_count'] for r in rows),
            'source_imports_not_observed_total':sum(r['unobserved_import_count'] for r in rows),
            'origin_images_with_symbols':old['images_with_symbols'] if old else 0,
            'target_images_with_symbols':new['images_with_symbols'] if new else 0,
            'full_abi_coverage': target_complete,
        },
        'comparison':rows,
        'limitations':[
            'Não prova compatibilidade nem incompatibilidade ABI: símbolos podem ter sido removidos (stripped) ou ocultados.',
            'Um símbolo não observado entre os exportados disponíveis NÃO significa símbolo ausente no iOS.',
            'Nomes iguais não garantem layouts, calling conventions, ABI C++, versionamento, semântica nem ligação correta.',
            'A versão de uma dependência OSBundleLibraries não garante compatibilidade binária.',
            'Análise do kernelcache NÃO cobre a totalidade de userland, SEP, boot, DeviceTree e firmware de cada controlador.',
            'Diferenças entre A12 e A13 também refletem hardware distinto.',
            'Nenhuma alteração, patch, assinatura ou restauração de IPSW é executada.',
        ],
    }


def abi_markdown(report: dict) -> str:
    lines = ['# IOSLA v0.0.3 — Kernel ABI Analyzer', '',
             f"Gerado: {report['generated_at']}", '',
             '**Resultado: pesquisa estática inconclusiva. Nenhuma compatibilidade foi demonstrada.**', '',
             '## Cobertura', '']
    for key,title in (('origin','Origem'),('target','Destino')):
        info=report[key]
        if info:
            lines.append(f"- {title}: {info['images_analyzed']} imagens Mach-O, "
                         f"{info['images_with_symbols']} com símbolos recuperáveis; {info['entries']} entradas fileset.")
        else:
            lines.append(f'- {title}: não analisada; veja erros.')
    lines.extend(['','## Resumo de símbolos observáveis',''])
    for k,v in report['summary'].items():
        lines.append(f'- {k}: {v}')
    if report['errors']:
        lines.extend(['', '## Erros', ''])
        for key, v in report['errors'].items():
            lines.append(f'- {key}: {v}')
    lines.extend(['','## Componentes a investigar','',
                  '| Imagem Mach-O | Presença | Imports origem | Exports destino | Não observados* | Avaliação |',
                  '|---|---|---:|---:|---:|---|'])
    for r in report['comparison']:
        esc=lambda x: str(x).replace('|','\\|').replace('\n',' ')
        lines.append('| ' + ' | '.join([esc(r['identifier']),esc(r['presence']),
            str(r['source_import_count']),str(r['target_export_count']),
            str(r['unobserved_import_count']),esc(r['assessment'])]) + ' |')
    lines.extend(['','*“Não observados” = ausentes do conjunto de exports recuperado, NÃO prova de ausência no sistema.*',
                  '', '## Limitações', ''])
    lines.extend('- '+x for x in report['limitations'])
    return '\n'.join(lines)+'\n'


def save_abi_report(report:dict, directory:Path=REPORT_ROOT) -> tuple[Path,Path]:
    directory.mkdir(parents=True,exist_ok=True)
    stamp = datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    json_path = directory/f'IOSLA_ABI_{stamp}.json'
    md_path = directory/f'IOSLA_ABI_{stamp}.md'
    json_path.write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
    md_path.write_text(abi_markdown(report),encoding='utf-8')
    return json_path,md_path


def analyze_abi_paths(path_a: str|Path|None, path_b: str|Path|None,
                      old_snap=None,new_snap=None,report_dir: Path=REPORT_ROOT):
    observed = {}
    errors={}
    for label,path in (('ORIGEM',path_a),('DESTINO',path_b)):
        if path is None:
            errors[label]='Kernelcache indisponível para esta sessão'
            continue
        try:
            observed[label]=extract_kernel_abi(path)
        except (KernelFormatError,OSError,ValueError,MemoryError) as exc:
            errors[label]=str(exc)
    report=make_abi_report(observed.get('ORIGEM'), observed.get('DESTINO'),old_snap,new_snap,errors)
    result=save_abi_report(report,report_dir)
    return report,result



        if len(candidates)!=1:destination={}
        else:destination=idx.get('DESTINO',{}).get(library,{}).get(candidates[0].get('vmaddr'),{})
        first=source.get('v016_contract',{});second=destination.get('v016_contract',{})
        if first.get('observation_sha256') and second.get('observation_sha256'):
            state=('limited_observations_equal' if first['observation_sha256']==second['observation_sha256']
               else 'limited_observations_differ')
        else:state='insufficient_or_ambiguous_candidate'
        states[state]+=1
        rows.append({'library':library,'origin_function':a,'calls':t.get('calls_from_agxg11p'),
            'destination_candidate':destination.get('vmaddr'),
            'structural_state':t.get('a_to_c',{}).get('state'),
            'contract_evidence_state':state,
            'origin_window_complete':first.get('observed_window_complete'),
            'destination_window_complete':second.get('observed_window_complete'),
            'observed_sha256_origin':first.get('observation_sha256'),
            'observed_sha256_destination':second.get('observation_sha256'),
            'abi_contract':'not_demonstrated'})
    return _v016_stamp('contratos observáveis via CFG e propagação conservadora',
        {'targets_evaluated':len(rows),'states':dict(states)},targets=rows)


def _v016_alignment(results:dict,continuity:dict)->dict:
    """Limited heuristic shortlist, explicitly not a proof of one-to-one ABI."""
    idx=_v016_index_functions(results);rows=[];states=Counter()
    for t in continuity.get('targets',[])[:V016_REPORT_ROWS]:
        lib=t.get('library');addr=t.get('origin_target_function')
        source=idx.get('ORIGEM',{}).get(lib,{}).get(addr)
        dests=list(idx.get('DESTINO',{}).get(lib,{}).values())
        if not source or not source.get('v016_contract') or not dests:
            rows.append({'library':lib,'source_function':addr,
               'state':'insufficient_source_or_destination_data','candidates':[]});
            states['insufficient_source_or_destination_data']+=1;continue
        n=source.get('instructions_scanned',0)
        short=[]
        for candidate in dests:
            if not candidate.get('v016_contract'):continue
            m=candidate.get('instructions_scanned',0)
            if abs(n-m)>max(12,int(.18*max(n,m,1))):continue
            a=source['v016_contract']['features'];b=candidate['v016_contract']['features']
            # Evidence from selected observed features only. Do not label a true match.
            ca=set(map(str,a.get('mem',[])));cb=set(map(str,b.get('mem',[])))
            if not ca or not cb:continue
            jacc=len(ca&cb)/len(ca|cb)
            blocks=1-abs(a['block_count']-b['block_count'])/max(1,a['block_count'],b['block_count'])
            calls=1-abs(a['call_events']-b['call_events'])/max(1,a['call_events'],b['call_events'])
            score=.60*jacc+.25*blocks+.15*calls
            if score>=.75:short.append((score,candidate['vmaddr']))
        short.sort(key=lambda z:(-z[0],z[1]))
        state='limited_context_candidates' if short else 'no_candidate_above_heuristic_threshold'
        if len(short)>1 and short[0][0]-short[1][0]<.08:state='ambiguous_candidates'
        states[state]+=1
        rows.append({'library':lib,'source_function':addr,'state':state,
           'candidates':[{'vmaddr':v,'limited_score':round(s,4)} for s,v in short[:5]],
           'independent_abi_evidence':False})
    return _v016_stamp('alinhamento heurístico CFG/memória, sem inferência automática de ABI',
       {'targets':len(rows),'states':dict(states)},targets=rows)


def _v016_refs(pointer_data:dict|None)->dict:
    """Reuse genuine v14 per-image pointer inventories; never infer '0' from missing input."""
    observations={}; totals=Counter(); states={}
    for label,scan in (pointer_data or {}).items():
        if not isinstance(scan,dict):
            states[label]='invalid_inventory';continue
        images=scan.get('images')
        if not isinstance(images,list):
            states[label]='missing_image_list';continue
        rows=[]
        for item in images:
            if not isinstance(item,dict):continue
            ptrs=int(item.get('exact_executable_pointers',0) or 0)
            runs=item.get('pointer_runs',[]) or []
            nbytes=int(item.get('data_bytes_scanned',0) or 0)
            limited=bool(item.get('truncated') or item.get('pointer_run_limit_reached'))
            fx=item.get('fixups') or {}
            row={'image':item.get('image'),'exact_executable_pointers':ptrs,
                'data_bytes_scanned':nbytes,'candidate_pointer_runs':len(runs),
                'pointer_scan_limited':limited,'fixup_state':fx.get('state','not_reported'),
                'fixup_chains_decoded':bool(fx.get('fixup_chains_decoded',False)),
                'candidate_runs_sample':runs[:8]}
            rows.append(row)
            totals['exact_executable_pointers']+=ptrs
            totals['data_bytes_scanned']+=nbytes
            totals['candidate_pointer_runs']+=len(runs)
            totals['pointer_images_inspected']+=1
            totals['pointer_images_limited']+=int(limited)
        states[label]=('inspected' if any(x['data_bytes_scanned']>0 for x in rows)
                       else 'no_mapped_data_sections' if rows else 'no_focus_images_observed')
        observations[label]={'state':states[label],'images_inspected':len(rows),
            'format':scan.get('format'),'parser_notes':scan.get('parser_notes',[])[:8],
            'images':rows,'image_rows_limited':False}
    for needed in ('ORIGEM','DESTINO'):
        if needed not in observations and needed not in states:states[needed]='not_available'
    summary={'firmwares_with_inventory':len(observations),'states':states,
        'totals':dict(totals),'full_fixup_resolution':False,
        'observed_raw_pointers_only':True}
    return _v016_stamp('inventário real de referências Mach-O reaproveitado do laboratório v0.0.14',
        summary,firmwares=observations,missing_firmwares=[k for k,v in states.items() if v!='inspected'])



def _v016_hardware(docs:dict)->dict:
    atlas=docs.get('A12_HARDWARE_ATLAS',{});iokit=docs.get('EVIDENCIAS',{})
    categories=['GPU/tela','memoria/IOMMU','energia','armazenamento','audio/sensores','conectividade']
    rows=[]
    for item in categories:
        rows.append({'subsystem':item,'declared_evidence_available':bool(atlas or iokit),
          'runtime_driver_binding':'not_verified','firmware_protocol':'not_verified',
          'abi':'not_demonstrated','integrity_or_boot':'outside_scope'})
    return _v016_stamp('relações de dependência declarada e requisitos não demonstrados',
       {'subsystems':len(rows),'atlas_loaded':bool(atlas),'iokit_evidence_loaded':bool(iokit)},
       subsystems=rows)


def _v016_hypothesis(abi:dict,alignment:dict,continuity:dict)->dict:
    align_idx={(r['library'],r['source_function']):r for r in alignment.get('targets',[])}
    observations=[];states=Counter()
    for t in abi.get('targets',[]):
        match=align_idx.get((t['library'],t['origin_function']),{})
        if t['contract_evidence_state']=='limited_observations_differ':
            status='difference_observed_review_needed'
        elif t['contract_evidence_state']=='limited_observations_equal':
            status='limited_structural_agreement_no_abi_proof'
        elif match.get('state')=='ambiguous_candidates':
            status='ambiguous_alignment'
        else:status='unresolved'
        states[status]+=1
        observations.append({'library':t['library'],'source_function':t['origin_function'],
             'calls':t['calls'],'status':status,'abi_equivalence':None,
             'evidence':['IOSLA_ABI_CONTINUITY','V016_ABI_CONTRACTS','V016_FUNCTION_ALIGNMENT']})
    observations.sort(key=lambda x:(-int(x['calls'] or 0),x['source_function'] or ''))
    return _v016_stamp('teste de hipóteses apenas contra evidências estáticas e contraexemplos',
       {'targets':len(observations),'states':dict(states)},
       prioritized_hypotheses=observations[:V016_REPORT_ROWS])


def _v016_quality(results:dict)->dict:
    """Explicit whole-input, per-image, per-function coverage without invented precision."""
    totals=Counter(); by_firmware={}; image_rows=[]; gaps=[]
    for label,scan in results.items():
        subtotals=Counter()
        for name,img in scan.get('images',{}).items():
            audit=img.get('v016_audit') or {}
            fns=img.get('functions',[])
            if not audit:
                if fns:
                    gaps.append({'firmware':label,'image':name,'reason':'v016_analysis_not_available'})
                continue
            ins_limited=blocks_limited=edges_limited=events_limited=nonconverged=0
            indirect=0;with_cfg=0;missing_contract=0
            for f in fns:
                cfg=f.get('v016_cfg')
                if not cfg:continue
                with_cfg+=1
                flow=f.get('v016_dataflow') or {}
                ins_limited+=int(bool(cfg.get('instruction_limit_reached')))
                blocks_limited+=int(bool(cfg.get('blocks_limited')))
                edges_limited+=int(bool(cfg.get('edges_limited')))
                events_limited+=int(bool(flow.get('events_limited')))
                nonconverged+=int(not flow.get('fixpoint_completed',False))
                indirect+=sum(cfg.get('unresolved_indirect',{}).values())
                missing_contract+=int('v016_contract' not in f)
            row={'firmware':label,'image':name,'functions_indexed':len(fns),
              'functions_with_cfg':with_cfg,'functions_omitted_by_cap':int(audit.get('functions_omitted_by_cap',0)),
              'invalid_windows':int(audit.get('invalid_windows',0)),
              'instruction_limited':ins_limited,'block_limited':blocks_limited,
              'edge_limited':edges_limited,'event_limited':events_limited,
              'dataflow_not_converged':nonconverged,
              'unresolved_indirect_sites':indirect,
              'missing_contract_observations':missing_contract,
              'full_abi_coverage':False}
            image_rows.append(row)
            for k,v in row.items():
                if k not in ('firmware','image','full_abi_coverage') and isinstance(v,int):
                    subtotals[k]+=v;totals[k]+=v
        by_firmware[label]=dict(subtotals)
    for needed in ('ORIGEM','DESTINO'):
        if needed not in results:gaps.append({'firmware':needed,'reason':'firmware_scan_unavailable'})
    return _v016_stamp('cobertura explícita por firmware e imagem, sem ground truth Apple',
      {'functions_with_cfg':totals['functions_with_cfg'],'counters':dict(totals),
       'firmware_totals':by_firmware,'image_rows':len(image_rows),
       'coverage_complete':False,
       'precision_measurement':'only_synthetic_labeled_fixtures'},
      image_coverage=image_rows,missing_inputs=gaps,
      validation_notes=['Autoteste sintético não comprova precisão em kernelcache Apple real.',
      'Parcialidade inclui instruções, blocos, arestas, eventos, janelas e convergência.',
      'Uma imagem sem CFG não é prova de ausência de suas funções.',
      'O resultado nunca declara compatibilidade ABI ou inicialização.'])



def _v016_collect(results:dict,pointers:dict|None=None,docs:dict|None=None)->dict:
    docs=docs or {}
    continuity=docs.get('ABI_CONTINUITY') or _v011_continuity(results)[1]
    a=_v016_scans(results,'v016_cfg')
    b=_v016_scans(results,'v016_dataflow')
    cfg=_v016_stamp('grafos de blocos básicos em janelas de código verificadas',
        {'functions':a['total_observations'],'per_firmware':a['per_firmware'],
         'rows_limited':a['reported_rows_limited']},functions=a['rows'],coverage=a['coverage'])
    flow=_v016_stamp('proveniência conservadora entre blocos de fluxo',
        {'functions':b['total_observations'],'per_firmware':b['per_firmware'],
         'rows_limited':b['reported_rows_limited']},functions=b['rows'],coverage=b['coverage'])
    abi=_v016_abi_contracts(results,continuity)
    alignment=_v016_alignment(results,continuity)
    refs=_v016_refs(pointers)
    hardware=_v016_hardware(docs)
    hypotheses=_v016_hypothesis(abi,alignment,continuity)
    quality=_v016_quality(results)
    return dict(zip(V016_REPORT_TYPES,[cfg,flow,abi,alignment,refs,hardware,hypotheses,quality]))


def _v016_markdown(report:dict)->str:
    lines=[f'# IOSLA v{APP_VERSION} — {report.get("mode", "Relatório")}',
       '', '**Somente leitura. ABI, compatibilidade e boot não demonstrados.**','',
       '## Resumo','','```json',json.dumps(report.get('summary',{}),ensure_ascii=False,indent=2),'```','']
    for k in ('functions','targets','firmwares','subsystems','prioritized_hypotheses','validation_notes'):
        v=report.get(k)
        if not isinstance(v,(list,dict)):continue
        lines+=['## '+k,'']
        sample=v[:8] if isinstance(v,list) else dict(list(v.items())[:8])
        lines+=['```json',json.dumps(sample,ensure_ascii=False,indent=2)[:22000],'```','']
        if isinstance(v,list) and len(v)>8:lines+=['Registros adicionais disponíveis no JSON.','']
    lines+=['## Limitações','']+['- '+str(x) for x in report.get('limitations',[])]+['']
    return '\n'.join(lines)

V016B_SQLITE_BLOCK_LIMIT = 250_000
V016B_SQLITE_EDGE_LIMIT = 350_000
V016B_SQLITE_EVENT_LIMIT = 150_000
V016B_SQLITE_ENTRY_LIMIT = 70_000


def _v016_database(db_path:Path,reports:dict,results:dict)->dict:
    """Local SQLite, including bounded blocks/edges/post-fixpoint events and coverage.

    Only already validated/observed data from v16 is stored. Limits are recorded
    explicitly in the run index and are not reinterpreted as absent evidence.
    """
    db_path.parent.mkdir(parents=True,exist_ok=True)
    con=sqlite3.connect(db_path)
    counters=Counter()
    try:
        con.execute('PRAGMA foreign_keys=ON')
        con.executescript("""CREATE TABLE IF NOT EXISTS runs (
          run_id INTEGER PRIMARY KEY AUTOINCREMENT, created_utc TEXT NOT NULL,
          iosla_version TEXT NOT NULL, scope TEXT NOT NULL);
          CREATE TABLE IF NOT EXISTS functions (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          vmaddr TEXT NOT NULL, cfg_blocks INTEGER, cfg_edges INTEGER,
          instruction_count INTEGER, truncated INTEGER,
          fingerprint TEXT, FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016_fn ON functions(run_id,firmware,image,vmaddr);
          CREATE TABLE IF NOT EXISTS matches (
          run_id INTEGER NOT NULL, library TEXT NOT NULL, source_vmaddr TEXT NOT NULL,
          candidate_vmaddr TEXT, state TEXT NOT NULL, calls INTEGER,
          abi_proven INTEGER NOT NULL DEFAULT 0,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016_match ON matches(run_id,library,source_vmaddr);
          CREATE TABLE IF NOT EXISTS report_index (
          run_id INTEGER NOT NULL, report_type TEXT NOT NULL,
          report_summary_json TEXT NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE TABLE IF NOT EXISTS cfg_blocks (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          function_vmaddr TEXT NOT NULL, block_id INTEGER NOT NULL,
          start_vmaddr TEXT NOT NULL, end_exclusive TEXT NOT NULL,
          instructions INTEGER NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016b_blocks ON cfg_blocks(run_id,firmware,image,function_vmaddr,block_id);
          CREATE TABLE IF NOT EXISTS cfg_edges (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          function_vmaddr TEXT NOT NULL, source_block INTEGER NOT NULL,
          destination_block INTEGER NOT NULL, edge_kind TEXT NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016b_edges ON cfg_edges(run_id,firmware,image,function_vmaddr);
          CREATE TABLE IF NOT EXISTS dataflow_events (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          function_vmaddr TEXT NOT NULL, site_vmaddr TEXT NOT NULL,
          block_id INTEGER, operation TEXT NOT NULL, source_root TEXT,
          relative_byte_offset INTEGER, width INTEGER, destination_vmaddr TEXT,
          argument_origins_json TEXT NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016b_events ON dataflow_events(run_id,firmware,image,function_vmaddr);
          CREATE TABLE IF NOT EXISTS dataflow_entry_origins (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          function_vmaddr TEXT NOT NULL, block_id INTEGER NOT NULL,
          known_registers_json TEXT NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016b_entry ON dataflow_entry_origins(run_id,firmware,image,function_vmaddr);
          CREATE TABLE IF NOT EXISTS function_coverage (
          run_id INTEGER NOT NULL, firmware TEXT NOT NULL, image TEXT NOT NULL,
          function_vmaddr TEXT NOT NULL, instruction_limited INTEGER NOT NULL,
          blocks_limited INTEGER NOT NULL, edges_limited INTEGER NOT NULL,
          events_limited INTEGER NOT NULL, fixpoint_completed INTEGER NOT NULL,
          unresolved_indirect_json TEXT NOT NULL,
          FOREIGN KEY(run_id) REFERENCES runs(run_id));
          CREATE INDEX IF NOT EXISTS ix_v016b_coverage ON function_coverage(run_id,firmware,image,function_vmaddr);
          """)
        with con:
            cur=con.execute('INSERT INTO runs(created_utc,iosla_version,scope) VALUES (?,?,?)',
                (datetime.now(timezone.utc).isoformat(),APP_VERSION,'offline_static_only'))
            run=cur.lastrowid
            for label,scan in sorted(results.items()):
                for name,img in sorted(scan.get('images',{}).items()):
                    for f in img.get('functions',[]):
                        cfg=f.get('v016_cfg')
                        if not cfg:continue
                        addr=f.get('vmaddr');flow=f.get('v016_dataflow') or {}
                        fingerprint=(f.get('v016_contract') or {}).get('observation_sha256')
                        con.execute('INSERT INTO functions VALUES (?,?,?,?,?,?,?,?,?)',(
                            run,label,name,addr,cfg.get('block_count'),cfg.get('edge_count'),
                            cfg.get('instruction_count'),int(bool(cfg.get('instruction_limit_reached'))),fingerprint))
                        counters['functions_indexed']+=1
                        con.execute('INSERT INTO function_coverage VALUES (?,?,?,?,?,?,?,?,?,?)',(
                            run,label,name,addr,int(bool(cfg.get('instruction_limit_reached'))),
                            int(bool(cfg.get('blocks_limited'))),int(bool(cfg.get('edges_limited'))),
                            int(bool(flow.get('events_limited'))),int(bool(flow.get('fixpoint_completed'))),
                            json.dumps(cfg.get('unresolved_indirect',{}),ensure_ascii=False,sort_keys=True)))
                        ids=[]
                        for b in cfg.get('blocks',[]):
                            if counters['cfg_blocks_indexed']>=V016B_SQLITE_BLOCK_LIMIT:
                                counters['cfg_blocks_omitted_by_db_cap']+=1;continue
                            con.execute('INSERT INTO cfg_blocks VALUES (?,?,?,?,?,?,?,?)',(
                                run,label,name,addr,int(b['id']),b['start'],b['end_exclusive'],int(b['instructions'])))
                            counters['cfg_blocks_indexed']+=1;ids.append(int(b['id']))
                        allowed=set(ids)
                        for e in cfg.get('edges',[]):
                            if counters['cfg_edges_indexed']>=V016B_SQLITE_EDGE_LIMIT:
                                counters['cfg_edges_omitted_by_db_cap']+=1;continue
                            if e['from'] not in allowed or e['to'] not in allowed:
                                counters['cfg_edges_omitted_due_to_missing_block']+=1;continue
                            con.execute('INSERT INTO cfg_edges VALUES (?,?,?,?,?,?,?)',(
                                run,label,name,addr,int(e['from']),int(e['to']),str(e['kind'])))
                            counters['cfg_edges_indexed']+=1
                        for ev in flow.get('events',[]):
                            if counters['dataflow_events_indexed']>=V016B_SQLITE_EVENT_LIMIT:
                                counters['dataflow_events_omitted_by_db_cap']+=1;continue
                            con.execute('INSERT INTO dataflow_events VALUES (?,?,?,?,?,?,?,?,?,?,?,?)',(
                               run,label,name,addr,ev.get('site',''),ev.get('block'),ev.get('operation','unknown'),
                               ev.get('source_root'),ev.get('relative_byte_offset'),ev.get('width'),
                               ev.get('destination'),json.dumps(ev.get('argument_origins',{}),ensure_ascii=False,sort_keys=True)))
                            counters['dataflow_events_indexed']+=1
                        for entry in flow.get('tracked_origins_at_block_entry',[]):
                            if counters['block_entries_indexed']>=V016B_SQLITE_ENTRY_LIMIT:
                                counters['block_entries_omitted_by_db_cap']+=1;continue
                            con.execute('INSERT INTO dataflow_entry_origins VALUES (?,?,?,?,?,?)',(
                                run,label,name,addr,int(entry['block']),
                                json.dumps(entry.get('known_registers',{}),ensure_ascii=False,sort_keys=True)))
                            counters['block_entries_indexed']+=1
            matches=[]
            for row in reports['V016_ABI_CONTRACTS'].get('targets',[]):
                matches.append((run,row['library'],row['origin_function'],row['destination_candidate'],
                    row['contract_evidence_state'],row['calls'],0))
            con.executemany('INSERT INTO matches VALUES (?,?,?,?,?,?,?)',matches)
            counters['matches_indexed']=len(matches)
            con.executemany('INSERT INTO report_index VALUES (?,?,?)',[
                (run,k,json.dumps(v.get('summary',{}),ensure_ascii=False)) for k,v in reports.items()])
        caps={'blocks':V016B_SQLITE_BLOCK_LIMIT,'edges':V016B_SQLITE_EDGE_LIMIT,
            'events':V016B_SQLITE_EVENT_LIMIT,'block_entries':V016B_SQLITE_ENTRY_LIMIT}
        return {'run_id':run,'database':str(db_path),'queries_are_local':True,
           'coverage_and_storage':dict(counters),'caps':caps,
           'functions_indexed':counters['functions_indexed'],
           'matches_indexed':counters['matches_indexed'],
           'cfg_blocks_indexed':counters['cfg_blocks_indexed'],
           'cfg_edges_indexed':counters['cfg_edges_indexed'],
           'dataflow_events_indexed':counters['dataflow_events_indexed']}
    finally:con.close()




SIGNAL_GROUPS = {
    'GPU e tela': (r'(?:^|[\s/,._-])(sgx|gpu|agx|gfx|display|disp\d*|dcp|mipi|panel|iosurface)(?:$|[\s/,._-])',
                  r'AGX|IOGPU|IOSurface|display|graphics|GPU|framebuffer'),
    'Armazenamento': (r'(?:^|[\s/,._-])(ans|nvme|nand|storage|apfs|sart|sio)(?:$|[\s/,._-])',
                    r'ANS|NVMe|NAND|storage|AppleFS|APFS'),
    'Wi-Fi e Bluetooth': (r'(?:^|[\s/,._-])(wlan|wifi|wi-fi|bluetooth|bcm43\d+|airport|btm)(?:$|[\s/,._-])',
                        r'WiFi|Wi-Fi|WLAN|Bluetooth|BCM43|AirPort'),
    'Modem e celular': (r'(?:^|[\s/,._-])(baseband|modem|cellular|pcie)(?:$|[\s/,._-])',
                      r'Baseband|MAV|ICE|Modem'),
    'Áudio e háptica': (r'(?:^|[\s/,._-])(audio|aop-audio|codec|speaker|amp|haptic|mca\d*|alc\d*|cs42|microphone)(?:$|[\s/,._-])',
                       r'Audio|Haptic|Codec|Speaker|AOP'),
    'Câmera e ISP': (r'(?:^|[\s/,._-])(camera|isp|csi|sensor|imx\d+|applecam)(?:$|[\s/,._-])',
                    r'Camera|AppleH|ISP|AVD|AVE'),
    'Toque e sensores': (r'(?:^|[\s/,._-])(multitouch|touch|digitizer|prox|als|accelerometer|gyro|sensor)(?:$|[\s/,._-])',
                        r'Multitouch|Touch|ALS|Sensor|Accelerometer|Gyro'),
    'Energia e relógios': (r'(?:^|[\s/,._-])(pmgr|pmu|pmp|spmi|clock|power|thermal|sochot|tempsensor|regulator)(?:$|[\s/,._-])',
                         r'PMGR|PMU|PMP|SPMI|Power|Clock|Thermal|Battery'),
    'Segurança e SEP': (r'(?:^|[\s/,._-])(sep|aes|security|trust|effaceable|hilo)(?:$|[\s/,._-])',
                       r'PearlSEP|SEP|AppleKeyStore|Image4|Security|Effaceable|crypto'),
    'USB e portas': (r'(?:^|[\s/,._-])(usb|otg|typec|lightning|atc-phy|dock)(?:$|[\s/,._-])',
                     r'USB|AppleUSB|Lightning|TypeC'),
    'ANE e aprendizado': (r'(?:^|[\s/,._-])(ane|neural)(?:$|[\s/,._-])',
                          r'ANE|Neural'),
}
GROUP_PATTERNS = {group:(re.compile(node,re.I),re.compile(kext,re.I))
                  for group,(node,kext) in SIGNAL_GROUPS.items()}
# Campos técnicos de alta rotatividade: registrar no arquivo bruto da v0.0.4,
# mas não interpretá-los como mudanças funcionais da placa.
NOISE_PROPERTIES = frozenset({
    'aapl,phandle','phandle','linux,phandle','device-tree-tag','time-stamp',
    'boot-time','boot-args','chosen','random-seed'
})
CRITICAL_PROPERTY_RE = re.compile(
    r'(^reg$|^ranges$|interrupt|^irq|^gpio|^clock|^power|^pmu|^voltage|^frequency|^freq|'
    r'^dma|^dart|^iommu|^memory|^compatible$|^device_type$|^status$|^enable|^firmware|^chip)', re.I)
META_KEYS = ('IONameMatch','IONameMatched','IOProviderClass','IOClass','IOPropertyMatch')


def _v005_group_nodes(trees:dict) -> dict:
    out={}
    for label,dt in trees.items():
        groups={g:[] for g in GROUP_PATTERNS}
        for path, node in dt.get('nodes',{}).items():
            searchable=path+' '+ ' '.join(node.get('text',{}).get('compatible',[]))
            searchable+=' '+ ' '.join(node.get('text',{}).get('device_type',[]))
            for group,(rx,_) in GROUP_PATTERNS.items():
                if rx.search(searchable):
                    groups[group].append(path)
        out[label]=groups
    return out


def _v005_property_diff(dt_a:dict,dt_b:dict) -> dict:
    a=dt_a.get('nodes',{}); b=dt_b.get('nodes',{})
    by_path=[]
    counts=Counter()
    for path in sorted(set(a)&set(b)):
        pa=a[path].get('properties',{}); pb=b[path].get('properties',{})
        allnames=set(pa)|set(pb)
        diffs=[name for name in allnames if name not in pa or name not in pb or
               pa[name].get('sha256')!=pb[name].get('sha256')]
        if not diffs:
            continue
        noise=sorted(k for k in diffs if k.lower() in NOISE_PROPERTIES)
        significant=sorted(k for k in diffs if k.lower() not in NOISE_PROPERTIES)
        if noise: counts['ruido_suprimido']+=len(noise)
        if not significant:
            counts['caminhos_so_ruido']+=1
            continue
        critical=sorted(k for k in significant if CRITICAL_PROPERTY_RE.search(k))
        other=sorted(set(significant)-set(critical))
        counts['caminhos_com_sinais']+=1
        counts['propriedades_criticas']+=len(critical)
        counts['propriedades_outros']+=len(other)
        # Hashes disponíveis no laudo completo de DeviceTree; sem valores binários aqui.
        by_path.append({'path':path,'critical_properties':critical,
                        'other_properties':other,'noise_excluded':noise,
                        'priority':'alta' if critical else 'observação'})
    return {'counts':dict(counts),'significant_paths':by_path,
            'noise_keys_excluded':sorted(NOISE_PROPERTIES),
            'limitations':'Mudança de hash pode refletir valores de placa/firmware, não regressão.'}


def _v005_explicit_matches(node:dict, kext:Kext) -> list[str]:
    """Apenas correspondência textual verificável; não significa binding real."""
    texts=node.get('text',{})
    values={s.lower() for key in ('name','compatible','device_type') for s in texts.get(key,[])}
    matched=[]
    for personality,rule in kext.personality_matching.items():
        for key in ('IONameMatch','IONameMatched'):
            fields=rule.get(key,[])
            if isinstance(fields,str): fields=[fields]
            if isinstance(fields,list):
                for val in fields:
                    if isinstance(val,str) and val.lower() in values:
                        matched.append(personality+':'+key+'='+val)
        propmatch=rule.get('IOPropertyMatch',{})
        if isinstance(propmatch,dict):
            for key in ('compatible','name','device_type'):
                test=propmatch.get(key,[])
                if isinstance(test,str):test=[test]
                if isinstance(test,list):
                    for v in test:
                        if isinstance(v,str) and v.lower() in {x.lower() for x in texts.get(key,[])}:
                            matched.append(personality+':IOPropertyMatch.'+key+'='+v)
    return sorted(set(matched))


def _v005_group_kexts(snapshots:dict)->dict:
    groups={}
    for label,snap in snapshots.items():
        local={g:[] for g in GROUP_PATTERNS}
        for identifier,kext in snap.kexts.items():
            for group,(_,rx) in GROUP_PATTERNS.items():
                if rx.search(identifier):
                    local[group].append(identifier)
        groups[label]=local
    return groups


def _v005_group_evidence(inputs:dict, snapshots:dict, trees:dict, changes:dict, group_nodes:dict) -> list[dict]:
    grouped_kexts=_v005_group_kexts(snapshots)
    rows=[]
    changed_set={r['path']:r for r in changes['significant_paths']}
    for group in GROUP_PATTERNS:
        row={'subsystem':group,'origin':{},'target':{},'differences':{},
             'evaluation':'EVIDÊNCIA PARCIAL — associação temática não comprova vínculo KEXT→nó'}
        for label, side in [('ORIGEM','origin'),('DESTINO','target')]:
            snap=snapshots.get(label)
            node_paths=group_nodes.get(label,{}).get(group,[])
            ids=grouped_kexts.get(label,{}).get(group,[])
            dt=trees.get(label,{}).get('nodes',{})
            matches=[]
            if snap:
                for kid in ids:
                    kext=snap.kexts[kid]
                    if kext.personality_matching:
                        for path in node_paths:
                            m=_v005_explicit_matches(dt.get(path,{}),kext)
                            if m:
                                matches.append({'node_path':path,'kext':kid,'rules':m,
                                                'evidence':'regra IOKit e propriedade DT coincidem textualmente'})
            row[side]={'node_paths':node_paths,
                       'kext_ids':ids,
                       'declared_dependency_ids':sorted(set(
                          dep for kid in ids for dep in
                          (snap.kexts[kid].dependencies if snap else {})))[:150],
                       'explicit_textual_matches':matches[:80],
                       'explicit_match_count':len(matches),
                       'coverage':'parcial' if snap and label in trees else 'insuficiente'}
        oa=set(row['origin']['node_paths']); ob=set(row['target']['node_paths'])
        a_ids=set(row['origin']['kext_ids']); b_ids=set(row['target']['kext_ids'])
        row['differences']={
            'nodes_only_origin':sorted(oa-ob), 'nodes_only_target':sorted(ob-oa),
            'kexts_only_origin':sorted(a_ids-b_ids), 'kexts_only_target':sorted(b_ids-a_ids),
            'changed_same_path':sorted((oa&ob)&changed_set.keys()),
            'critical_property_examples':[
                {'path':p,'properties':changed_set[p]['critical_properties']}
                for p in sorted((oa&ob)&changed_set.keys())
                if changed_set[p]['critical_properties']][:20],
        }
        if not any((oa,ob,a_ids,b_ids)):
            row['evaluation']='SEM DADOS SUFICIENTES — nenhum controlador ou driver categorizado'
        rows.append(row)
    return rows


def make_hardware_research(inputs:dict, snapshots:dict, dt_report:dict|None=None,
                           *, decoded_trees:dict|None=None)->dict:
    """Puro para testes com ADT decodificadas; em produção lê apenas arquivos extraídos."""
    trees=decoded_trees or {}
    warnings=[]
    if not trees:
        for label in ('ORIGEM','DESTINO'):
            location=(dt_report or {}).get('sources',{}).get(label,{}).get('path')
            if not location:
                warnings.append(label+': DeviceTree não disponível'); continue
            try:
                trees[label]=parse_apple_devicetree(Path(location).read_bytes())
            except (OSError,DeviceTreeFormatError,KernelFormatError,ValueError) as exc:
                warnings.append(label+': '+str(exc))
    allnames=set(trees.get('ORIGEM',{}).get('nodes',{}))|set(trees.get('DESTINO',{}).get('nodes',{}))
    diff=_v005_property_diff(trees.get('ORIGEM',{}),trees.get('DESTINO',{}))
    bynode=_v005_group_nodes(trees)
    bygroup=_v005_group_evidence(inputs,snapshots,trees,diff,bynode)
    for label in ('ORIGEM','DESTINO'):
        if label not in snapshots:
            warnings.append(label+': inventário de KEXT não disponível; associação limitada')
    old=inputs.get('ORIGEM',{}).get('meta',{}); new=inputs.get('DESTINO',{}).get('meta',{})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'investigação estática, offline e somente leitura',
            'devices':{'origin':{'id':'iPhone11,2','ios':old.get('ios_version','?')},
                       'target':{'id':'iPhone12,1','ios':new.get('ios_version','?')}},
            'coverage':'parcial' if len(trees)==2 and len(snapshots)==2 else 'insuficiente',
            'summaries':{'unique_paths':len(allnames),
                         'significant_changed_paths':diff['counts'].get('caminhos_com_sinais',0),
                         'excluded_noise_changes':diff['counts'].get('ruido_suprimido',0),
                         'explicit_textual_matches':sum(row[side]['explicit_match_count'] for row in bygroup
                                                        for side in ('origin','target'))},
            'semantic_properties':diff, 'subsystems':bygroup,
            'evidence_status':{'confirmed':'Os identificadores, caminhos, dependências e hashes foram observados estaticamente.',
                               'hypotheses':'Relações por categoria/nome são apenas candidatas; não são drivers identificados como vinculados.',
                               'unverified':'ABI, comportamento em runtime, assinatura e capacidade de boot não foram demonstrados.'},
            'warnings':warnings,
            'limitations':[
                'Diferentes modelos físicos: uma diferença não demonstra driver removido do sistema.',
                'Um hash diferente não mede a compatibilidade funcional de um controlador.',
                'A presença de regras IOKit relacionadas a nomes/compatible é pista textual, não prova de binding real.',
                'KEXTs podem estar ausentes do inventário parcial sem estarem ausentes do firmware.',
                'Nenhuma compatibilidade ABI nem método de boot foram demonstrados.',
                'Este programa não aplica patches, não altera IPSWs e não restaura dispositivos.']}


def hardware_research_markdown(data:dict)->str:
    lines=[f'# IOSLA v{APP_VERSION} — Hardware Compatibility Research', '',
           '**Investigação estática, somente leitura; não valida patches nem boot.**','',
           '## Sistemas','',
           '- Origem: iPhone XS · iOS '+data['devices']['origin']['ios'],
           '- Destino: iPhone 11 · iOS '+data['devices']['target']['ios'],
           '- Cobertura: **'+data['coverage']+'**','',
           '## Sumário','']
    for k,v in data['summaries'].items(): lines.append(f'- {k}: **{v}**')
    lines.extend(['','### Interpretação das evidências','','- **Observado:** '+data['evidence_status']['confirmed'],
                  '- **Hipótese:** '+data['evidence_status']['hypotheses'],
                  '- **Não verificado:** '+data['evidence_status']['unverified'],'',
                  '## Análise por subsistema',''])
    for group in data['subsystems']:
        lines.extend([f"### {group['subsystem']}",'',group['evaluation'],'',
                      '| Evidência | Origem | Destino |','|---|---:|---:|',
                      f"| Nós DeviceTree classificados | {len(group['origin']['node_paths'])} | {len(group['target']['node_paths'])} |",
                      f"| KEXTs classificadas | {len(group['origin']['kext_ids'])} | {len(group['target']['kext_ids'])} |",
                      f"| Correspondências textuais explícitas | {group['origin']['explicit_match_count']} | {group['target']['explicit_match_count']} |",''])
        differences=group['differences']
        for k,label in (('kexts_only_origin','KEXTs só origem'),('kexts_only_target','KEXTs só destino'),
                        ('nodes_only_origin','Nós só origem'),('nodes_only_target','Nós só destino')):
            names=differences[k]
            if names:
                lines.append(f'**{label}:** '+', '.join('`'+s.replace('`','')+'`' for s in names[:7])+
                             (' (e outros)' if len(names)>7 else ''))
        signals=differences['critical_property_examples']
        if signals:
            lines.append('**Propriedades estruturais relevantes (amostra):**')
            for row in signals[:7]:
                lines.append('- `'+row['path'].replace('`','')+'`: '+', '.join('`'+v+'`' for v in row['properties'][:7]))
        lines.append('')
    if data['warnings']:
        lines.extend(['## Avisos','']+['- '+x for x in data['warnings']]+[''])
    lines.extend(['## Limitações','']+['- '+x for x in data['limitations']]+[''])
    return '\n'.join(lines)


def export_hardware_research(report:dict,directory:Path)->tuple[Path,Path]:
    directory.mkdir(parents=True,exist_ok=True)
    stamp=datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    a=directory/f'IOSLA_HARDWARE_{stamp}.json'
    b=directory/f'IOSLA_HARDWARE_{stamp}.md'
    a.write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf8')
    b.write_text(hardware_research_markdown(report),encoding='utf8')
    return a,b



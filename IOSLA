def _abi_structure_info(data:bytes,start:int)->dict:
    info={'state':'imagem_invalida','symtab_state':'indeterminada',
          'symtab_command_present':False,'nsyms':None,
          'linkedit_present':False,'linkedit_fileoff':None,
          'linkedit_filesize':None,'export_trie_command_present':False,
          'chained_fixups_command_present':False,'offset_models_checked':[],
          'notes':[]}
    if start<0 or start+32>len(data) or data[start:start+4] not in (MH_MAGIC_64,MH_CIGAM_64):
        return info
    endian='<' if data[start:start+4]==MH_MAGIC_64 else '>'
    try:
        header=struct.unpack_from(endian+'IiiIIIII',data,start)
    except struct.error:
        return info
    ncmds,commandsize=header[4],header[5]
    if ncmds>20000 or commandsize>len(data)-start-32:
        info['state']='comandos_invalidos'
        return info
    info['state']='macho_lido'
    pos=start+32;end=pos+commandsize
    sym=None
    for _ in range(ncmds):
        if pos+8>end:
            info['state']='comandos_truncados';return info
        cmd,size=struct.unpack_from(endian+'II',data,pos)
        if size<8 or pos+size>end:
            info['state']='comandos_invalidos';return info
        if cmd==LC_SEGMENT_64 and size>=72:
            name=data[pos+8:pos+24].rstrip(b'\x00')
            if name==b'__LINKEDIT':
                try:
                    vmaddr,vmsize,fileoff,filesize=struct.unpack_from(endian+'QQQQ',data,pos+24)
                    info.update({'linkedit_present':True,'linkedit_vmaddr':vmaddr,
                                 'linkedit_fileoff':fileoff,'linkedit_filesize':filesize})
                except struct.error:
                    pass
        elif cmd==LC_SYMTAB_ABI and size>=24:
            sym=struct.unpack_from(endian+'IIII',data,pos+8)
            info['symtab_command_present']=True
        elif cmd==LC_DYLD_EXPORTS_TRIE_ABI:
            info['export_trie_command_present']=True
        elif cmd==0x80000034:
            info['chained_fixups_command_present']=True
        elif cmd in (LC_DYLD_INFO_ABI,LC_DYLD_INFO_ABI|0x80000000):
            info['export_trie_command_present']=True
        pos+=size
    if sym is None:
        info['symtab_state']='comando_ausente'
        return info
    symoff,nsyms,stroff,strsize=sym
    info['nsyms']=nsyms
    info['string_table_size']=strsize
    if nsyms==0:
        info['symtab_state']='tabela_vazia'
        return info
    if nsyms>ABI_LIMIT_PER_IMAGE or strsize>96*1024*1024 or strsize==0:
        info['symtab_state']='contagens_invalidas'
        return info
    for label,base in [('fileset_absoluto',0),('imagem_relativa',start)]:
        a,b=symoff+base,stroff+base
        in_range=(a>=0 and b>=0 and a+nsyms*16<=len(data)
                  and b+strsize<=len(data))
        info['offset_models_checked'].append({'model':label,'within_file_bounds':in_range})
        if not in_range:
            continue
        # Referências Mach-O potencialmente relativas ao kernelcache ou à imagem.
        # Validar pelo conteúdo, não pela aparência do endereço.
        strbuf=data[b:b+strsize]
        sampled=min(nsyms,256)
        valid=0
        for i in range(sampled):
            strx,typ,sect,desc,value=struct.unpack_from(endian+'IBBHQ',data,a+i*16)
            if not (0<strx<len(strbuf)):
                continue
            zero=strbuf.find(b'\x00',strx,min(len(strbuf),strx+768))
            if zero<0:
                continue
            name=strbuf[strx:zero].decode('ascii','replace')
            if _abi_valid_symbol(name):valid+=1
        info['offset_models_checked'][-1]['plausible_names_sample']=valid
    if not any(r['within_file_bounds'] for r in info['offset_models_checked']):
        info['symtab_state']='offsets_fora_arquivo'
    elif any(r.get('plausible_names_sample',0) for r in info['offset_models_checked']):
        info['symtab_state']='tabela_com_nomes_plausiveis'
    else:
        info['symtab_state']='dados_sem_nomes_verificaveis'
    return info


def _abi_parse_image(data:bytes,offset:int,identifier:str)->dict:
    result=_original_abi_parse_image_v003(data,offset,identifier)
    diag=_abi_structure_info(data,offset)
    result['structure_diagnostic']=diag
    # Importante: LC_SYMTAB ausente não equivale a deslocamento fora dos limites.
    if not result['has_symbols']:
        result['notes']=[x for x in result['notes'] if x!='Sem símbolos recuperáveis via symtab/trie/fixups; possivelmente stripped.']
        result['notes'].append('Símbolos não observáveis; causa LC_SYMTAB: '+diag['symtab_state']+
                               '. Não se conclui que o binário é stripped.')
    return result



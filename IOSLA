V014_MAX_FUNCTION_INSNS = 1024
V014_MAX_PTR_BYTES_PER_IMAGE = 512 * 1024
V014_MAX_POINTER_RECORDS = 12000
V014_MAX_CODE_POINTER_RUNS = 100

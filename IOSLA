def _v010_synthetic_image(version:int) -> tuple[bytes,dict]:
    """Mach-O file with split __TEXT_EXEC and valid LC_FUNCTION_STARTS."""
    blob=bytearray(12000)
    def seg(name,vm,off,size,sect=False):
        sections=b''
        if sect:
            sections=struct.pack('<16s16sQQIIIIIIII',b'__text'.ljust(16,b'\0'),
                     name.encode().ljust(16,b'\0'),vm,size,off,2,0,0,0x80000400,0,0,0)
        return struct.pack('<II16sQQQQiiII',LC_SEGMENT_64,72+len(sections),
                     name.encode().ljust(16,b'\0'),vm,size,off,size,7,5,int(sect),0)+sections
    a=seg('__TEXT',0x100000,0,512)
    b=seg('__TEXT_EXEC',0x100100,4096,128,True)
    c=seg('__LINKEDIT',0x200000,8192,128)
    starts=bytes([0x80,0x02,16,16,0]) # code starts at __TEXT+0x100, +16, +16
    lc=struct.pack('<IIII',V008_LC_FUNCTION_STARTS,16,8192,len(starts))
    h=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xc,4,len(a+b+c+lc),0,0)
    blob[:len(h+a+b+c+lc)]=h+a+b+c+lc
    blob[8192:8192+len(starts)]=starts
    # Three valid functions with 4 ARM64 instructions each; v2 changes one ALU instruction.
    words=[0x94000004,0xd503233f,0xd503201f,0xd65f03c0,
           0x94000004,0xd503201f,0x91000400 if version==1 else 0x91000800,0xd65f03c0,
           0xd503201f,0xd503201f,0xd503201f,0xd65f03c0]
    for i,w in enumerate(words):
        struct.pack_into('<I',blob,4096+4*i,w)
    image=_v009_scan_image(bytes(blob),'com.apple.AGXG11P',0,len(blob))
    assert image['status']=='macho_lido', image
    return bytes(blob), {'images':{'com.apple.AGXG11P':image},'format':'synthetic'}



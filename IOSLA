def _iosla_abi_self_test():
    """Testa Mach-O 64 com LC_SYMTAB, dyld exports trie, fileset e relatórios."""
    def symbol_macho(exports=(), imports=()):
        strings=b'\0'
        records=[]
        for name,is_import in [(x,False) for x in exports]+[(x,True) for x in imports]:
            off=len(strings)
            strings+=name.encode()+b'\0'
            records.append(struct.pack('<IBBHQ',off,1 if is_import else 0x0f,
                                       0 if is_import else 1,0,0))
        cmdsize=24
        symoff=32+cmdsize
        stroff=symoff+len(records)*16
        head=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,2,1,cmdsize,0,0)
        sym=struct.pack('<IIIIII',LC_SYMTAB_ABI,cmdsize,symoff,len(records),stroff,len(strings))
        return head+sym+b''.join(records)+strings
    a=_abi_parse_image(symbol_macho(['_funcA'],['_funcB']),0,'com.apple.a')
    b=_abi_parse_image(symbol_macho(['_funcB'],['_funcA']),0,'com.apple.b')
    assert a['exports']=={'_funcA'} and a['imports']=={'_funcB'}
    assert b['exports']=={'_funcB'} and b['imports']=={'_funcA'}
    header=struct.pack('<7I',0,28,28,32,1,1,0)
    chain=header+struct.pack('<I',0)+b'_chain_import\0'
    assert _abi_chained_imports(chain)=={'_chain_import'}
    wrapper=lambda path, k: {'path':path,'format':'Mach-O sintético','entries':1,'images_analyzed':1,
                          'invalid_images':0,'images_with_symbols':1,'images':{k:a if k=='com.apple.a' else b}}
    report=make_abi_report(wrapper('origem','com.apple.a'),wrapper('destino','com.apple.b'))
    assert report['summary']['source_imports_total_observed']==1
    assert report['summary']['source_imports_not_observed_total']==0
    assert report['summary']['full_abi_coverage'] is False
    with __import__('tempfile').TemporaryDirectory() as tmp:
        paths=save_abi_report(report,Path(tmp))
        assert all(x.exists() for x in paths)
    print('IOSLA v0.0.6: testes ABI aprovados (Mach-O sintético, sem conclusões de compatibilidade).')




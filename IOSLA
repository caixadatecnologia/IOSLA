def markdown_report(comparison):
    lines = [
        "# iOS Legacy Analyzer — Relatorio",
        "",
        f"Data: {comparison['date']}",
        "",
        "## Firmware original",
        "",
        f"- Arquivo: `{comparison['source']['filename']}`",
        f"- iOS: {comparison['source']['version']}",
        f"- Build: {comparison['source']['build']}",
        "",
        "## Firmware de destino",
        "",
        f"- Arquivo: `{comparison['target']['filename']}`",
        f"- iOS: {comparison['target']['version']}",
        f"- Build: {comparison['target']['build']}",
        "",
        "## Resumo",
        "",
    ]

    for status, count in comparison["summary"].items():
        lines.append(f"- {status}: {count}")

    lines.extend([
        "",
        "## Comparacao",
        "",
        "| Componente | Categoria | Estado |",
        "|---|---|---|",
    ])

    for component in comparison["components"]:
        name = component["name"].replace("|", "\\|")
        category = component["category"]
        status = component["status"]

        lines.append(
            f"| {name} | {category} | {status} |"
        )

    lines.extend([
        "",
        "## Detalhes dos caminhos",
        "",
    ])

    for component in comparison["components"]:
        lines.append(f"### {component['name']}")
        lines.append("")
        lines.append(f"Estado: {component['status']}")
        lines.append("")
        lines.append("Original:")

        for path in component["old_paths"]:
            lines.append(f"- `{path}`")

        if not component["old_paths"]:
            lines.append("- Nenhum")

        lines.append("")
        lines.append("Destino:")

        for path in component["new_paths"]:
            lines.append(f"- `{path}`")

        if not component["new_paths"]:
            lines.append("- Nenhum")

        lines.append("")

    lines.extend([
        "## Limitacoes",
        "",
        comparison["note"],
        "",
        "Este relatorio nao confirma compatibilidade "
        "de kernel ou de drivers.",
        "",
    ])

    return "\n".join(lines)


def export_reports():
    global last_comparison

    header()
    section("EXPORTAR RELATORIOS")

    comparison = run_comparison()

    if comparison is None:
        pause()
        return

    last_comparison = comparison

    print()
    print("Pasta de destino.")
    print("Pressione ENTER para usar ./relatorios")
    print()

    folder = input(
        C.CYAN + "Destino > " + C.RESET
    ).strip().strip("'\"")

    if not folder:
        folder = "relatorios"

    try:
        directory = Path(folder).expanduser().resolve()
        directory.mkdir(parents=True, exist_ok=True)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

        json_path = directory / (
            f"ios_legacy_{timestamp}.json"
        )

        md_path = directory / (
            f"ios_legacy_{timestamp}.md"
        )

        with open(
            json_path, "w", encoding="utf-8"
        ) as file:
            json.dump(
                comparison,
                file,
                ensure_ascii=False,
                indent=2
            )

        with open(
            md_path, "w", encoding="utf-8"
        ) as file:
            file.write(markdown_report(comparison))

        print()
        print_ok("Relatorios gerados.")

        print()
        print(" JSON:", json_path)
        print(" MD  :", md_path)

    except OSError as error:
        print_error(error)

    pause()


# ==============================================
# PROGRAMA PRINCIPAL
# ==============================================

def main():
    global source, target, last_comparison

    while True:

        header()
        menu()

        try:
            option = input(
                C.CYAN + "legacy@ios ~ % " + C.RESET
            ).strip()
        except (KeyboardInterrupt, EOFError):
            print()
            break

        if option == "1":
            header()

            result = select_ipsw("IPSW original")

            if result is not None:
                source = result
                last_comparison = None

            pause()

        elif option == "2":
            header()

            result = select_ipsw("IPSW de destino")

            if result is not None:
                target = result
                last_comparison = None

            pause()

        elif option == "3":
            show_information()

        elif option == "4":
            show_comparison()

        elif option == "5":
            analyze_drivers()

        elif option == "6":
            search_files()

        elif option == "7":
            export_reports()

        elif option == "0":
            break

        else:
            print_error("Comando desconhecido.")
            pause()

    print()
    print(C.CYAN + "Encerrando iOS Legacy Analyzer." + C.RESET)
    print()


if __name__ == "__main__":
    main()

def search_files():
    header()
    section("PESQUISA DE ARQUIVOS IPSW")

    if not source and not target:
        print_error("Nenhum IPSW selecionado.")
        pause()
        return

    print()
    keyword = input(
        C.CYAN + "Pesquisar > " + C.RESET
    ).strip().lower()

    if not keyword:
        print_warning("Digite um termo.")
        pause()
        return

    for label, info in (
        ("ORIGINAL", source),
        ("DESTINO", target),
    ):

        if info is None:
            continue

        results = [
            name for name in info["files"]
            if keyword in name.lower()
        ]

        section(f"{label} — {len(results)} RESULTADOS")

        for name in results[:100]:
            print(" ", shorten(name, 76))

        if len(results) > 100:
            print_warning(
                f"Mostrando 100 de {len(results)} resultados."
            )

    pause()



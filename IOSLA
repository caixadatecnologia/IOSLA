import bisect

V011_FOCUS = ('com.apple.AGXG11P','com.apple.AGXG12P',
              'com.apple.iokit.IOGPUFamily','com.apple.iokit.IOSurface',
              'com.apple.driver.AppleARMPlatform')
V011_TARGET_LIBRARIES = ('com.apple.iokit.IOGPUFamily','com.apple.iokit.IOSurface')
V011_MAX_FN_PER_IMAGE = 25000
V011_MAX_INSN_PER_FN = 1024
V011_MAX_REFS_PER_IMAGE = 25000
V011_MAX_TARGETS = 5000
V011_MAX_CANDIDATES = 4
V011_MAX_BLOB_BYTES = 32*1024*1024


def _v011_empty(name: str, status: str) -> dict:
    return {'identifier':name,'status':status,'functions':[], 'direct_calls':[],
            'limits':{'max_functions':V011_MAX_FN_PER_IMAGE,
                      'max_instructions_per_function':V011_MAX_INSN_PER_FN,
                      'max_stored_direct_calls':V011_MAX_REFS_PER_IMAGE},
            'coverage':{'starts_in_section':0,'functions_indexed':0,'calls_stored':0,
                        'functions_truncated':False,'references_truncated':False},
            'opcode_categories':{},'indirect_calls':0,'pac_instructions':0,'notes':[]}


def _v011_index_intervals(scan: dict) -> tuple[list[int],list[dict]]:
    regions=_v010_vm_index(scan)
    return [r['start'] for r in regions],regions


def _v011_find_region(addr: int, starts: list[int], regions: list[dict]) -> dict:
    i=bisect.bisect_right(starts,addr)-1
    # Both overlapping regions and non-overlapping are possible in malformed filesets;
    # don't silently pick one when the validated map overlaps.
    matches=[]
    for j in range(i, -1, -1):
        r=regions[j]
        if r['start']<=addr<r['end']:
            matches.append(r)
    if len(matches)==1:
        return {'state':'secao_executavel_unica','image':matches[0]['image'],
                'section':matches[0]['section']}
    if len(matches)>1:
        return {'state':'regioes_executaveis_sobrepostas','matches':len(matches)}
    return {'state':'destino_nao_mapeado'}


def _v011_examine_image(data: bytes, structural_scan:dict, name:str,
                        region_starts:list[int], regions:list[dict]) -> dict:
    img=structural_scan.get('images',{}).get(name)
    if not img:
        return _v011_empty(name,'imagem_nao_observada')
    if img.get('cpu_type')!=CPU_TYPE_ARM64:
        return _v011_empty(name,'arquitetura_nao_suportada')
    main=_v009_best_text(img)
    if not main:
        return _v011_empty(name,'secao_executavel_nao_mapeada')
    section_name,sec=main
    mapping=sec.get('file_mapping',{})
    if mapping.get('state')!='resolvido':
        return _v011_empty(name,'mapeamento_executavel_inconclusivo')
    base=sec.get('vmaddr')
    off,size=mapping.get('offset'),sec.get('size')
    if not isinstance(base,int) or not _v009_within(off,size,len(data)) or size>V011_MAX_BLOB_BYTES:
        return _v011_empty(name,'secao_nao_validada_ou_grande_demais')
    starts=_v010_function_offsets(data,img)
    if starts['state']!='limites_lidos':
        obj=_v011_empty(name,'limites_nao_disponiveis')
        obj['notes'].append(starts['state'])
        return obj
    selected=sorted(set(x for x in starts['vmaddrs'] if base<=x<base+size and (x-base)%4==0))
    if not selected:
        return _v011_empty(name,'nenhuma_funcao_na_secao')
    selected_len=len(selected)
    res=_v011_empty(name,'funcoes_e_chamadas_indexadas')
    res['section']=section_name
    res['section_vmaddr']=hex(base)
    res['section_size']=size
    histogram=Counter()
    calls=[]
    indirect=0
    capped_fn=0
    total_bl_calls=0
    for i,vm in enumerate(selected[:V011_MAX_FN_PER_IMAGE]):
        end=selected[i+1] if i+1<selected_len else base+size
        full_insn=max(0,(end-vm)//4)
        count=min(full_insn,V011_MAX_INSN_PER_FN)
        if count<=0:
            continue
        if full_insn>count:
            capped_fn+=1
        start=off+(vm-base)
        part=memoryview(data)[start:start+count*4]
        cats=[]
        cc=Counter()
        seen_bl=0
        seen_blr=0
        seen_pac=0
        direct_targets=[]
        for j in range(count):
            word=int.from_bytes(part[j*4:j*4+4], 'little')
            cat,target=_v010_classify(word,vm+j*4)
            cats.append(cat); cc[cat]+=1; histogram[cat]+=1
            if cat=='PAC':seen_pac+=1
            if cat=='BLR':seen_blr+=1
            if cat=='BL' and target is not None:
                seen_bl+=1
                total_bl_calls+=1
                hit=_v011_find_region(target,region_starts,regions)
                # Summarize all inspected instructions, store bounded references.
                if len(calls)<V011_MAX_REFS_PER_IMAGE:
                    call={'from_function':hex(vm),'site':hex(vm+j*4),'target_vmaddr':hex(target),**hit}
                    calls.append(call)
                if len(direct_targets)<32:
                    direct_targets.append(hit.get('image','nao_resolvido'))
        indirect+=seen_blr
        # A normalized sequence is heuristic; preserve SHA of raw bytes separately.
        classes='|'.join(cats)
        grams=sorted(set(a+'>'+b for a,b in zip(cats,cats[1:])))
        res['functions'].append({
            'vmaddr':hex(vm),'end_vmaddr':hex(end),'span_bytes':end-vm,
            'instructions_scanned':count,'truncated':full_insn>count,
            'raw_sha256':hashlib.sha256(part).hexdigest(),
            'opcode_sha256':hashlib.sha256(classes.encode()).hexdigest(),
            'opcode_histogram':dict(cc),'opcode_bigrams':grams[:80],
            'direct_calls_seen':seen_bl,'indirect_calls_seen':seen_blr,
            'pac_seen':seen_pac,'target_image_examples':direct_targets})
    cov=res['coverage']
    cov.update({'starts_in_section':selected_len,'functions_indexed':len(res['functions']),
          'functions_truncated':selected_len>V011_MAX_FN_PER_IMAGE,
          'functions_with_instruction_limit':capped_fn,
          'calls_stored':len(calls),
          'calls_observed_in_instructions':total_bl_calls,
          'references_truncated':total_bl_calls>V011_MAX_REFS_PER_IMAGE,
          'function_start_source':'LC_FUNCTION_STARTS'})
    res['direct_calls']=calls
    res['indirect_calls']=indirect
    res['pac_instructions']=histogram['PAC']
    res['opcode_categories']=dict(histogram)
    res['notes']=['BL aponta a uma região de código; não define tipo, nome nem protótipo.',
                  'BLR e acessos C++ indiretos não são resolvidos por este leitor limitado.',
                  'Funções maiores que o limite têm inspeção truncada e não são equivalência comprovada.']
    return res


def _v011_analyze_kernel(path:str|Path, structural:dict) -> dict:
    p=Path(path).expanduser().resolve()
    if p.stat().st_size>MAX_INPUT:
        raise KernelFormatError('Kernelcache maior que o limite permitido.')
    data,fmt,notes=_unwrap(p.read_bytes())
    if len(data)>MAX_DECODED:
        raise KernelFormatError('Kernelcache decodificado excede o limite.')
    region_starts,regions=_v011_index_intervals(structural)
    images={name:_v011_examine_image(data,structural,name,region_starts,regions)
            for name in V011_FOCUS}
    return {'format':fmt,'decoded_bytes':len(data),
            'images':images,'validated_executable_regions':len(regions),
            'parser_notes':notes}


def _v011_function_lookup(image:dict) -> tuple[list[int],list[dict]]:
    functions=image.get('functions',[])
    pairs=sorted((int(f['vmaddr'],16),f) for f in functions)
    return [x[0] for x in pairs],[x[1] for x in pairs]


def _v011_owning_function(addr:int,starts:list[int],functions:list[dict])->dict|None:
    i=bisect.bisect_right(starts,addr)-1
    if i<0:
        return None
    f=functions[i]
    return f if addr<int(f['end_vmaddr'],16) else None


def _v011_build_match_index(image:dict)->dict:
    functions=image.get('functions',[])
    by_raw={}; by_opcode={}; by_band={}
    for f in functions:
        by_raw.setdefault(f['raw_sha256'],[]).append(f)
        by_opcode.setdefault(f['opcode_sha256'],[]).append(f)
        by_band.setdefault(f['instructions_scanned']//8,[]).append(f)
    return {'raw':by_raw,'opcode':by_opcode,'bands':by_band,'n':len(functions)}


def _v011_match_function(f:dict|None,idx:dict|None)->dict:
    if f is None or idx is None or not idx.get('n'):
        return {'state':'dados_insuficientes','candidates':[]}
    n=f['instructions_scanned']
    if f.get('truncated') or n<8:
        return {'state':'funcao_curta_ou_truncada','candidates':[]}
    raw=idx['raw'].get(f['raw_sha256'],[])
    if len(raw)==1 and not raw[0].get('truncated'):
        return {'state':'bytes_identicos_unicos','candidates':[
            {'vmaddr':raw[0]['vmaddr'],'method':'bytes_identicos','score':1.0}]}
    if len(raw)>1:
        return {'state':'bytes_iguais_multiplos_candidatos','candidates':[
            {'vmaddr':g['vmaddr'],'method':'bytes_identicos','score':1.0}
            for g in raw[:V011_MAX_CANDIDATES]]}
    norm=idx['opcode'].get(f['opcode_sha256'],[])
    if n>=14 and len(norm)==1 and not norm[0].get('truncated') and len(f['opcode_histogram'])>=4:
        return {'state':'estrutura_candidata_unica','candidates':[
            {'vmaddr':norm[0]['vmaddr'],'method':'padrao_opcode','score':0.92}]}
    if len(norm)>1:
        return {'state':'padrao_ambiguo','candidates':[
            {'vmaddr':g['vmaddr'],'method':'padrao_opcode','score':0.90}
            for g in norm[:V011_MAX_CANDIDATES]]}
    # More selective than 0.0.10: use histogram overlap, length, and bigram overlap.
    half=max(4,int(n*.08)); selected=[]
    lower=max(0,(n-half)//8); upper=(n+half)//8
    for band in range(lower,upper+1):
        selected.extend(idx['bands'].get(band,[]))
    options=[]
    for g in selected[:1200]:
        m=g['instructions_scanned']
        if g.get('truncated') or m<10 or abs(n-m)>half:
            continue
        a,b=set(f['opcode_bigrams']),set(g['opcode_bigrams'])
        if len(a)<5 or len(b)<5:
            continue
        jacc=len(a&b)/max(1,len(a|b))
        h1,h2=f['opcode_histogram'],g['opcode_histogram']
        allcats=set(h1)|set(h2)
        hist=1-sum(abs(h1.get(k,0)/n-h2.get(k,0)/m) for k in allcats)/2
        score=.43*jacc+.32*hist+.25*(1-abs(n-m)/max(n,m))
        if score>=.88:
            options.append((score,g))
    options.sort(key=lambda t:(-t[0],t[1]['vmaddr']))
    if options and (len(options)==1 or options[0][0]-options[1][0]>=.08):
        return {'state':'estrutura_candidata_unica','candidates':[
            {'vmaddr':options[0][1]['vmaddr'],'method':'histograma_e_fluxo_aproximado',
             'score':round(options[0][0],3)}]}
    if options:
        return {'state':'estrutura_ambigua','candidates':[
            {'vmaddr':g['vmaddr'],'method':'histograma_e_fluxo_aproximado','score':round(s,3)}
            for s,g in options[:V011_MAX_CANDIDATES]]}
    return {'state':'sem_correspondencia_observada','candidates':[]}


def _v011_target_calls(results:dict)->tuple[list[dict],dict]:
    old=results.get('ORIGEM',{}).get('images',{}).get('com.apple.AGXG11P',{})
    libs=results.get('ORIGEM',{}).get('images',{})
    hits={}; skipped=Counter()
    bylib={lib:_v011_function_lookup(libs.get(lib,{})) for lib in V011_TARGET_LIBRARIES}
    calls=old.get('direct_calls',[])
    for call in calls:
        lib=call.get('image')
        if lib not in V011_TARGET_LIBRARIES or call.get('state')!='secao_executavel_unica':
            continue
        addr=int(call['target_vmaddr'],16)
        starts,funcs=bylib[lib]
        fn=_v011_owning_function(addr,starts,funcs)
        if fn is None:
            skipped['endereco_sem_funcao_verificada']+=1
            continue
        key=(lib,fn['vmaddr'])
        if key not in hits:
            hits[key]={'library':lib,'function_vmaddr':fn['vmaddr'],
                'call_count':0,'callers':set(),'examples':[], 'target_function':fn}
        row=hits[key]
        row['call_count']+=1
        row['callers'].add(call['from_function'])
        if len(row['examples'])<3:
            row['examples'].append({'site':call['site'],'destination':call['target_vmaddr']})
    ordered=sorted(hits.values(),key=lambda x:(-x['call_count'],x['library'],x['function_vmaddr']))
    cut=ordered[V011_MAX_TARGETS:]
    rows=[]
    for h in ordered[:V011_MAX_TARGETS]:
        rows.append({'library':h['library'],'function_vmaddr':h['function_vmaddr'],
           'call_count':h['call_count'],'unique_callers':len(h['callers']),
           'examples':h['examples'],'target_function':h['target_function']})
    stat={'source_direct_calls_stored':len(calls),
          'source_direct_calls_truncated':old.get('coverage',{}).get('references_truncated',False),
          'source_function_index_truncated':old.get('coverage',{}).get('functions_truncated',False),
          'targets_identified':len(ordered),'targets_reported':len(rows),
          'targets_omitted_by_limit':len(cut), 'nonfunction_destinations':dict(skipped),
          'calls_to_reported_targets':sum(x['call_count'] for x in rows)}
    return rows,stat


def _v011_continuity(results:dict)->tuple[dict,dict]:
    targets,stats=_v011_target_calls(results)
    lookup={}
    function_by_vm={}
    for label in ('CONTROLE','DESTINO'):
        for lib in V011_TARGET_LIBRARIES:
            img=results.get(label,{}).get('images',{}).get(lib,{})
            lookup[(label,lib)]=_v011_build_match_index(img)
            function_by_vm[(label,lib)]={f['vmaddr']:f for f in img.get('functions',[])}
    rows=[]
    states=Counter()
    for row in targets:
        lib=row['library']; f=row['target_function']
        ab=_v011_match_function(f,lookup.get(('CONTROLE',lib)))
        ac=_v011_match_function(f,lookup.get(('DESTINO',lib)))
        bc={'state':'nao_calculado','candidates':[]}
        if len(ab['candidates'])==1 and ab['state'] in ('bytes_identicos_unicos','estrutura_candidata_unica'):
            bm=function_by_vm[('CONTROLE',lib)].get(ab['candidates'][0]['vmaddr'])
            bc=_v011_match_function(bm,lookup.get(('DESTINO',lib)))
        chain_state='inconclusiva'
        if len(ab['candidates'])==1 and len(bc['candidates'])==1:
            chain_state='caminho_estrutural_candidato'
            if len(ac['candidates'])==1 and ac['candidates'][0]['vmaddr']!=bc['candidates'][0]['vmaddr']:
                chain_state='correspondentes_divergentes_ou_ambiguos'
        if ab['state']=='bytes_identicos_unicos' and bc['state']=='bytes_identicos_unicos':
            chain_state='bytes_conservados_nos_dois_passos'
        states[chain_state]+=1
        rows.append({'library':lib,'origin_target_function':row['function_vmaddr'],
            'calls_from_agxg11p':row['call_count'], 'origin_unique_callers':row['unique_callers'],
            'callsite_examples':row['examples'],
            'source_fingerprint':{'raw_sha256':f['raw_sha256'],
                                  'opcode_sha256':f['opcode_sha256'],
                                  'instructions_scanned':f['instructions_scanned'],
                                  'truncated':f['truncated']},
            'a_to_b':ab,'a_to_c':ac,'b_to_c':bc,'triangulation_state':chain_state,
            'abi_contract':'nao_demonstrado'})
    summary={**stats,'triangulation_states':dict(states),
             'reported_targets_by_library':dict(Counter(r['library'] for r in rows)),
             'with_unique_A_C_candidate':sum(len(r['a_to_c']['candidates'])==1 and
                 r['a_to_c']['state'] in ('bytes_identicos_unicos','estrutura_candidata_unica') for r in rows)}
    base={'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
          'mode':'rastreabilidade de alvos BL do AGXG11P e continuidade estrutural observacional',
          'summary':summary,'targets':rows,
          'limitations':['Comparações A↔B usam builds diferentes do iOS 18.',
             'Pares de funções são candidatos; bytes idênticos não demonstram contrato ABI.',
             'Chamadas BLR, vtables C++, protótipos e runtime permanecem não resolvidos.',
             'Nenhum código ou firmware é modificado, carregado ou executado.']}
    calls={'iosla_version':APP_VERSION,'generated_at':base['generated_at'],
       'mode':'resolução de chamadas BL por intervalo de funções LC_FUNCTION_STARTS',
       'summary':stats,
       'targets':[{'library':x['library'],'function_vmaddr':x['function_vmaddr'],
                   'calls':x['call_count'],'unique_callers':x['unique_callers'],
                   'examples':x['examples'],
                   'function_truncated':x['target_function']['truncated']} for x in targets],
       'limitations':['A resolução usa endereços em seções validadas e função com limite recuperado.',
                      'Não é uma lista de imports dinâmicos; funções internas/inlined não são inferidas.']}
    return calls,base


def _v011_cpp_research(results:dict)->dict:
    rows=[]
    for label,scan in results.items():
        for name,img in scan.get('images',{}).items():
            if img.get('status')!='funcoes_e_chamadas_indexadas':
                continue
            rows.append({'firmware':label,'driver':name,
               'indirect_blr_observed':img.get('indirect_calls',0),
               'pac_category_observed':img.get('pac_instructions',0),
               'functions_scanned':len(img.get('functions',[])),
               'functions_with_truncated_instructions':img.get('coverage',{}).get('functions_with_instruction_limit',0),
               'virtual_dispatch':'nao_identificado','cpp_layout':'nao_reconstruido'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'padrões ARM64e/indiretos: contagem observacional, não reconstrução C++',
       'summary':{'driver_firmware_pairs':len(rows),'indirect_call_sites':sum(r['indirect_blr_observed'] for r in rows),
           'pac_class_instructions':sum(r['pac_category_observed'] for r in rows)},
       'drivers':rows,'limitations':['BLR sem fluxo de dados não permite descobrir o alvo.',
           'A classe PAC deste leitor é parcial e não valida autenticação de ponteiros.',
           'Uma instrução não prova despacho virtual ou vtable específica.']}


def _v011_gpu_firmware(inputs:dict|None,snaps:dict|None)->dict:
    inputs=inputs or {}; snaps=snaps or {}
    rows=[]
    for label in ('ORIGEM','CONTROLE','DESTINO'):
        item=inputs.get(label)
        if not item:continue
        meta=item.get('meta',{})
        component=meta.get('component_paths',{})
        gpu={k:component.get(k,[]) for k in ('GFX','ANE','AOP','ISP')}
        kexts=snaps.get(label)
        gpuids={}
        if kexts is not None:
            for ident in ('com.apple.AGXG11P','com.apple.AGXG12P',
                          'com.apple.AGXFirmwareKextG11PRTBuddy',
                          'com.apple.AGXFirmwareKextG12PRTBuddy'):
                k=kexts.kexts.get(ident)
                if k:
                    gpuids[ident]=k.version
        rows.append({'firmware':label,'device':(snaps.get(label).device if snaps.get(label) else (meta.get('devices') or [None])[0]),
                     'ios_version':meta.get('ios_version'),'build':meta.get('build'),
                     'manifest_component_paths':gpu,'graphical_kext_versions':gpuids,
                     'firmware_payload_inspection':'nao_realizada'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
        'mode':'inventário manifestos de firmwares auxiliares e drivers gráficos',
        'firmwares':rows,'summary':{'firmwares_observed':len(rows)},
        'limitations':['Caminho do firmware não identifica uma API nem comprova compatibilidade.',
          'Payload binário GFX/AOP/ANE não é inspecionado; hashes e protocolos não são inferidos.',
          'Não modifica, extrai para execução ou carrega firmware.']}


def _v011_matrix(results:dict, calls:dict, continuity:dict, cpp:dict, fw:dict)->dict:
    rows=[]
    bylib=continuity['summary']['reported_targets_by_library']
    for lib in V011_TARGET_LIBRARIES:
        ls=[row for row in continuity.get('targets',[]) if row['library']==lib]
        rows.append({'driver':'com.apple.AGXG11P','dependency':lib,
          'direct_call_targets_verified':bylib.get(lib,0),
          'unique_candidate_recent':sum(len(x['a_to_c']['candidates'])==1 and
            x['a_to_c']['state'] in ('bytes_identicos_unicos','estrutura_candidata_unica') for x in ls),
          'ambiguous_or_unresolved':sum(x['a_to_c']['state'] not in
              ('bytes_identicos_unicos','estrutura_candidata_unica') for x in ls),
          'evidence':'chamadas_diretas_e_localizacao_em_intervalo_de_funcao',
          'abi_contract':'nao_demonstrado','runtime_iokit':'nao_verificado',
          'firmware_protocol':'nao_verificado','signing_and_boot':'fora_do_escopo'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'matriz observacional por biblioteca, sem probabilidade de port',
       'summary':{'libraries_examined':len(rows),'target_functions':sum(r['direct_call_targets_verified'] for r in rows),
                  'truncated_calls':calls['summary']['source_direct_calls_truncated']},
       'drivers':rows,'limitations':['Nenhum critério de ABI completa é satisfeito apenas com hashes ou chamadas diretas.',
          'Não se demonstra que as funções tenham argumentos/estruturas equivalentes.',
          'O sistema não executa ou instala drivers e não altera boot ou integridade.']}


def _v011_md(report:dict)->str:
    lines=[f'# IOSLA v{APP_VERSION} — {report.get("mode", "Pesquisa de interfaces")}','',
           '**Somente leitura. Compatibilidade ABI e inicialização não demonstradas.**','']
    if report.get('summary'):
        lines+=['## Cobertura e resultados','', '```json',
            json.dumps(report['summary'],indent=2,ensure_ascii=False),'```','']
    if 'targets' in report:
        lines+=['## Alvos de chamada','',
              '| Biblioteca | Função A | Chamadas | A↔B | B↔C | A↔C |','|---|---|---:|---|---|---|']
        for row in report['targets'][:125]:
            lib=row['library'].split('.')[-1]
            fun=row.get('origin_target_function') or row.get('function_vmaddr')
            lines.append('| `{}` | `{}` | {} | {} | {} | {} |'.format(
                lib,fun,row.get('calls_from_agxg11p',row.get('calls','-')),
                row.get('a_to_b',{}).get('state','-'),row.get('b_to_c',{}).get('state','-'),
                row.get('a_to_c',{}).get('state','-')))
        if len(report['targets'])>125:
            lines+=['',f'**Exibindo 125 de {len(report["targets"])} alvos; consultar JSON para a lista completa.**']
        lines+=['']
    if 'drivers' in report:
        lines+=['## Componentes investigados','']
        for row in report['drivers']:
            lines+=['### '+str(row.get('driver','Componente')),'','```json',
                    json.dumps(row,indent=2,ensure_ascii=False),'```','']
    if 'firmwares' in report:
        lines+=['## Inventário por firmware','']
        for row in report['firmwares']:
            lines+=['### '+str(row['firmware']),'','```json',
                    json.dumps(row,indent=2,ensure_ascii=False),'```','']
    if report.get('errors'):
        lines+=['## Erros de interpretação','',json.dumps(report['errors'],indent=2,ensure_ascii=False),'']
    lines+=['## Limitações','']+['- '+x for x in report.get('limitations',[])]+['']
    return '\n'.join(lines)


def _v011_generate(results:dict,inputs:dict|None=None,snaps:dict|None=None,errors:dict|None=None)->list[tuple[str,dict]]:
    calls,continuity=_v011_continuity(results)
    cpp=_v011_cpp_research(results)
    fw=_v011_gpu_firmware(inputs,snaps)
    matrix=_v011_matrix(results,calls,continuity,cpp,fw)
    if errors:
        for rep in (calls,continuity,cpp,fw,matrix):
            rep['errors']=errors
    return [('CALL_TARGETS',calls),('ABI_CONTINUITY',continuity),
            ('CPP_RESEARCH',cpp),('GPU_FIRMWARE',fw),('COMPATIBILITY_MATRIX',matrix)]


def _v011_lab(self, reuse:bool=False)->None:
    if reuse and getattr(self,'v011_results',None) is not None:
        results=self.v011_results; errors=self.v011_errors
    else:
        results={};errors={}
        structural=getattr(self,'v008_scans',{})
        if not structural:
            print(' [V11] Primeiro execute [3] para analisar os kernelcaches.')
            return
        for label in ('ORIGEM','CONTROLE','DESTINO'):
            snapshot=self.snapshots.get(label)
            if not snapshot or not snapshot.kernel_path or label not in structural:
                errors[label]='Firmware ou kernelcache não interpretável.'
                continue
            try:
                results[label]=_v011_analyze_kernel(snapshot.kernel_path,structural[label])
                summary={k:v['coverage'].get('functions_indexed',0) for k,v in results[label]['images'].items()}
                print('  [V11]',label,': funções indexadas',summary)
            except (KernelFormatError,OSError,ValueError,MemoryError,struct.error) as exc:
                errors[label]=str(exc)
                print('  [V11]',label,':',str(exc))
        self.v011_results=results;self.v011_errors=errors
    for label,report in _v011_generate(results,self.inputs,self.snapshots,errors):
        files=_v008_export(label,report,_v011_md)
        _v008_add_summary(self,'v011_'+label.lower(),files,report.get('summary',{}))
        print('  [V11] Relatório:',files[1].name)
    print('  [INFO] Apenas leitura; nenhuma correspondência comprova ABI, execução ou boot.')



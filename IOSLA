# ============================================================================
# IOSLA v0.0.8 — BINARY ABI 2.0 + OPTIONAL SAME-DEVICE FIRMWARE CONTROL
# All operations are offline, read-only, and do NOT patch firmware / boot devices.
# ============================================================================

V008_LIMIT_CMDS = 8192
V008_MAX_BLOB = 4 * 1024 * 1024
V008_MAX_FUNCS = 250_000
V008_LC_FUNCTION_STARTS = 0x26
V008_LC_DATA_IN_CODE = 0x29
V008_LC_CODE_SIGNATURE = 0x1d
V008_LC_DYLD_EXPORTS_TRIE = 0x80000033
V008_LC_DYLD_CHAINED_FIXUPS = 0x80000034


def _v008_str16(raw: bytes) -> str:
    return raw.partition(b'\x00')[0].decode('ascii', 'replace')


def _v008_offset_candidates(data: bytes, start: int, stop: int,
                            file_offset: int, size: int) -> dict:
    """Conservative fileset coordinate systems. Never silently pick ambiguous data."""
    result = {'state': 'fora_da_regiao', 'chosen_model': None, 'offset': None,
              'candidate_offsets': {}, 'hash_sha256': None}
    if size < 0 or size > V008_MAX_BLOB or file_offset < 0:
        result['state'] = 'limite_excedido'
        return result
    for model, point in (('fileset_absoluto', file_offset),
                         ('imagem_relativa', start + file_offset)):
        # Confine to selected fileset image to avoid hashing another image as this one.
        if start <= point <= stop and point + size <= stop and point + size <= len(data):
            result['candidate_offsets'][model] = point
    found = sorted(set(result['candidate_offsets'].values()))
    if not found:
        return result
    if len(found) > 1:
        result['state'] = 'offset_ambiguo'
        return result
    point = found[0]
    result.update({'state': 'resolvido', 'offset': point,
                   'chosen_model': ','.join(result['candidate_offsets']),
                   'hash_sha256': hashlib.sha256(memoryview(data)[point:point + size]).hexdigest()})
    return result


def _v008_parse_starts(buf: bytes) -> dict:
    """LC_FUNCTION_STARTS stores ULEB deltas; this does not identify function ABI."""
    position, cursor, count = 0, 0, 0
    first, last, terminated = None, None, False
    try:
        while position < len(buf) and count < V008_MAX_FUNCS:
            delta, position = _abi_uleb(buf, position, len(buf))
            if delta == 0:
                terminated = True
                break
            cursor += delta
            if cursor > (1 << 63):
                return {'state': 'delta_excessivo', 'count': count}
            if first is None:
                first = cursor
            last = cursor
            count += 1
        status = 'delimitado' if terminated else ('limite_excedido' if count == V008_MAX_FUNCS else 'sem_terminador')
        return {'state': status, 'count': count, 'first_delta_address': first,
                'last_delta_address': last,
                'note': 'Offsets delta relativos ao texto conforme Mach-O; não demonstram assinatura, protótipo ou ABI de funções.'}
    except (ValueError, OverflowError, IndexError, struct.error):
        return {'state': 'uleb_invalido', 'count': count}


def _v008_scan_image(data: bytes, name: str, start: int, stop: int) -> dict:
    row = {'identifier': name, 'image_offset': start, 'image_region_end': stop,
           'status': 'indisponivel', 'mappings': {}, 'sections': {},
           'load_commands': {}, 'notes': [], 'function_starts': {'state': 'comando_ausente'},
           'binary_abi_proven': False}
    if not (0 <= start < stop <= len(data)) or stop - start < 32:
        row['notes'].append('Região de imagem fora dos limites.')
        return row
    magic = data[start:start + 4]
    if magic not in (MH_MAGIC_64, MH_CIGAM_64):
        row['notes'].append('Assinatura Mach-O não encontrada.')
        return row
    endian = '<' if magic == MH_MAGIC_64 else '>'
    try:
        header = struct.unpack_from(endian + 'IiiIIIII', data, start)
    except struct.error:
        return row
    num_cmd, cmd_bytes = header[4], header[5]
    row['cpu_type'] = header[1]
    row['cpu_subtype'] = header[2]
    row['macho_filetype'] = header[3]
    if num_cmd > V008_LIMIT_CMDS or cmd_bytes > stop - start - 32:
        row['status'] = 'load_commands_invalidos'
        return row
    pos, endcmd = start + 32, start + 32 + cmd_bytes
    pending_sections = []
    pending_link_data = []
    for _ in range(num_cmd):
        if pos + 8 > endcmd:
            row['status'] = 'load_commands_truncados'
            return row
        cmd, size = struct.unpack_from(endian + 'II', data, pos)
        if size < 8 or pos + size > endcmd:
            row['status'] = 'load_commands_invalidos'
            return row
        if cmd == LC_SEGMENT_64:
            if size < 72:
                row['status'] = 'segmento_invalido'
                return row
            segname = _v008_str16(data[pos+8:pos+24])
            vmaddr, vmsize, fileoff, filesize = struct.unpack_from(endian + 'QQQQ', data, pos+24)
            nsects = struct.unpack_from(endian + 'I', data, pos+64)[0]
            if nsects > 8192 or 72 + nsects * 80 > size:
                row['status'] = 'secoes_invalidas'
                return row
            row['mappings'][segname] = {'vmaddr': vmaddr, 'vmsize': vmsize,
                                        'fileoff': fileoff, 'filesize': filesize,
                                        'file_mapping': _v008_offset_candidates(data, start, stop, fileoff, filesize)
                                        if filesize else {'state': 'sem_dados'}}
            for j in range(nsects):
                sectpos = pos + 72 + 80 * j
                sectname = _v008_str16(data[sectpos:sectpos+16])
                sectionsegment = _v008_str16(data[sectpos+16:sectpos+32])
                address, length = struct.unpack_from(endian + 'QQ', data, sectpos+32)
                file_offset = struct.unpack_from(endian + 'I', data, sectpos+48)[0]
                flags = struct.unpack_from(endian + 'I', data, sectpos+64)[0]
                if sectname in ('__text', '__unwind_info', '__eh_frame', '__const', '__cstring'):
                    pending_sections.append((sectionsegment + ',' + sectname, file_offset, length, address, flags))
        elif cmd in (V008_LC_FUNCTION_STARTS, V008_LC_DATA_IN_CODE,
                     V008_LC_DYLD_CHAINED_FIXUPS, V008_LC_DYLD_EXPORTS_TRIE, V008_LC_CODE_SIGNATURE):
            if size >= 16:
                off, count = struct.unpack_from(endian + 'II', data, pos+8)
                key = {V008_LC_FUNCTION_STARTS: 'LC_FUNCTION_STARTS',
                       V008_LC_DATA_IN_CODE: 'LC_DATA_IN_CODE',
                       V008_LC_DYLD_CHAINED_FIXUPS: 'LC_DYLD_CHAINED_FIXUPS',
                       V008_LC_DYLD_EXPORTS_TRIE: 'LC_DYLD_EXPORTS_TRIE',
                       V008_LC_CODE_SIGNATURE: 'LC_CODE_SIGNATURE'}[cmd]
                pending_link_data.append((key, off, count))
        pos += size
    row['status'] = 'macho_lido'
    for key, off, length, addr, flags in pending_sections:
        m = _v008_offset_candidates(data, start, stop, off, length)
        row['sections'][key] = {'size': length, 'vmaddr': addr, 'flags': flags,
                                'file_mapping': m}
    for key, off, length in pending_link_data:
        mapping = _v008_offset_candidates(data, start, stop, off, length)
        row['load_commands'][key] = {'data_size': length, 'file_mapping': mapping}
        if key == 'LC_FUNCTION_STARTS':
            row['function_starts'] = {'state': mapping['state'], 'data_size': length}
            if mapping['state'] == 'resolvido':
                start_at = mapping['offset']
                row['function_starts'] = {**_v008_parse_starts(data[start_at:start_at+length]),
                                          'data_size': length,
                                          'mapping': mapping['chosen_model']}
    row['notes'].append('Hashes de seções são fingerprints exatos de bytes, não prova de equivalência ABI.')
    if not row['sections'].get('__TEXT,__text'):
        row['notes'].append('Nenhuma seção __TEXT,__text observada nos comandos desta imagem.')
    return row


def _v008_scan_decoded(data: bytes, description: str) -> dict:
    entries, _ = _read_macho(data)
    by_offset = {0: 'com.apple.kernel'}
    for item in entries:
        pos = item.get('offset')
        if isinstance(pos, int) and pos > 0 and pos < len(data) and pos not in by_offset:
            by_offset[pos] = str(item.get('name', 'unknown'))
    sorted_offsets = sorted(by_offset)
    if len(sorted_offsets) > ABI_MAX_IMAGES:
        raise KernelFormatError('Excesso de imagens Mach-O para análise ABI 2.0.')
    images = {}
    for idx, pos in enumerate(sorted_offsets):
        limit = sorted_offsets[idx + 1] if idx + 1 < len(sorted_offsets) else len(data)
        name = by_offset[pos]
        images[name] = _v008_scan_image(data, name, pos, limit)
    return {'format': description, 'decoded_bytes': len(data),
            'images_analyzed': len(images),
            'images': images,
            'limits': {'max_blob_bytes': V008_MAX_BLOB, 'per_image_commands': V008_LIMIT_CMDS},
            'warnings': ['Offsets ambiguos nunca são escolhidos por heurística.',
                         'Hash igual não é prova de compatibilidade ABI ou de assinatura do kernel.']}


def _v008_scan_kernel(path: str | Path) -> dict:
    p = Path(path).expanduser().resolve()
    if p.stat().st_size > MAX_INPUT:
        raise KernelFormatError('Arquivo maior que o limite máximo permitido.')
    decoded, description, notes = _unwrap(p.read_bytes())
    result = _v008_scan_decoded(decoded, description)
    result['path'] = str(p)
    result['parser_notes'] = notes
    return result


def _v008_section_outcome(before: dict | None, after: dict | None) -> dict:
    if before is None or after is None:
        return {'state': 'imagem_nao_observada_em_ambos'}
    a = before.get('sections', {}).get('__TEXT,__text')
    b = after.get('sections', {}).get('__TEXT,__text')
    if not a or not b:
        return {'state': 'secao_text_nao_observada_em_ambos'}
    fa, fb = a['file_mapping'], b['file_mapping']
    if fa.get('state') != 'resolvido' or fb.get('state') != 'resolvido':
        return {'state': 'mapeamento_de_secoes_inconclusivo',
                'origem': fa['state'], 'destino': fb['state']}
    return {'state': 'bytes_iguais' if fa['hash_sha256'] == fb['hash_sha256'] and a['size'] == b['size'] else 'bytes_diferentes',
            'origin_sha256': fa['hash_sha256'], 'target_sha256': fb['hash_sha256'],
            'origin_size': a['size'], 'target_size': b['size'],
            'interpretation': 'Igualdade ou diferença de bytes não equivale a ABI compatível/incompatível.'}


def make_abi_delta_v008(scans: dict[str, dict]) -> dict:
    a = scans.get('ORIGEM', {}).get('images', {})
    b = scans.get('DESTINO', {}).get('images', {})
    pairs = []
    for name in sorted(set(a) | set(b)):
        old, new = a.get(name), b.get(name)
        control = scans.get('CONTROLE', {}).get('images', {}).get(name)
        pairs.append({'identifier': name,
                      'control': {'status': control.get('status'),
                                  'function_starts': control['function_starts']} if control else None,
                      'origin_vs_control': _v008_section_outcome(old, control) if scans.get('CONTROLE') else None,
                      'control_vs_target': _v008_section_outcome(control, new) if scans.get('CONTROLE') else None,
                      'origin': {'status': old.get('status'), 'function_starts': old['function_starts'],
                                 'text_mapping': old.get('sections', {}).get('__TEXT,__text',{}).get('file_mapping',{}).get('state')}
                                 if old else None,
                      'target': {'status': new.get('status'), 'function_starts': new['function_starts'],
                                 'text_mapping': new.get('sections', {}).get('__TEXT,__text',{}).get('file_mapping',{}).get('state')}
                                 if new else None,
                      'text_comparison': _v008_section_outcome(old, new)})
    types = Counter(x['text_comparison']['state'] for x in pairs)
    control_types_ab = Counter(x['origin_vs_control']['state'] for x in pairs) if scans.get('CONTROLE') else {}
    control_types_bc = Counter(x['control_vs_target']['state'] for x in pairs) if scans.get('CONTROLE') else {}
    return {'iosla_version': APP_VERSION, 'mode': 'Mach-O ABI 2.0: fingerprint estrutural, sem inferência de compatibilidade',
            'generated_at': datetime.now(timezone.utc).isoformat(),
            'summary': {'images_compared': len(pairs), 'states': dict(types),
                        'origin_images': len(a), 'target_images': len(b),
                        'control_images': len(scans.get('CONTROLE', {}).get('images', {})),
                        'origin_vs_control_states': dict(control_types_ab),
                        'control_vs_target_states': dict(control_types_bc)},
            'scans': {label: {'path': row.get('path'), 'format': row.get('format'),
                              'images_analyzed': row.get('images_analyzed'), 'parser_notes': row.get('parser_notes', [])}
                      for label, row in scans.items()},
            'images': pairs,
            'warnings': ['__text é comparada por hash apenas quando offsets são resolvidos sem ambiguidade.',
                         'LC_FUNCTION_STARTS não fornece protótipos; zero símbolos não prova compatibilidade.',
                         'O analisador não reconstitui uma KEXT carregável, nem verifica PAC, vtables ou assinatura.']}


def _v008_markdown_abi(report: dict) -> str:
    s = report['summary']
    lines = ['# IOSLA v0.0.8 — Binary ABI Analyzer 2.0', '',
             '**Somente leitura. Nenhuma compatibilidade ABI foi demonstrada.**', '',
             f"- Imagens comparadas: **{s['images_compared']}**",
             f"- Imagens origem/destino: {s['origin_images']} / {s['target_images']}", '',
             '## Estados observados', '']
    lines.extend(f'- {label}: **{count}**' for label,count in sorted(s['states'].items()))
    if s['control_images']:
        lines.extend(['','## Comparação ABI com controle opcional', '',
                      '- Imagens do controle: **'+str(s['control_images'])+'**',
                      '- A↔B (XS ↔ iPhone 11 antigo): '+str(s['origin_vs_control_states']),
                      '- B↔C (iPhone 11 antigo ↔ recente): '+str(s['control_vs_target_states'])])
    lines.extend(['', '## Componentes prioritários', '',
                  '| Driver | Comparação de __text | Function starts (origem/destino) |',
                  '|---|---|---|'])
    focus = {'com.apple.AGXG11P','com.apple.AGXG12P','com.apple.driver.AppleT8020',
             'com.apple.iokit.IOGPUFamily','com.apple.iokit.IOSurface',
             'com.apple.driver.AppleARMPlatform','com.apple.kernel'}
    for item in report['images']:
        if item['identifier'] in focus:
            p,q=item['origin'],item['target']
            va = str(p['function_starts'].get('count','?')) if p else 'n/d'
            vb = str(q['function_starts'].get('count','?')) if q else 'n/d'
            lines.append(f"| `{item['identifier']}` | {item['text_comparison']['state']} | {va} / {vb} |")
    lines.extend(['','## Limitações', '']+['- '+w for w in report['warnings']])
    return '\n'.join(lines)+'\n'


def _v008_sign(k: Kext | None) -> tuple | None:
    if k is None:
        return None
    return (k.version, tuple(sorted(k.dependencies.items())),
            k.region_sha256 or '', tuple(sorted(k.personalities)))


def _v008_triage_state(a: Kext | None,b: Kext | None) -> str:
    if a is None and b is None:
        return 'ausentes_ambos_inventarios'
    if a is None:
        return 'nao_observada_a_origem'
    if b is None:
        return 'nao_observada_o_destino'
    if _v008_sign(a)==_v008_sign(b):
        return 'metadados_iguais_no_inventario'
    return 'metadados_diferentes_no_inventario'


def make_triangulation_v008(snaps: dict[str, Snapshot], inputs: dict | None = None) -> dict:
    a,b,c=(snaps.get(x) for x in ('ORIGEM','CONTROLE','DESTINO'))
    warnings=[]
    if a is None or b is None or c is None:
        warnings.append('São necessários três inventários interpretáveis. Controle pode ser carregado depois.')
    valid_a12_vs_a13 = bool(a and b and a.ios_version==b.ios_version and a.build==b.build)
    same_device = bool(b and c and b.device==c.device and b.device=='iPhone12,1')
    if b and a and not valid_a12_vs_a13:
        warnings.append('Controle e XS diferem em versão/build: A↔B não isola hardware; não atribuir causalidade.')
    if b and c and not same_device:
        warnings.append('Controle e destino não são do mesmo modelo: B↔C não controla o hardware.')
    comparisons=[]
    if a and b and c:
        for name in sorted(set(a.kexts)|set(b.kexts)|set(c.kexts)):
            k1,k2,k3=(row.kexts.get(name) for row in (a,b,c))
            ab,bc,ac=(_v008_triage_state(*two) for two in ((k1,k2),(k2,k3),(k1,k3)))
            if not valid_a12_vs_a13 or not same_device:
                pattern='controle_nao_comparavel'
            elif any(x is None for x in (k1,k2,k3)):
                pattern='inventario_parcial_ou_nao_observada'
            elif ab=='metadados_diferentes_no_inventario' and bc=='metadados_iguais_no_inventario':
                pattern='diferenca_observada_entre_aparelhos_mesma_build'
            elif ab=='metadados_iguais_no_inventario' and bc=='metadados_diferentes_no_inventario':
                pattern='diferenca_observada_entre_versoes_mesmo_aparelho'
            elif ab=='metadados_diferentes_no_inventario' and bc=='metadados_diferentes_no_inventario':
                pattern='diferencas_nas_duas_comparacoes'
            else:
                pattern='sem_diferencas_nos_metadados_observados'
            comparisons.append({'identifier':name,'xs_vs_control':ab,'control_vs_recent':bc,
                                'xs_vs_recent':ac,'pattern':pattern,
                                'versions':{'XS':k1.version if k1 else None,
                                            'CONTROL':k2.version if k2 else None,
                                            'RECENT':k3.version if k3 else None}})
    grouped=Counter(row['pattern'] for row in comparisons)
    return {'iosla_version':APP_VERSION, 'generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'triangulação de inventários; sem inferência causal automática',
            'control_available':b is not None,
            'conditions': {'xs_and_control_same_version_and_build':valid_a12_vs_a13,
                           'control_and_recent_same_model':same_device},
            'firmwares':{label:{'device':s.device,'version':s.ios_version,'build':s.build,
                                 'kexts':len(s.kexts)} if s else None
                        for label,s in (('ORIGEM',a),('CONTROLE',b),('DESTINO',c))},
            'summary':{'compared_identifiers':len(comparisons),'patterns':dict(grouped)},
            'comparison':comparisons, 'warnings':warnings+[
              'Classificação é observação de metadados; hashes de fileset podem mudar por layout.',
              'Inventários parciais: não observado NÃO equivale a ausente do sistema.',
              'Mesmo modelo e build reduzem variáveis, mas não comprovam a causa das diferenças.']}


def _v008_triangulation_md(report: dict) -> str:
    rows=['# IOSLA v0.0.8 — Firmware Triangulation','',
          '**Comparação observacional de 3 firmwares. Nenhum port comprovado.**','',
          '## Firmware A / B / C','']
    for label,inf in report['firmwares'].items():
        rows.append(f"- {label}: " + (f"{inf['device']} · iOS {inf['version']} · build {inf['build']} · {inf['kexts']} KEXTs" if inf else 'não fornecido'))
    rows.extend(['','## Condições de comparabilidade','',
                 f"- XS e controle mesma versão/build: {report['conditions']['xs_and_control_same_version_and_build']}",
                 f"- Controle e destino mesmo modelo: {report['conditions']['control_and_recent_same_model']}",
                 '', '## Padrões observados', ''])
    rows.extend('- '+key+': **'+str(val)+'**' for key,val in sorted(report['summary']['patterns'].items()))
    rows.extend(['','## Drivers de interesse', '', '| Driver | A↔B | B↔C | Padrão |', '|---|---|---|---|'])
    patterns=('AGX','T8020','IOGPU','IOSurface','AppleARMPlatform','ANE')
    for item in report['comparison']:
        if any(x.casefold() in item['identifier'].casefold() for x in patterns):
            rows.append(f"| `{item['identifier']}` | {item['xs_vs_control']} | {item['control_vs_recent']} | {item['pattern']} |")
    rows.extend(['','## Avisos','']+['- '+w for w in report['warnings']])
    return '\n'.join(rows)+'\n'


def make_deep_driver_v008(driver: str, snaps: dict[str, Snapshot], scans: dict[str,dict],
                           port: dict | None = None) -> dict:
    a=snaps.get('ORIGEM'); b=snaps.get('DESTINO')
    row=(a.kexts.get(driver) if a else None)
    if row is None:
        raise IOSLAError('KEXT não encontrada no inventário da origem: '+driver)
    old_img=scans.get('ORIGEM',{}).get('images',{}).get(driver)
    target_candidates=[driver]
    for item in (port or {}).get('drivers',[]):
        if item.get('identifier')==driver:
            target_candidates += [cand['identifier'] for cand in item.get('newer_driver_candidate_on_original_board',[])]
            port_entry=item
            break
    else:
        port_entry=None
    target_candidates=list(dict.fromkeys(target_candidates))
    dest_images=scans.get('DESTINO',{}).get('images',{})
    target_img=[{'identifier':name, 'image':dest_images.get(name),
                 'fingerprint_comparison':_v008_section_outcome(old_img,dest_images.get(name))}
                for name in target_candidates if name in dest_images]
    missing=[name for name in row.dependencies if not b or name not in b.kexts]
    present=[{'identifier':name,'requested_version':version,
              'reported_target_version':b.kexts[name].version} for name,version in sorted(row.dependencies.items())
              if b and name in b.kexts]
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
            'driver':driver,'source_version':row.version, 'source_image':old_img,
            'target_candidate_images':target_img,
            'dependencies':{'total':len(row.dependencies),'nominally_observed_in_target':present,
                            'not_observed_in_target_inventory':missing},
            'matching_rules':row.personality_matching,
            'portability_evidence':port_entry,
            'readiness':{'binary_abi':'nao_demonstrada', 'iokit_runtime':'nao_verificado',
                         'firmware_microcontrollers':'nao_verificado',
                         'secure_boot_signature':'nao_verificado'},
            'notes':['O nome e a versão de uma dependência não demonstram sua ABI.',
                     'Function starts e hashes são dados de estrutura, não protótipos ou símbolos.',
                     'Nenhum arquivo de KEXT é construído, modificado ou carregado.']}


def _v008_deep_md(d:dict)->str:
    abi=d['source_image'] or {}
    lines=[f"# IOSLA v0.0.8 — Driver Deep Inspection: `{d['driver']}`",'',
           '**Estudo estático somente leitura — sem comprovação de port.**','',
           f"- Versão declarada: {d['source_version']}",
           f"- Dependências: {d['dependencies']['total']}",
           f"- Encontradas nominalmente no destino: {len(d['dependencies']['nominally_observed_in_target'])}",
           f"- Não observadas: {len(d['dependencies']['not_observed_in_target_inventory'])}",
           f"- Mach-O da origem: {abi.get('status','não analisado')}",
           f"- LC_FUNCTION_STARTS: {abi.get('function_starts',{}).get('state','não examinado')}",
           '', '## Dependências não observadas','']
    lines += ['- `'+x+'`' for x in d['dependencies']['not_observed_in_target_inventory']] or ['- Nenhuma no inventário parcial.']
    lines+=['','## Candidatos de kernel recente (assinatura __text)','']
    for x in d['target_candidate_images']:
        lines.append('- `'+x['identifier']+'`: '+x['fingerprint_comparison']['state'])
    if not d['target_candidate_images']:
        lines.append('- Nenhum candidato examinado com ABI 2.0.')
    lines+=['','## Lacunas ainda abertas','']
    lines += ['- '+k+': '+v for k,v in d['readiness'].items()]
    lines+=['','## Observações','']+['- '+n for n in d['notes']]
    return '\n'.join(lines)+'\n'


def _v008_export(prefix:str, report:dict, fmt, directory:Path=REPORT_ROOT)->tuple[Path,Path]:
    directory.mkdir(parents=True,exist_ok=True)
    stamp=datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    jp=directory/f'IOSLA_{prefix}_{stamp}.json'
    md=directory/f'IOSLA_{prefix}_{stamp}.md'
    jp.write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf-8')
    md.write_text(fmt(report),encoding='utf-8')
    return jp,md


_v008_previous_analyze = Terminal.analyze


def _v008_add_summary(self, key: str, files:tuple[Path,Path], detail:dict) -> None:
    self.generated.extend(files)
    if self.last_summary is None:
        return
    self.last_summary[key]=detail
    self.last_summary['iosla_version']=APP_VERSION
    self.last_summary.setdefault('files',[]).extend(str(p) for p in files)
    for f in self.generated:
        if f.name.startswith('IOSLA_RESUMO_') and f.suffix=='.json':
            f.write_text(json.dumps(self.last_summary,indent=2,ensure_ascii=False),encoding='utf-8')
        elif f.name.startswith('IOSLA_RESUMO_') and f.suffix=='.md':
            with f.open('a',encoding='utf-8') as output:
                output.write('\n## '+key.replace('_',' ').title()+' (v0.0.8)\n\n')
                output.write('- Relatório: `'+files[1].name+'`\n')


def _v008_analyze(self):
    _v008_previous_analyze(self)
    self.v008_scans={}
    self.v008_port=_v006_find_json(self.generated,'IOSLA_PORTABILIDADE_')
    print('\n  [ABI2] Analisando a estrutura dos Mach-O fileset...')
    for label in ('ORIGEM','DESTINO'):
        snapshot=self.snapshots.get(label)
        if not snapshot or not snapshot.kernel_path:
            print('  [ABI2]',label,'sem kernel interpretável; resultado parcial.')
            continue
        try:
            self.v008_scans[label]=_v008_scan_kernel(snapshot.kernel_path)
            print('  [ABI2]',label,':',self.v008_scans[label]['images_analyzed'],'imagens.')
        except (KernelFormatError,OSError,ValueError,MemoryError,struct.error) as exc:
            print('  [ABI2]',label,': não interpretado —',str(exc))
    if 'CONTROLE' in self.inputs:
        print('\n  [CTRL] Lendo IPSW de controle opcional...')
        control,diag=self._snapshot('CONTROLE')
        self.generated.append(write_diagnostic('controle_ultima_analise',diag))
        if control:
            self.snapshots['CONTROLE']=control
            print('  [CTRL] KEXTs:',len(control.kexts),'· iOS',control.ios_version)
            try:
                self.v008_scans['CONTROLE']=_v008_scan_kernel(control.kernel_path)
                print('  [ABI2] CONTROLE:',self.v008_scans['CONTROLE']['images_analyzed'],'imagens.')
            except (KernelFormatError,OSError,ValueError,MemoryError,struct.error) as exc:
                print('  [ABI2] Controle não interpretável:',str(exc))
        else:
            print('  [CTRL] Não foi possível interpretar kernelcache; triangulação parcial.')
    delta=make_abi_delta_v008(self.v008_scans)
    files=_v008_export('ABI_DELTA',delta,_v008_markdown_abi)
    _v008_add_summary(self,'abi_2_analysis',files,delta['summary'])
    print('  [ABI2] Relatório:',files[1].name)
    tri=make_triangulation_v008(self.snapshots,self.inputs)
    control_files=_v008_export('TRIANGULACAO',tri,_v008_triangulation_md)
    _v008_add_summary(self,'firmware_triangulation',control_files,{
        'conditions':tri['conditions'],'summary':tri['summary'],'control_available':tri['control_available']})
    print('  [TRI] Relatório:',control_files[1].name, '(controle opcional).')
    if self.snapshots.get('ORIGEM') and 'com.apple.AGXG11P' in self.snapshots['ORIGEM'].kexts:
        deep=make_deep_driver_v008('com.apple.AGXG11P',self.snapshots,self.v008_scans,self.v008_port)

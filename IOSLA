            l.append('  - Motivo: '+entry['error'])
    d=report['comparison']
    l.extend(['','## Resumo','',
              f"- Nós origem: {d['origin_node_count']}",f"- Nós destino: {d['target_node_count']}",
              f"- Caminhos em ambos: {d['common_paths']}",
              f"- Apenas origem: {len(d['paths_only_origin'])}",
              f"- Apenas destino: {len(d['paths_only_target'])}",
              f"- Caminhos com propriedades diferentes: {len(d['changed_properties'])}",
              f"- Identificadores compatible compartilhados: {len(d['shared_compatibles'])}",
              '','## Exemplos de diferenças (amostra limitada)',''])
    for name,arr in [('Somente origem',d['paths_only_origin']),('Somente destino',d['paths_only_target']),
                     ('Compatible somente origem',d['compatibles_only_origin']),
                     ('Compatible somente destino',d['compatibles_only_target'])]:
        l.append('### '+name)
        l.extend('- `'+str(item).replace('`','')+'`' for item in arr[:30])
        if not arr:
            l.append('- Nenhum identificado')
    l.extend(['','## Interpretação','',d['assessment'],
              'Não substitua o DeviceTree de um aparelho pelo de outro. Não é um patch nem teste de boot.',''])
    return '\n'.join(l)


def investigate_devicetrees(inputs:dict, output:Path, tree_root:Path)->tuple[dict,tuple[Path,Path]]:
    sources={}
    trees={}
    for label,device in (('ORIGEM','iPhone11,2'),('DESTINO','iPhone12,1')):
        item=inputs.get(label)
        row={'device':device,'board':DT_BOARD_BY_DEVICE[device], 'status':'não analisado'}
        try:
            if not item:
                raise DeviceTreeFormatError('IPSW não carregado.')
            saved,internal=extract_local_devicetree(item['path'],device,tree_root/label.lower())
            row.update({'path':str(saved),'ipsw_entry':internal})
            parsed=parse_apple_devicetree(saved.read_bytes())
            row.update({'status':'analisado parcialmente','format':parsed['format'],
                        'node_count':parsed['node_count']})
            trees[label]=parsed
        except (DeviceTreeFormatError,KernelFormatError,ValueError,OSError,zipfile.BadZipFile,KeyError) as exc:
            row.update({'status':'não interpretado','error':str(exc)})
        sources[label]=row
    compare=compare_devicetrees(trees.get('ORIGEM'),trees.get('DESTINO'))
    report={'iosla_version':'0.0.6','generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'análise DeviceTree estática somente leitura','sources':sources,
            'comparison':compare,'coverage':'parcial' if len(trees)==2 else 'insuficiente',
            'limitations':['Placas diferentes (A12/A13): não confundir caminhos diferentes com suporte removido.',
                           'Propriedades com mesmo nome não provam ABI ou correspondência de dispositivos.',
                           'Não inclui dados dinâmicos do aparelho e não modifica firmware.']}
    output.mkdir(parents=True,exist_ok=True)
    stamp=datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    jp=output/f'IOSLA_DEVICETREE_{stamp}.json'
    md=output/f'IOSLA_DEVICETREE_{stamp}.md'
    jp.write_text(json.dumps(report,indent=2,ensure_ascii=False),encoding='utf8')
    md.write_text(devicetree_markdown(report),encoding='utf8')
    return report,(jp,md)



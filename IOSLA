def _v012_abi_evidence(results:dict,contextual:dict)->dict:
    origin=results.get('ORIGEM',{}).get('images',{});dest=results.get('DESTINO',{}).get('images',{})
    bysrc={lib:{x['vmaddr']:x for x in origin.get(lib,{}).get('functions',[])} for lib in V011_TARGET_LIBRARIES}
    bydst={lib:{x['vmaddr']:x for x in dest.get(lib,{}).get('functions',[])} for lib in V011_TARGET_LIBRARIES}
    rows=[];stats=Counter()
    for row in contextual.get('targets',[]):
        lib=row['library'];source=bysrc[lib].get(row['function_origin']); baseline=row['baseline_A_C']; contextual_match=row['contextual_A_C']
        chosen=None;method=None
        if baseline.get('state') in ('bytes_identicos_unicos','estrutura_candidata_unica') and len(baseline.get('candidates',[]))==1:
            chosen=baseline['candidates'][0]['vmaddr'];method='baseline'
        elif contextual_match.get('state')=='candidato_contextual_unico' and len(contextual_match.get('candidates',[]))==1:
            chosen=contextual_match['candidates'][0]['vmaddr'];method='contexto'
        other=bydst[lib].get(chosen) if chosen else None
        outcome='dados_insuficientes';diffs=[];common=[]
        if source and other and 'v012' in source and 'v012' in other:
            a=set((x['instruction'],x['base'],x['offset']) for x in source['v012']['memory_access_patterns'])
            b=set((x['instruction'],x['base'],x['offset']) for x in other['v012']['memory_access_patterns'])
            common=sorted(a&b);diffs=sorted(a^b)
            outcome=('sem_padroes_observados' if not a and not b else
                     'diferencas_observadas' if diffs else 'padroes_observados_iguais')
            if source['v012']['memory_patterns_truncated'] or other['v012']['memory_patterns_truncated']:
                outcome='inspecao_parcial'
        stats[outcome]+=1
        rows.append({'library':lib,'function_origin':row['function_origin'],
                     'function_target_candidate':chosen,'selection_method':method,
                     'memory_loadstore_x0_to_x7_and_sp':{'state':outcome,
                        'shared_patterns':len(common),'differing_patterns':len(diffs),
                        'examples_of_differences':[{'mnemonic':p[0],'base':p[1],'offset':p[2]} for p in diffs[:12]]},
                     'abi_contract':'nao_demonstrado'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'indicios observacionais de acessos LDR/STR e convencoes potenciais',
      'summary':{'functions_examined':len(rows),'states':dict(stats)},'targets':rows,
      'limitations':['LDR/STR unsigned 64-bit é apenas um subconjunto de acessos à memória.',
            'Registrador X0-X7 pode ter outros papéis; nenhum argumento ou layout foi inferido.',
            'Comparação de offsets não demonstra ABI compatível ou incompatível.']}



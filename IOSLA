def _v009_self_test():
    import tempfile
    # Cross-image fileoff test: second Mach-O's executable code and __LINKEDIT
    # are far beyond the end of the next LC_FILESET_ENTRY range.
    blob=bytearray(12800)
    def pack_seg(segname,vmaddr,fileoff,filesize,section=None):
        sections = []
        if section:
            secname,addr,length,offset=section
            sections.append(struct.pack('<16s16sQQIIIIIIII',secname.encode().ljust(16,b'\0'),
                segname.encode().ljust(16,b'\0'),addr,length,offset,2,0,0,0x80000400,0,0,0))
        n=len(sections)
        return (struct.pack('<II16sQQQQiiII',LC_SEGMENT_64,72+80*n,
                segname.encode().ljust(16,b'\0'),vmaddr,filesize,fileoff,filesize,7,5,n,0)
                +b''.join(sections))
    # Two child entries. First child's segment data follows the NEXT entry's offset.
    entryname=b'com.apple.AGXG11P\0'
    item=struct.pack('<IIQQII',LC_FILESET_ENTRY,32+len(entryname),0x110000,512,32,0)+entryname
    secondname=b'com.example.Second\0'
    item2=struct.pack('<IIQQII',LC_FILESET_ENTRY,32+len(secondname),0x150000,2048,32,0)+secondname
    root_seg=pack_seg('__TEXT',0x10000,0,512)
    h=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,3,len(root_seg)+len(item)+len(item2),0,0)
    blob[0:len(h+root_seg+item+item2)]=h+root_seg+item+item2
    # Child text contains header, while its real executable code lives at 6000,
    # its LC_FUNCTION_STARTS is in __LINKEDIT around 9010.
    childseg=pack_seg('__TEXT',0x120000,512,512)
    executable=pack_seg('__TEXT_EXEC',0x130000,6000,120,('__text',0x130000,120,6000))
    linkedit=pack_seg('__LINKEDIT',0x140000,9000,100)
    fs=struct.pack('<IIII',V008_LC_FUNCTION_STARTS,16,9010,4)
    cb=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,4,
                   len(childseg)+len(executable)+len(linkedit)+len(fs),0,0)
    blob[512:512+len(cb+childseg+executable+linkedit+fs)]=cb+childseg+executable+linkedit+fs
    sec2=pack_seg('__TEXT',0x150000,2048,256)
    h2=struct.pack('<IiiIIIII',0xfeedfacf,CPU_TYPE_ARM64,0,0xC,1,len(sec2),0,0)
    blob[2048:2048+len(h2+sec2)]=h2+sec2
    blob[6000:6120]=b'\xaa\xbb\xcc\xdd'*30

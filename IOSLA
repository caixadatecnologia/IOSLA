def _v015_observe_flow(raw: bytes, address: int) -> dict:
    """Linear abstract register-origin *observations*, not an ABI decompiler.

    Track only recognized 64-bit ADD/SUB immediates, MOV aliases and scaled
    LDR/STR, reset at unknown control flow, calls, and writes. No alias memory,
    pointer authentication, paths, exception edges, or resolved indirect calls.
    """
    count = min(len(raw)//4, V015_TRACE_INSTRUCTIONS)
    reg = {n:(f'X{n}',0) for n in range(8)}
    events=[];call_sites=[];unknown=0;branches=0;stopped=False
    def out_event(item):
        if len(events)<V015_TRACE_EVENTS:events.append(item)
    for i in range(count):
        word=int.from_bytes(raw[4*i:4*i+4],'little');pc=address+4*i
        typ,target=_v014_branch(word,pc)
        # MOV Xd, Xm (alias of ORR Xd, XZR, Xm), with register shift 0.
        if (word & 0xffe0ffe0)==0xaa0003e0:
            dst=word&31;src=(word>>16)&31
            if dst<31:
                if src in reg:reg[dst]=reg[src]
                else:reg.pop(dst,None)
            continue
        # ADD/SUB (immediate), 64-bit only, optionally shifted by 12.
        if (word & 0x7f000000) in (0x11000000,0x51000000) and (word>>31)&1:
            dst=word&31;src=(word>>5)&31
            shift=12 if (word>>22)&1 else 0
            delta=((word>>10)&0xfff)<<shift
            if (word&0x40000000):delta=-delta
            if dst<31:
                if src in reg:
                    root,off=reg[src];reg[dst]=(root,off+delta)
                else:reg.pop(dst,None)
            continue
        mem=_v014_mem(word)
        if mem:
            base=(word>>5)&31;dst=word&31
            if base in reg:
                root,delta=reg[base]
                out_event({'instruction_offset':4*i,'kind':mem['operation'],
                    'origin_register':root,'relative_offset':delta+mem['offset'],
                    'width':mem['width'], 'base_register':mem['base']})
            if mem['operation']=='LDR' and dst<31:reg.pop(dst,None)
            continue
        if typ=='BL':
            call_sites.append({'site':hex(pc),'destination':hex(target) if target is not None else None,
                'argument_origins':{f'X{r}':f'{x[0]}{x[1]:+d}' for r,x in reg.items() if r<4}})
            # A called function may clobber caller-saved registers. Do not track beyond it.
            for j in range(8):reg.pop(j,None)
            continue
        if typ:
            branches+=1
            # Sequential next instruction may not execute on a branch.
            reg.clear()
            if typ=='B':stopped=True;break
            continue
        dec=_v012_decode(word,pc)
        if dec.get('class') in ('CALL_INDIRECT','CALL_INDIRECT_AUTH'):
            call_sites.append({'site':hex(pc),'destination':None,
                 'kind':'unresolved_indirect','argument_origins':{}})
            reg.clear();unknown+=1;continue
        if word & 0xfffffc1f in (0xd65f0000,0xd65f03c0):
            stopped=True;break
        # Unmodeled register write: NEVER preserve provenance through unknown def.
        if (word&0x1f)<31:
            reg.pop(word&31,None);unknown+=1
    return {'instructions_inspected':count,'argument_memory_events':events,
         'events_limited':len(events)>=V015_TRACE_EVENTS,
         'call_sites':call_sites[:V015_TRACE_EVENTS],
         'call_sites_limited':len(call_sites)>V015_TRACE_EVENTS,
         'branches_observed':branches,'unmodelled_register_writes':unknown,
         'linear_scan_stopped':stopped,
         'analysis_scope':'partial_linear_register_provenance_not_interprocedural_proof'}


_v015_old_examine=_v011_examine_image

def _v015_examine(data:bytes,structural_scan:dict,name:str,region_starts:list[int],regions:list[dict])->dict:
    obj=_v015_old_examine(data,structural_scan,name,region_starts,regions)
    if obj.get('status')!='funcoes_e_chamadas_indexadas' or name not in V015_FOCUS_NAMES:return obj
    img=structural_scan.get('images',{}).get(name,{})
    selected=_v009_best_text(img)
    if not selected:return obj
    _,section=selected;mapping=section.get('file_mapping',{})
    if mapping.get('state')!='resolvido':return obj
    off=mapping.get('offset');base=section.get('vmaddr')
    done=0;skipped=0
    for f in obj.get('functions',[])[:V015_FUNCTION_LIMIT]:
        try:
            vm=int(f['vmaddr'],16)
            n=min(int(f.get('instructions_scanned',0)),V015_TRACE_INSTRUCTIONS)
            a=off+vm-base
            if n<0 or not _v009_within(a,n*4,len(data)):
                skipped+=1;continue
            f['v015_flow']=_v015_observe_flow(data[a:a+4*n],vm)
            done+=1
        except (TypeError,ValueError,KeyError,OverflowError):skipped+=1
    obj['v015_audit']={'functions_traced':done,'invalid_windows':skipped,
       'functions_omitted_by_cap':max(0,len(obj.get('functions',[]))-V015_FUNCTION_LIMIT),
       'max_instructions_per_function':V015_TRACE_INSTRUCTIONS}
    return obj

_v011_examine_image=_v015_examine


def _v015_fingerprint(fn:dict)->dict:
    sem=fn.get('v014_semantics') or {};flow=fn.get('v015_flow') or {}
    mem=sem.get('memory_patterns',[])
    # Stable, address independent and deterministic; not an ABI signature.
    canonical={'memory':sorted((x.get('operation'),x.get('width'),x.get('base'),x.get('offset')) for x in mem),
      'control_flow':sorted((k,v) for k,v in sem.get('control_flow',{}).items()
                            if k.startswith('branch_kind_') or k.startswith('CALL_')),
      'observed_origins':sorted((e.get('origin_register'),e.get('relative_offset'),e.get('kind'))
                        for e in flow.get('argument_memory_events',[]))}
    encoded=json.dumps(canonical,sort_keys=True,separators=(',',':'))
    return {'fingerprint_sha256':hashlib.sha256(encoded.encode()).hexdigest(),
       'observations':len(mem)+len(flow.get('argument_memory_events',[])),
       'truncated':bool(fn.get('truncated') or sem.get('memory_patterns_truncated')
                          or flow.get('events_limited')),
       'source':'selected_memory_and_control_observations_not_abi_contract'}


def _v015_function_map(results:dict,label:str)->dict:
    return {(name,f.get('vmaddr')):f
       for name,img in results.get(label,{}).get('images',{}).items()
       for f in img.get('functions',[]) if isinstance(f,dict)}


def _v015_fingerprints(results:dict,cont:dict)->dict:
    origin=_v015_function_map(results,'ORIGEM');dest=_v015_function_map(results,'DESTINO')
    rows=[];counts=Counter()
    for tgt in cont.get('targets',[])[:V015_FUNCTION_LIMIT]:
        lib=tgt.get('library');src=tgt.get('origin_target_function')
        ref=tgt.get('a_to_c',{});cands=ref.get('candidates',[])
        dst=cands[0].get('vmaddr') if len(cands)==1 and ref.get('state') in V013_LEGACY_GOOD else None
        old=origin.get((lib,src));new=dest.get((lib,dst)) if dst else None
        a=_v015_fingerprint(old) if old else None
        b=_v015_fingerprint(new) if new else None
        if a and b and a['observations'] and b['observations']:
            state=('fingerprint_observations_equal' if a['fingerprint_sha256']==b['fingerprint_sha256'] else
                    'fingerprint_observations_differ')
        else:state='insufficient_evidence'
        counts[state]+=1
        rows.append({'library':lib,'origin':src,'destination_candidate':dst,
              'calls':tgt.get('calls_from_agxg11p',0),'state':state,
              'source_fingerprint':a,'destination_fingerprint':b,
              'abi_compatible':'not_demonstrated'})
    return {'iosla_version':APP_VERSION,'mode':'assinaturas observacionais de ABI, sem tipos ou prototipos',
      'generated_at':datetime.now(timezone.utc).isoformat(),
      'summary':{'targets':len(rows),'states':dict(counts)},'targets':rows,
      'limitations':['Fingerprint igual nao comprova ABI; diferente nao comprova incompatibilidade.',
         'Nao compara estruturas completas e nao reconhece todas as instrucoes.']}


def _v015_flow_report(results:dict,graph:dict)->dict:
    firmware=[];total=Counter();sample=[]
    for label,source in results.items():
        observed=[]
        for lib,img in source.get('images',{}).items():
            for fn in img.get('functions',[]):
                trace=fn.get('v015_flow')
                if not trace:continue
                total['traced_functions']+=1
                total['argument_origin_memory_events']+=len(trace['argument_memory_events'])
                total['potential_call_sites']+=len(trace['call_sites'])
                if trace['argument_memory_events'] and len(observed)<12:
                    observed.append({'library':lib,'function':fn['vmaddr'],
                      'events':trace['argument_memory_events'][:6],
                      'call_sites':trace['call_sites'][:3]})
        g=next((g for g in graph.get('firmwares',[]) if g.get('firmware')==label),{})
        firmware.append({'firmware':label,'graph_edges_observed':g.get('edges_unique',0),
            'resolved_bl_sites':g.get('bl_sites_mapped_in_graph',0),
            'sampled_functions':observed})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'proveniência local de registradores + relacoes diretas entre funcoes',
       'summary':dict(total),'firmwares':firmware,
       'limitations':['Fluxo é local e linear; arestas BL representam apenas chamadas diretas observadas.',
        'Nenhuma propagacao de valores entre processos, despacho indireto ou aliases e comprovada.',
        'Registros em chamadas sao apenas observacoes antes do ponto BL, nao prototipos.']}


def _v015_structures(results:dict)->dict:
    rows=[];counts=Counter()
    for label,scan in results.items():
        for lib,img in scan.get('images',{}).items():
            # Aggregate only facts anchored in known incoming argument registers.
            groups={}
            for fn in img.get('functions',[]):
                trace=fn.get('v015_flow',{})
                for event in trace.get('argument_memory_events',[]):
                    reg=event.get('origin_register')
                    if reg not in ('X0','X1','X2','X3'):continue
                    groups.setdefault(reg,Counter())[(event.get('relative_offset'),event.get('width'),event.get('kind'))]+=1
            for reg,matches in groups.items():
                candidates=[{'relative_offset':k[0],'width':k[1],'operation':k[2],
                             'observations':count} for k,count in matches.most_common(30)]
                rows.append({'firmware':label,'library':lib,'candidate_object_base':reg,
                     'observed_offsets':candidates,'layout_recovered':False,
                     'fields_named':False,'same_object_assumption':'not_proven'})
                counts[label]+=len(candidates)
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'agrupamento de offsets observados, sem reconstruir layouts reais',
      'summary':{'groups':len(rows),'offset_patterns_by_firmware':dict(counts)},
      'candidate_groups':rows,'limitations':['Mesmo registrador X0 entre funcoes nao representa uma unica classe.',
      'Offsets relativos e larguras sao somente pistas; tipos e layouts nao demonstrados.']}


def _v015_iokit_service(docs:dict)->dict:
    ev=docs.get('EVIDENCIAS',{});associations=ev.get('associations',[])
    if not isinstance(associations,list):associations=[]
    rows=[];by_device=Counter();noncomparable=Counter()
    for r in associations[:15000]:
        if not isinstance(r,dict):continue
        conditions=r.get('unverified_conditions',[]) or []
        by_device[r.get('device','?')]+=1
        for v in conditions:noncomparable[str(v).split(':')[0]]+=1
        if len(rows)<140:
            rows.append({'firmware':r.get('device'),'kext':r.get('kext'),
              'node':r.get('node_path'),'personality':r.get('personality'),
              'textual_match_keys':r.get('observed_matching_keys',[]),
              'provider_conditions_unverified':conditions,
              'binding':'not_demonstrated'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'grafo textual IOKit para investigacao de condicoes de provider',
       'summary':{'associations_loaded':len(associations),'by_firmware':dict(by_device),
          'unverified_rule_kinds':dict(noncomparable),'evidence_report_loaded':bool(ev)},
       'textual_edges':rows,
       'limitations':['Coincidencia textual de propriedade DeviceTree nao prova binding IOKit.',
         'Propriedades IOProviderClass, IOClass e registro dinamico nao sao verificados.',
         'Ausencia de evidencias sem arquivo IOSLA_EVIDENCIAS nao significa ausencia de servico.']}


def _v015_gpu_ipc(fw:dict,atlas:dict)->dict:
    samples=[];states=Counter()
    for item in fw.get('payloads',[]):
        state=item.get('state','not_available');states[state]+=1
        # Strings are literal evidence, NOT command names or proven message IDs.
        sample=[s for s in item.get('printable_strings_sample',[]) if isinstance(s,str)][:12]
        samples.append({'firmware':item.get('firmware'),'member':item.get('member'),
          'state':state,'sha256':item.get('sha256'),
          'raw_strings_sample':sample,'protocol_identified':False})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
     'mode':'pesquisa de evidencias estaticas GFX sem interpretacao de protocolo IPC',
     'summary':{'payloads':len(samples),'states':dict(states),
                'atlas_available':bool(atlas.get('subsystems'))},
     'payload_observations':samples,
     'limitations':['Strings de firmware nao identificam comandos IPC ou interfaces binárias.',
          'Nenhum protocolo entre host e firmware foi decodificado ou executado.',
          'Payloads nao sao obtidos em modo kernelcache sem IPSW.']}


def _v015_historical(continuity:dict,results:dict,meta:dict|None)->dict:
    rows=[];groups=Counter()
    for r in continuity.get('targets',[])[:V015_FUNCTION_LIMIT]:
        states={key:r.get(key,{}).get('state','not_calculated') for key in ('a_to_b','b_to_c','a_to_c')}
        # A/B changes both hardware and build. B/C changes OS on same model.
        if states['b_to_c']=='bytes_identicos_unicos':kind='bytes_conserved_between_B_C'
        elif states['b_to_c'] in ('estrutura_candidata_unica','bytes_iguais_multiplos_candidatos'):
            kind='structural_candidate_between_B_C'
        else:kind='inconclusive_B_C'
        groups[kind]+=1
        if len(rows)<400:
            rows.append({'library':r.get('library'),'origin_function':r.get('origin_target_function'),
             'calls':r.get('calls_from_agxg11p',0),'pair_states':states,
             'observation':kind,'change_introduction_version':'not_determinable_two_samples'})
    timeline=[]
    for label in ('ORIGEM','CONTROLE','DESTINO'):
        snap=(meta or {}).get(label,{}) if isinstance(meta,dict) else {}
        info=snap.get('meta',{}) if isinstance(snap,dict) else {}
        timeline.append({'key':label,'device':info.get('devices',[]),
          'os':info.get('ios_version'),'build':info.get('build'),
          'metadata_state':'supplied' if info else 'not_available'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'evolucao observacional A/B/C, sem datacao exata de alteracao',
      'summary':{'evaluated_targets':sum(groups.values()),'states':dict(groups)},
      'timeline':timeline,
      'targets':rows,'limitations':['A/B podem mudar hardware e build; nao isolam efeito de hardware.',
       'Duas amostras de um aparelho so delimitam divergencias observadas, nao quando surgiram.',
       'Sem metadata IPSW, dispositivo e versao aparecem como indisponiveis; nunca sao presumidos.']}


def _v015_validation(results:dict,fp:dict)->dict:
    """Deterministic self-consistency/negative controls without false ground truth."""
    rows=[];cross=[];stats=Counter()
    for label,scan in results.items():
        vals=[]
        for name,img in scan.get('images',{}).items():
            vals.extend((name,f) for f in img.get('functions',[]) if f.get('v014_semantics'))
        vals=sorted(vals,key=lambda item:(item[0],item[1].get('vmaddr','')))
        # Recompute a fingerprint from a function: deterministic repeatability,
        # not a genuine positive benchmark for ABI correctness.
        for name,f in vals[:24]:
            a=_v015_fingerprint(f);b=_v015_fingerprint(f)
            stats['deterministic_self_matches']+=bool(a['fingerprint_sha256']==b['fingerprint_sha256'])
        # Cross-image pairs have UNKNOWN equivalence; never label known negatives.
        pairs=0
        for i,(im,f) in enumerate(vals[:80]):
            for other_im,other in vals[i+1:i+40]:
                if im==other_im:continue
                fa=_v015_fingerprint(f);fb=_v015_fingerprint(other)
                if fa['observations'] and fb['observations']:
                    eq=fa['fingerprint_sha256']==fb['fingerprint_sha256']
                    stats['unverified_cross_image_equal' if eq else 'unverified_cross_image_different']+=1
                    if len(cross)<30:cross.append({'firmware':label,'image_A':im,
                        'image_B':other_im,'same_fingerprint':eq,'ground_truth':'unknown'})
                    pairs+=1
                if pairs>=50:break
            if pairs>=50:break
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'checagem deterministica e controles exploratorios sem ground truth ABI',
      'summary':dict(stats),'cross_image_examples':cross,
      'limitations':['Os pares entre bibliotecas nao sao negativos comprovados.',
          'Taxas de falso positivo exigem dados rotulados de referencia; nao calculadas.',
          'Reproducibilidade de hashes nao mede precisao de correspondencia.']}


def _v015_constraints(fp:dict,sem:dict,iokit:dict,fw:dict)->dict:
    sem_idx={(x.get('library'),x.get('origin_function')):x for x in sem.get('targets',[])}
    graph_has_evidence=iokit['summary'].get('evidence_report_loaded',False)
    fw_present=fw.get('summary',{}).get('hashed',0)>0
    states=Counter();rows=[]
    for item in fp.get('targets',[]):
        key=(item['library'],item['origin']);s=sem_idx.get(key,{})
        fstate=item['state'];sstate=s.get('semantic_observation_state','insufficient_binary_evidence')
        if fstate=='fingerprint_observations_equal':a='observed_same_limited_fingerprint'
        elif fstate=='fingerprint_observations_differ':a='observed_difference_not_incompatibility'
        else:a='unknown'
        conditions=[
          {'requirement':'function_fingerprint','state':a,
             'basis':'V015_ABI_FINGERPRINTS'},
          {'requirement':'memory_access_patterns','state':sstate,
             'basis':'IOSLA_SEMANTIC_DIFF'},
          {'requirement':'iokit_provider_binding','state':'unknown_even_if_textual' if graph_has_evidence else 'unknown_no_report',
             'basis':'IOSLA_EVIDENCIAS'},
          {'requirement':'gpu_firmware_protocol','state':'unknown_payload_hashed_only' if fw_present else 'unknown_payload_unavailable',
             'basis':'IOSLA_GPU_FIRMWARE_STATIC'},
          {'requirement':'runtime_integrity_boot','state':'not_tested','basis':'outside_scope'},
        ]
        for c in conditions:states[c['state']]+=1
        rows.append({'library':item['library'],'origin_function':item['origin'],
             'destination_candidate':item['destination_candidate'],
             'calls':item['calls'],'requirements':conditions,
             'overall':'not_demonstrated','compatibility_probability':None})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'restricoes e lacunas de compatibilidade por funcao, sem score de portabilidade',
      'summary':{'target_functions':len(rows),'requirement_states':dict(states)},
      'targets':rows,'limitations':['Nao transforma semelhanca parcial em compatibilidade.',
       'Status unknown significa falta de evidencia, nao incompatibilidade.',
       'Requisitos de hardware sao por subsistema e podem nao ser atribuiveis a uma unica funcao.']}


def _v015_planner(fp:dict,sem:dict,constraints:dict)->dict:
    sem_idx={(r.get('library'),r.get('origin_function')):r for r in sem.get('targets',[])}
    rows=[]
    for x in fp.get('targets',[]):
        m=sem_idx.get((x['library'],x['origin']),{})
        memory=m.get('semantic_observation_state','insufficient_binary_evidence')
        reasons=[]
        if not x['destination_candidate']:reasons.append('sem candidato unico estrutural')
        if x['state']=='insufficient_evidence':reasons.append('fingerprint limitado ou ausente')
        if memory=='access_pattern_differences_observed':reasons.append('diferenca de padroes de memoria')
        if memory=='inspection_truncated':reasons.append('inspecao parcial')
        if not reasons:reasons=['verificar correspondencia com fonte independente']
        ranking=(int(x['calls']),len(reasons))
        rows.append({'library':x['library'],'origin_function':x['origin'],
          'calls':x['calls'],'research_reasons':reasons,'weight':ranking,
          'next_safe_action':'revisar evidencias e desassemblagem offline independentes'})
    rows.sort(key=lambda x:(-x['weight'][0],-x['weight'][1],x['origin_function'] or ''))
    for i,r in enumerate(rows,1):r['research_order']=i;r.pop('weight')
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'fila explicavel de pesquisas, nao estimativa de sucesso',
      'summary':{'targets':len(rows),'prioritized':min(100,len(rows))},
      'priorities':rows[:100],
      'limitations':['Frequencia de chamada e lacunas priorizam a revisao, nao compatibilidade.',
         'Nao gera patches, comandos de inicializacao ou instrucoes de bypass.']}


def _v015_collect(results:dict,ptr_data:dict|None=None,inputs:dict|None=None,
                  docs:dict|None=None)->list[tuple[str,dict]]:
    docs=docs or {}
    continuity=docs.get('ABI_CONTINUITY')
    if not continuity:_,continuity=_v011_continuity(results)
    oldreports=dict(_v014_generate(results,ptr_data,inputs,docs))
    sem=docs.get('SEMANTIC_DIFF') or oldreports['SEMANTIC_DIFF']
    fw=docs.get('GPU_FIRMWARE_STATIC') or oldreports['GPU_FIRMWARE_STATIC']
    atlas=docs.get('A12_HARDWARE_ATLAS') or oldreports['A12_HARDWARE_ATLAS']
    fingerprints=_v015_fingerprints(results,continuity)
    _,graph=_v012_graph(results)
    flow=_v015_flow_report(results,graph)
    structures=_v015_structures(results)
    iokit=_v015_iokit_service(docs)
    ipc=_v015_gpu_ipc(fw,atlas)
    historical=_v015_historical(continuity,results,inputs)
    validation=_v015_validation(results,fingerprints)
    constraints=_v015_constraints(fingerprints,sem,iokit,fw)
    priorities=_v015_planner(fingerprints,sem,constraints)
    return list(zip(V015_REPORT_TYPES,[fingerprints,flow,structures,iokit,ipc,
          historical,validation,constraints,priorities]))


def _v015_md(report:dict)->str:
    lines=['# IOSLA v'+APP_VERSION+' — '+report.get('mode','Pesquisa experimental'),'',
       '**Somente leitura. ABI, compatibilidade e inicialização não demonstradas.**','',
       '## Resumo','','```json',json.dumps(report.get('summary',{}),indent=2,ensure_ascii=False),'```','']
    for name in ('targets','firmwares','candidate_groups','textual_edges','payload_observations',
                 'timeline','cross_image_examples','priorities'):
        items=report.get(name)
        if not isinstance(items,list):continue
        lines+=['## '+name,'']
        for item in items[:15]:
            lines+=['```json',json.dumps(item,indent=2,ensure_ascii=False)[:3000],'```','']
        if len(items)>15:lines+=[f'Mais {len(items)-15} registros no arquivo JSON.','']
    lines+=['## Limitações','']+['- '+str(t) for t in report.get('limitations',[])]+['']
    return '\n'.join(lines)



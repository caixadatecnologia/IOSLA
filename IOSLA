def _v012_decode(word: int, vmaddr: int=0) -> dict:
    """Conservative word-level recognition of documented AArch64 encodings.

    Unknown instructions are deliberately left to the legacy category classifier.
    Register-operand encodings are tested independently against LLVM fixtures.
    """
    register_pair = word & 0xfffffc00
    register_one = word & 0xfffffc1f
    pair = {
        0xd73f0800:'BLRAA',0xd73f0c00:'BLRAB',
        0xd71f0800:'BRAA',0xd71f0c00:'BRAB'
    }
    one = {
        0xd63f081f:'BLRAAZ',0xd63f0c1f:'BLRABZ',
        0xd61f081f:'BRAAZ',0xd61f0c1f:'BRABZ',
        0xd63f0000:'BLR',0xd61f0000:'BR',
        0xd65f0000:'RET'
    }
    # The single-register forms retain a fixed bits[4:0] == 0x1f.
    one={k & 0xfffffc1f:v for k,v in one.items()}
    if register_pair in pair:
        m=pair[register_pair]
        return {'mnemonic':m,'class':('CALL_INDIRECT_AUTH' if m.startswith('BL') else 'BRANCH_INDIRECT_AUTH'),
                'target':None,'registers':[(word>>5)&31,word&31],'verified_encoding':True}
    if register_one in one:
        m=one[register_one]
        return {'mnemonic':m,'class':('CALL_INDIRECT_AUTH' if m.startswith('BLRA') else
               'CALL_INDIRECT' if m=='BLR' else 'RETURN' if m=='RET' else
               'BRANCH_INDIRECT_AUTH' if m.startswith('BRA') else 'BRANCH_INDIRECT'),
               'target':None,'registers':[(word>>5)&31],'verified_encoding':True}
    if word in (0xd65f0bff,0xd65f0fff):
        return {'mnemonic':('RETAA' if word==0xd65f0bff else 'RETAB'),
                'class':'RETURN_AUTH','target':None,'registers':[],'verified_encoding':True}
    pacsys={0xd503233f:'PACIASP',0xd503237f:'PACIBSP',
            0xd50323bf:'AUTIASP',0xd50323ff:'AUTIBSP',
            0xd50320ff:'XPACLRI'}
    if word in pacsys:
        return {'mnemonic':pacsys[word],'class':'PAC_AUTH_HINT',
                'target':None,'registers':[],'verified_encoding':True}
    pac_reg={0xdac10000:'PACIA',0xdac10400:'PACIB',
             0xdac10800:'PACDA',0xdac10c00:'PACDB',
             0xdac11000:'AUTIA',0xdac11400:'AUTIB',
             0xdac11800:'AUTDA',0xdac11c00:'AUTDB'}
    if register_pair in pac_reg:
        return {'mnemonic':pac_reg[register_pair],'class':'PAC_AUTH_REG',
                'target':None,'registers':[word&31,(word>>5)&31], 'verified_encoding':True}
    if word & 0xffffffe0 in (0xdac143e0,0xdac147e0):
        return {'mnemonic':'XPACI' if (word & 0xffffffe0)==0xdac143e0 else 'XPACD',
                'class':'PAC_AUTH_REG','target':None,'registers':[word&31],'verified_encoding':True}
    old,target=_v010_classify(word,vmaddr)
    return {'mnemonic':old,'class':old,'target':target,'registers':[],
            'verified_encoding':old in ('BL','B','BLR','BR','RET')}


def _v012_memory_observation(word: int) -> dict | None:
    """Only LDR/STR unsigned-offset 64-bit forms, not a C++ layout decoder."""
    family = word & 0xffc00000
    if family not in (0xf9400000,0xf9000000):
        return None
    base=(word>>5)&31
    offset=((word>>10)&4095)*8
    return {'kind':'LDR_X' if family==0xf9400000 else 'STR_X',
            'base':'SP' if base==31 else 'X'+str(base), 'byte_offset':offset}


_v012_old_examine=_v011_examine_image


def _v012_examine(data:bytes,structural_scan:dict,name:str,region_starts:list[int],regions:list[dict])->dict:
    image=_v012_old_examine(data,structural_scan,name,region_starts,regions)
    if image.get('status')!='funcoes_e_chamadas_indexadas':
        image['v012_audit']={'status':'dados_insuficientes'}
        return image
    struct_img=structural_scan['images'][name]
    selected=_v009_best_text(struct_img)
    if not selected:
        image['v012_audit']={'status':'secao_indisponivel'}
        return image
    _section,sec=selected
    base=sec['vmaddr'];offset=sec['file_mapping']['offset']
    # Check bounds again even though v011 verified them.
    if not _v009_within(offset,sec['size'],len(data)):
        image['v012_audit']={'status':'mapeamento_invalido'}
        return image
    tally=Counter(); bad=0; examples=[]
    for f in image['functions']:
        addr=int(f['vmaddr'],16)
        count=f['instructions_scanned']
        at=offset+addr-base
        if count<0 or not _v009_within(at,count*4,len(data)):
            bad+=1
            continue
        fcounts=Counter(); offsets=Counter();branches=Counter()
        branch_indirect=[]
        for j in range(count):
            word=int.from_bytes(data[at+j*4:at+j*4+4],'little')
            inst=_v012_decode(word,addr+j*4)
            c=inst['class']; tally[c]+=1; fcounts[c]+=1
            if c.startswith(('BRANCH_','CALL_INDIRECT')) or c in ('B','BCOND','RET','RETURN','RETURN_AUTH'):
                branches[c]+=1
            if c in ('CALL_INDIRECT_AUTH','BRANCH_INDIRECT_AUTH','CALL_INDIRECT'):
                if len(branch_indirect)<12:
                    branch_indirect.append({'site':hex(addr+j*4),'mnemonic':inst['mnemonic'],
                                          'registers':inst['registers'],'target':'nao_resolvido'})
            if c in ('PAC_AUTH_REG','PAC_AUTH_HINT','RETURN_AUTH') and len(examples)<18:
                examples.append({'image':name,'site':hex(addr+j*4),'mnemonic':inst['mnemonic']})
            m=_v012_memory_observation(word)
            if m and (m['base']=='SP' or (m['base'].startswith('X') and
                                               int(m['base'][1:])<=7)):
                offsets[(m['kind'],m['base'],m['byte_offset'])]+=1
        f['v012']={'instruction_classes':dict(fcounts),
                 'control_flow_classes':dict(branches),
                 'memory_access_patterns':[{'instruction':k[0],'base':k[1],
                   'offset':k[2],'count':n} for k,n in offsets.most_common(48)],
                 'memory_patterns_truncated':len(offsets)>48,
                 'indirect_examples':branch_indirect}
    image['v012_audit']={'status':'analisado','instructions_by_class':dict(tally),
        'invalid_function_windows':bad,'sample_auth_instructions':examples,
        'classifier':'selected-encodings-ARM64e + legacy-category-fallback',
        'limitations':['Instruções não reconhecidas pelo decodificador seletivo conservam a classe aproximada.',
                       'BLRAA/BLRAB sem análise de dados não revelam destino.',
                       'LDR/STR de 64 bits com offset imediato são padrões, não layout C++ confirmado.']}
    return image



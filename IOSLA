def _v012_unified_index(reports: dict, files: list[Path], inputs: dict | None=None,
                        errors: dict | None=None) -> dict:
    v11_calls=reports.get('CALL_TARGETS',{}).get('summary',{})
    v11_cont=reports.get('ABI_CONTINUITY',{}).get('summary',{})
    v12_context=reports.get('CONTEXTUAL_MATCH',{}).get('summary',{})

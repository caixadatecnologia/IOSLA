def _v016_examine(data:bytes,structural_scan:dict,name:str,region_starts:list[int],regions:list[dict])->dict:
    obj=_v016_previous_examine(data,structural_scan,name,region_starts,regions)
    if obj.get('status')!='funcoes_e_chamadas_indexadas' or name not in V015_FOCUS_NAMES:
        return obj
    chosen=_v009_best_text(structural_scan.get('images',{}).get(name,{}))
    if not chosen:return obj
    _,section=chosen;mapping=section.get('file_mapping',{})
    if mapping.get('state')!='resolvido':return obj
    offset=mapping.get('offset');base=section.get('vmaddr')
    indexed=0;failed=0;limited=0
    for f in obj.get('functions',[])[:V016_MAX_FUNCTIONS_PER_IMAGE]:
        try:
            vm=int(f['vmaddr'],16)
            count=min(V016_MAX_INSN,int(f.get('instructions_scanned',0)))
            at=offset+vm-base
            if count<=0 or not _v009_within(at,count*4,len(data)):
                failed+=1;continue
            cfg=_v016_cfg(data[at:at+count*4],vm)
            # If input function itself was capped in legacy stage, preserve it.
            cfg['source_function_truncated']=bool(f.get('truncated'))
            cfg['instruction_limit_reached']=(cfg['instruction_limit_reached'] or bool(f.get('truncated')) or int(f.get('instructions_scanned',0))>V016_MAX_INSN)
            flow=_v016_dataflow(cfg)
            f['v016_cfg']={k:v for k,v in cfg.items() if not k.startswith('_')}
            f['v016_dataflow']=flow
            f['v016_contract']=_v016_contract_signature(f['v016_cfg'],flow)
            limited+=int(f['v016_cfg']['instruction_limit_reached'] or not flow['fixpoint_completed'])
            indexed+=1
        except (TypeError,ValueError,KeyError,IndexError,OverflowError):failed+=1
    obj['v016_audit']={'functions_analyzed':indexed,'invalid_windows':failed,
       'limited_functions':limited,
       'functions_omitted_by_cap':max(0,len(obj.get('functions',[]))-V016_MAX_FUNCTIONS_PER_IMAGE),
       'max_instructions_per_function':V016_MAX_INSN,
       'max_blocks':V016_MAX_BLOCKS,'max_iterations':V016_MAX_STEPS}
    return obj


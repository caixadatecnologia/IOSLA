                # The JSON was just generated, so reading it is deterministic.
                blob=p.read_bytes()
                if len(blob)<=V013_REPORT_MAX_BYTES:
                    docs[prefix]=json.loads(blob)
                    prov[prefix]={'file':p.name,'sha256':hashlib.sha256(blob).hexdigest(),
                                  'size_bytes':len(blob)}
                break
    # Other reports come from the current analysis, not stale files on disk.
    for prefix in ('DEVICETREE','HARDWARE','EVIDENCIAS'):
        for p in reversed(self.generated[:start]):
            if p.suffix=='.json' and p.name.startswith('IOSLA_'+prefix+'_'):
                blob=p.read_bytes()
                if len(blob)<=V013_REPORT_MAX_BYTES:
                    docs[prefix]=json.loads(blob)

def _v010_compact_md(report:dict)->str:
    mode=report.get('mode','')
    lines=[f'# IOSLA v{APP_VERSION} — {mode}','','**Investigação estática, somente leitura; nenhuma ABI ou port comprovado.**','']
    if 'summary' in report:
        lines+=['## Resumo','', '```json',json.dumps(report['summary'],ensure_ascii=False,indent=2),'```','']
    if 'scans' in report:
        for label,scan in report['scans'].items():
            lines +=[f'## Firmware: {label}','']
            for name,img in scan.get('images',{}).items():
                counts=img.get('instruction_categories',{})
                lines += [f'- `{name}` — **{img["status"]}**; '+str(len(img.get('functions',[])))+
                          ' funções; '+str(len(img.get('direct_references',[])))+' referências BL; '+
                          'instruções: '+', '.join(f'{k}={v}' for k,v in sorted(counts.items()))]
            lines+=['']
    if 'pairwise_comparisons' in report:
        lines+=['## Comparações estruturais','']
        for row in report['pairwise_comparisons']:
            d=row['comparison']
            lines +=[f'- **{row["pair"]}** — `{row["source_driver"]}` → `{row["target_driver"]}`: '+
                     f'{len(d["candidates"])} candidatos, estado `{d["status"]}`']
        lines+=['']
    if 'drivers' in report:
        lines+=['## Componentes investigados','']
        for d in report['drivers']:
            lines +=[f'### `{d["identifier"] if "identifier" in d else d["driver"]}`','',
                     '```json',json.dumps(d,ensure_ascii=False,indent=2)[:9000],'```','']
    if report.get('errors'):
        lines+=['## Falhas de leitura','',json.dumps(report['errors'],ensure_ascii=False,indent=2),'']
    lines+=['## Limitações','']+['- '+x for x in report.get('limitations',[])]+['']
    return '\n'.join(lines)



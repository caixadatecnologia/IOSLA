from collections import Counter

DEVICE_TREE_ROOT = HOME_DIR / 'devicetrees'
ADT_MAX_NODES = 20_000
ADT_MAX_DEPTH = 72
ADT_MAX_PROPERTIES = 768
ADT_MAX_PROPERTY_BYTES = 16 * 1024 * 1024
DT_BOARD_BY_DEVICE = {'iPhone11,2': 'd321ap', 'iPhone12,1': 'n104ap'}


class DeviceTreeFormatError(ValueError):
    """Estrutura DeviceTree não reconhecida; não inferir dados ausentes."""


def _adt_text(raw: bytes, max_items=32) -> list[str]:
    """Retorna somente cadeias ASCII imprimíveis (evita interpretar inteiros como texto)."""
    if not raw or len(raw) > 1024:
        return []
    result = []
    for fragment in raw.rstrip(b'\x00').split(b'\x00'):
        if not fragment:
            continue
        if len(fragment) > 192 or any(x < 32 or x > 126 for x in fragment):
            return []
        result.append(fragment.decode('ascii'))
        if len(result) >= max_items:
            break
    return result


def parse_apple_devicetree(raw: bytes) -> dict[str, Any]:
    """Parser conservador Apple Flattened Device Tree (ADT), não um parser FDT Linux.

    Cada nó: u32 propriedades, u32 filhos; propriedades: char[32], u32
    tamanho/flags, bytes + padding de 4; filhos recursivos. Impõe limites.
    Também reconhece XML/binary plist, mas não cria nós artificiais.
    """
    if not raw or len(raw) > 64 * 1024 * 1024:
        raise DeviceTreeFormatError('DeviceTree vazio ou superior a 64 MiB.')
    fmt = 'Apple DeviceTree plano (ADT)'
    data = raw
    if raw[:1] == b'0':
        try:
            data, kind, expected, notes = _im4p_payload(raw)
            fmt = 'IM4P (' + kind + ') / ' + fmt
            if kind not in ('dtre', 'rdtr'):
                raise DeviceTreeFormatError('IM4P não é um DeviceTree (tipo: ' + kind + ').')
        except KernelFormatError as exc:
            raise DeviceTreeFormatError(str(exc)) from exc
    if data.startswith((b'bvx2', b'bvxn', b'bvx1', b'bvx-')):
        try:
            plain = _uncompressed_lzfse(data)
            data = plain if plain is not None else _macos_lzfse(data)
        except KernelFormatError as exc:
            raise DeviceTreeFormatError(str(exc)) from exc
        fmt += ' / LZFSE'
    if data.startswith((b'bplist00', b'<?xml')):
        try:
            obj = plistlib.loads(data)
        except (ValueError, TypeError, plistlib.InvalidFileException) as exc:
            raise DeviceTreeFormatError('Plist DeviceTree inválido.') from exc
        if not isinstance(obj, dict):
            raise DeviceTreeFormatError('Plist DeviceTree sem dicionário.')
        return {'format':fmt.replace('plano (ADT)','plist'), 'coverage':'metadados de plist',
                'node_count':0, 'nodes':{}, 'plist_keys':sorted(str(k) for k in obj.keys()),
                'notes':['Plist identificado; nós ADT não disponíveis neste formato.']}

    pos = 0
    nodes = {}
    total_props = 0

    def node(depth: int, parent: str, sibling_index: int):
        nonlocal pos, total_props
        if depth > ADT_MAX_DEPTH or len(nodes) >= ADT_MAX_NODES:
            raise DeviceTreeFormatError('DeviceTree excede limites de profundidade ou nós.')
        if pos + 8 > len(data):
            raise DeviceTreeFormatError('Cabeçalho de nó ADT truncado.')
        num_props, num_children = struct.unpack_from('<II', data, pos)
        pos += 8
        if num_props > ADT_MAX_PROPERTIES or num_children > ADT_MAX_NODES:
            raise DeviceTreeFormatError('Contagem de propriedades/filhos fora do limite.')
        if depth == 0 and num_props == 0:
            raise DeviceTreeFormatError('Raiz ADT sem propriedades; dados não verificáveis.')
        properties = {}
        texts = {}
        for _ in range(num_props):
            if pos + 36 > len(data):
                raise DeviceTreeFormatError('Cabeçalho de propriedade ADT truncado.')
            keyraw, length_flags = struct.unpack_from('<32sI', data, pos)
            pos += 36
            namebytes = keyraw.split(b'\x00', 1)[0]
            if not namebytes or any(b < 32 or b > 126 for b in namebytes):
                raise DeviceTreeFormatError('Nome de propriedade ADT inválido.')
            name = namebytes.decode('ascii')
            length = length_flags & 0x7fffffff
            if length > ADT_MAX_PROPERTY_BYTES or pos + ((length + 3) & ~3) > len(data):
                raise DeviceTreeFormatError('Propriedade ADT excede tamanho disponível.')
            value = data[pos:pos + length]
            pos += (length + 3) & ~3
            total_props += 1
            if name in properties:
                raise DeviceTreeFormatError('Propriedade ADT repetida no mesmo nó: ' + name)
            properties[name] = {'length':length, 'sha256':hashlib.sha256(value).hexdigest()}
            if name in ('name','compatible','device_type','model','firmware-name','unit-address'):
                decoded = _adt_text(value)
                if decoded:
                    texts[name] = decoded
        if depth == 0 and 'name' not in texts and 'compatible' not in texts:
            raise DeviceTreeFormatError('Raiz ADT sem identificação textual verificável.')
        label = texts.get('name', [f'unnamed-{sibling_index}'])[0]
        label = re.sub(r'[^A-Za-z0-9_,.@+-]', '_', label)[:72] or 'unnamed'
        candidate = (parent.rstrip('/') + '/' + label) if parent else '/' + label
        path = candidate
        suffix = 1
        while path in nodes:
            suffix += 1
            path = f'{candidate}#{suffix}'
        nodes[path] = {'properties':properties, 'text':texts, 'children_declared':num_children}
        for child_index in range(num_children):
            node(depth + 1, path, child_index)

    node(0, '', 0)
    if pos < len(data) and any(b != 0 for b in data[pos:]):
        raise DeviceTreeFormatError('Há dados não nulos após a árvore ADT.')
    return {'format':fmt, 'coverage':'estrutura de nós interpretada',
            'node_count':len(nodes), 'property_count':total_props, 'nodes':nodes,
            'notes':['Dados e hashes são estáticos; DeviceTrees diferentes não comprovam compatibilidade de hardware.']}


def _device_tree_candidates(ipsw: Path, device: str) -> tuple[list[str], str]:
    """Escolhe o DeviceTree por DeviceClass do manifest e identificador de placa.

    IPSWs XS incluem múltiplas placas; misturar todas produziria resultados falsos.
    """
    board = DT_BOARD_BY_DEVICE.get(device)
    if not board:
        raise DeviceTreeFormatError('Não há mapeamento explícito de placa para ' + device)
    with zipfile.ZipFile(ipsw) as z:
        manifest = plistlib.loads(z.read('BuildManifest.plist'))
        names = set(z.namelist())
    matched = []
    for identity in manifest.get('BuildIdentities', []):
        info = identity.get('Info', {})
        devclass = str(info.get('DeviceClass','')).lower()
        if devclass != board:
            continue
        component = identity.get('Manifest', {}).get('DeviceTree', {})
        ref = component.get('Info', {}).get('Path') if isinstance(component, dict) else None
        if ref and ref in names:
            matched.append(ref)
    # Nomes explícitos de placa são válidos mesmo quando o BuildManifest omite DeviceClass.
    fallbacks = [n for n in names if n.lower().endswith(f'devicetree.{board}.im4p')]
    candidates = sorted(set(matched or fallbacks))
    return candidates, board


def extract_local_devicetree(ipsw: str|Path, device: str, directory: Path) -> tuple[Path, str]:
    p=Path(ipsw).expanduser().resolve()
    candidates,board=_device_tree_candidates(p,device)
    if not candidates:
        raise DeviceTreeFormatError('DeviceTree da placa ' + board + ' não encontrado no IPSW.')
    # Um firmware pode listar múltiplas variantes equivalentes; escolher deterministicamente.
    selected=candidates[0]
    with zipfile.ZipFile(p) as archive:
        info=archive.getinfo(selected)
        if info.file_size > 64*1024*1024:
            raise DeviceTreeFormatError('DeviceTree excede limite de 64 MiB.')
        payload=archive.read(info)
    directory.mkdir(parents=True,exist_ok=True)
    output=directory / Path(selected).name
    if output.is_file() and output.read_bytes()==payload:
        return output,selected
    output.write_bytes(payload)
    return output,selected


def compare_devicetrees(old:dict|None,new:dict|None)->dict:
    a=old.get('nodes',{}) if old else {}
    b=new.get('nodes',{}) if new else {}
    names=sorted(set(a)|set(b))
    common=[x for x in names if x in a and x in b]
    changed=[]
    for path in common:
        pa=a[path]['properties']; pb=b[path]['properties']
        only_a=sorted(set(pa)-set(pb)); only_b=sorted(set(pb)-set(pa))
        modified=sorted(k for k in set(pa)&set(pb) if pa[k]['sha256']!=pb[k]['sha256'])
        if only_a or only_b or modified:
            changed.append({'path':path,'origin_only_properties':only_a,
                            'target_only_properties':only_b,'changed_properties':modified})
    def compatibles(nodes):
        values=set()
        for v in nodes.values():
            values.update(v.get('text',{}).get('compatible',[]))
        return values
    ca,cb=compatibles(a),compatibles(b)
    return {'origin_node_count':len(a),'target_node_count':len(b),
            'common_paths':len(common),
            'paths_only_origin':sorted(set(a)-set(b)),
            'paths_only_target':sorted(set(b)-set(a)),
            'changed_properties':changed,
            'compatibles_only_origin':sorted(ca-cb),
            'compatibles_only_target':sorted(cb-ca),
            'shared_compatibles':sorted(ca&cb),
            'assessment':'INCONCLUSIVO: caminhos e propriedades não comprovam presença, ausência ou compatibilidade de drivers.'}


def devicetree_markdown(report:dict)->str:
    l=[f'# IOSLA v{APP_VERSION} — DeviceTree Analyzer','',
       '**Comparação estática de duas placas diferentes. Nenhuma compatibilidade foi demonstrada.**','',

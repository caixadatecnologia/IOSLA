from typing import Any

APP_VERSION = "0.0.17"
MAX_KERNEL_SIZE = 768 * 1024 * 1024


class IOSLAError(Exception):
    """A friendly error to display in the CLI."""


@dataclass
class Kext:
    identifier: str
    version: str = "desconhecida"
    dependencies: dict[str, str] = field(default_factory=dict)
    personalities: list[str] = field(default_factory=list)
    personality_matching: dict[str, dict[str, Any]] = field(default_factory=dict)
    region_sha256: str = ""
    provenance: str = "não informada"

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)


@dataclass
class Snapshot:
    label: str
    origin: str
    kind: str
    kexts: dict[str, Kext]
    ios_version: str = "não informado"
    build: str = "não informada"
    device: str = "não informado"
    kernel_path: str = ""
    is_demo: bool = False
    manifest_components: list[str] = field(default_factory=list)
    analysis_notes: list[str] = field(default_factory=list)
    coverage: str = "não avaliada"

    def to_dict(self) -> dict[str, Any]:
        return {
            "label": self.label,
            "origin": self.origin,
            "kind": self.kind,
            "ios_version": self.ios_version,
            "build": self.build,
            "device": self.device,
            "kernel_path": self.kernel_path,
            "is_demo": self.is_demo,
            "manifest_components": self.manifest_components,
            "analysis_notes": self.analysis_notes,
            "coverage": self.coverage,
            "kext_count": len(self.kexts),
            "kexts": [k.to_dict() for k in sorted(self.kexts.values(), key=lambda k: k.identifier)],
        }


def _string(value: Any, default: str = "") -> str:
    if value is None:
        return default
    if isinstance(value, (int, float, str)):
        return str(value)
    return default


def parse_inventory(data: Any) -> dict[str, Kext]:
    """Support raw `ipsw kernel kexts --json` arrays and IOSLA wrapper files.

    The blacktop JSON includes `id`/`version`, and can include
    `io_kit_personalities` and bundle library dictionaries on some releases.
    Missing metadata remains unknown (never invented).
    """
    if isinstance(data, dict):
        if isinstance(data.get("kexts"), (list, dict)):
            data = data["kexts"]
        elif isinstance(data.get("extensions"), (list, dict)):
            data = data["extensions"]
        else:
            raise IOSLAError("JSON sem lista 'kexts' ou 'extensions'.")

    if isinstance(data, dict):
        data = [dict(entry, id=key) if isinstance(entry, dict) else {"id": key, "version": entry}
                for key, entry in data.items()]

    if not isinstance(data, list):
        raise IOSLAError("O inventário JSON precisa conter uma lista de KEXTs.")

    result: dict[str, Kext] = {}
    for index, entry in enumerate(data):
        if not isinstance(entry, dict):
            raise IOSLAError(f"Entrada de KEXT #{index + 1} inválida (esperado objeto).")
        name = _string(entry.get("id") or entry.get("identifier") or entry.get("bundle_id")).strip()
        if not name:
            raise IOSLAError(f"Entrada de KEXT #{index + 1} sem id/identifier.")
        if name in result:
            raise IOSLAError(f"KEXT duplicada: {name}")

        dependencies_raw = (entry.get("dependencies") or entry.get("os_bundle_libraries")
                            or entry.get("OSBundleLibraries") or {})
        dependencies = {}
        if isinstance(dependencies_raw, dict):
            dependencies = {str(k): _string(v, "não informada")
                            for k, v in dependencies_raw.items()}
        elif isinstance(dependencies_raw, list):
            dependencies = {str(item): "não informada" for item in dependencies_raw if isinstance(item, str)}

        personalities_raw = (entry.get("io_kit_personalities")
                             or entry.get("IOKitPersonalities") or {})
        if isinstance(personalities_raw, dict):
            personalities = sorted(str(key) for key in personalities_raw)
        elif isinstance(personalities_raw, list):
            personalities = sorted(_string(item) for item in personalities_raw)
        else:
            personalities = []

        source_rules=entry.get('personality_matching') or entry.get('IOKitPersonalities') or entry.get('io_kit_personalities')
        rules={}
        if isinstance(source_rules,dict):
            for pname,properties in source_rules.items():
                if not isinstance(properties,dict):continue
                selected={}
                for key in ('IONameMatch','IONameMatched','IOProviderClass','IOClass'):
                    val=properties.get(key)
                    if isinstance(val,str):selected[key]=[val[:256]]
                    elif isinstance(val,list):selected[key]=[v[:256] for v in val if isinstance(v,str)][:32]
                propmatch=properties.get('IOPropertyMatch')
                if isinstance(propmatch,dict):
                    selected['IOPropertyMatch']={str(k):v for k,v in propmatch.items()
                                                 if isinstance(v,str) or (isinstance(v,list) and all(isinstance(x,str) for x in v))}
                if selected: rules[str(pname)]=selected
        result[name] = Kext(
            identifier=name,
            version=_string(entry.get("version"), "desconhecida"),
            dependencies=dependencies,
            personalities=personalities,
            personality_matching=rules,
            region_sha256=_string(entry.get("fileset_region_sha256"), ""),
            provenance=_string(entry.get("origin_metadata"), "não informada"),
        )
    return result


def load_json_inventory(path: str | Path, label: str) -> Snapshot:
    p = Path(path).expanduser().resolve()
    if not p.is_file():
        raise IOSLAError(f"Arquivo não encontrado: {p}")
    try:
        with p.open(encoding="utf-8-sig") as handle:
            data = json.load(handle)
    except (OSError, ValueError) as exc:
        raise IOSLAError(f"Não foi possível ler o JSON: {exc}") from exc

    kexts = parse_inventory(data)
    meta = data if isinstance(data, dict) else {}
    return Snapshot(
        label=label, origin=str(p), kind="json", kexts=kexts,
        ios_version=_string(meta.get("ios_version"), "não informado"),
        build=_string(meta.get("build"), "não informada"),
        device=_string(meta.get("device"), "não informado"),
        is_demo=bool(meta.get("is_demo", False)),
    )


def inspect_ipsw(path: str | Path) -> dict[str, Any]:
    p = Path(path).expanduser().resolve()
    if not p.is_file() or not zipfile.is_zipfile(p):
        raise IOSLAError(f"IPSW não encontrado ou ZIP inválido: {p}")
    try:
        with zipfile.ZipFile(p) as archive:
            names = archive.namelist()
            metadata = {entry.filename: {"size": entry.file_size, "crc32": entry.CRC}
                        for entry in archive.infolist() if not entry.is_dir()}
            manifest = plistlib.loads(archive.read("BuildManifest.plist"))
    except KeyError as exc:
        raise IOSLAError("IPSW sem BuildManifest.plist.") from exc
    except (OSError, ValueError, plistlib.InvalidFileException, zipfile.BadZipFile) as exc:
        raise IOSLAError(f"Falha ao analisar o IPSW: {exc}") from exc
    components: dict[str, set[str]] = {}
    for identity in manifest.get("BuildIdentities", []):
        component_list = identity.get("Manifest", {})
        if isinstance(component_list, dict):
            for name, content in component_list.items():
                paths = components.setdefault(name, set())
                if isinstance(content, dict) and isinstance(content.get("Info"), dict):
                    value = content["Info"].get("Path")
                    if isinstance(value, str):
                        paths.add(value)
    return {
        "ios_version": str(manifest.get("ProductVersion", "não informado")),
        "build": str(manifest.get("ProductBuildVersion", "não informada")),
        "devices": manifest.get("SupportedProductTypes", []),
        "component_names": sorted(components),
        "component_paths": {k: sorted(v) for k, v in sorted(components.items())},
        "zip_entries": len(names),
        "files": names,
        "entry_metadata": metadata,
        "kernel_references": sorted(name for name in names if "kernelcache" in name.lower()),
    }


def compare_ipsw_manifests(left: dict[str, Any], right: dict[str, Any]) -> list[dict[str, str]]:
    """Legacy v0.0.1 metadata comparison; NOT a binary/ABI comparison."""
    result = []
    component_names = set(left["component_paths"]) | set(right["component_paths"])
    for name in sorted(component_names):
        lpaths = left["component_paths"].get(name)
        rpaths = right["component_paths"].get(name)
        if lpaths is None:
            state = "ADICIONADO"
        elif rpaths is None:
            state = "REMOVIDO"
        elif lpaths != rpaths:
            state = "CAMINHO DIFERENTE"
        elif all(left["entry_metadata"].get(p) == right["entry_metadata"].get(p)
                 and p in left["entry_metadata"] and p in right["entry_metadata"] for p in lpaths):
            state = "MESMO TAMANHO/CRC32"
        else:
            state = "METADADOS DIFERENTES/INCOMPLETOS"
        result.append({"component": name, "status": state})
    return result


def tool_exists() -> bool:
    """Backward compatible API: built-in kernel parser is always available."""
    return True


def kernel_entries(archive: zipfile.ZipFile) -> list[str]:
    """Get kernelcache archive members (never extract them blindly)."""
    return sorted(info.filename for info in archive.infolist()
                  if not info.is_dir() and 'kernelcache' in info.filename.lower())


def _read_archive_kernel(archive: zipfile.ZipFile, folder: Path,
                         selection: str = '') -> Path:
    choices = kernel_entries(archive)
    if not choices:
        raise IOSLAError('Nenhum kernelcache foi encontrado dentro do IPSW.')
    if selection and selection not in choices:
        raise IOSLAError('Kernelcache escolhido não aparece no IPSW: ' + selection)
    if not selection and len(choices) != 1:
        raise IOSLAError('Existem vários kernelcaches. Informe o nome de um deles:\n' +
                         '\n'.join(' - ' + item for item in choices[:35]))
    chosen = selection or choices[0]
    entry = archive.getinfo(chosen)
    if entry.file_size > MAX_KERNEL_SIZE:
        raise IOSLAError('Kernelcache maior que o limite de segurança de 768 MiB.')
    # Fixed filename avoids ZIP path traversal; preserve origin name only inside metadata.
    safe_name = re.sub(r'[^a-zA-Z0-9._-]', '_', Path(chosen).name)
    output = folder / safe_name
    if output.exists():
        # Reutiliza apenas extrações idênticas (tamanho + CRC32); não sobrescreve.
        if output.is_file() and output.stat().st_size == entry.file_size:
            crc = 0
            with output.open('rb') as previous:
                for chunk in iter(lambda: previous.read(1024 * 1024), b''):
                    crc = zlib.crc32(chunk, crc)
            if (crc & 0xffffffff) == entry.CRC:
                return output
        raise IOSLAError('Já existe um kernelcache diferente neste destino: ' + str(output))
    with archive.open(entry) as inp, output.open('xb') as out:
        total = 0
        try:
            while True:
                part = inp.read(1024 * 1024)
                if not part:
                    break
                total += len(part)
                if total > MAX_KERNEL_SIZE:
                    raise IOSLAError('Limite de segurança do kernelcache excedido.')
                out.write(part)
        except Exception:
            output.unlink(missing_ok=True)
            raise
    return output


def extract_kernel(source: str, output_root: str | Path, label: str,
                   device: str = '', selection: str = '') -> Path:
    """Extrai um kernelcache de um IPSW local para uma pasta fixa de Downloads."""
    root = Path(output_root).expanduser().resolve()
    root.mkdir(parents=True, exist_ok=True)
    p = Path(source).expanduser().resolve()
    if not p.is_file():
        raise IOSLAError('IPSW local não encontrado: ' + str(p))
    try:
        with zipfile.ZipFile(p) as archive:
            return _read_archive_kernel(archive, root, selection)
    except (zipfile.BadZipFile, OSError, ValueError) as exc:
        if isinstance(exc, IOSLAError):
            raise
        raise IOSLAError('Não foi possível extrair o kernelcache: ' + str(exc)) from exc


def load_kernel(path: str | Path, label: str, *, ios_version='não informado',
                build='não informada', device='não informado', origin='',
                kind='kernelcache', manifest_components: list[str] | None = None) -> Snapshot:
    p = Path(path).expanduser().resolve()
    try:
        inv = parse_kernel_file(p)
    except (KernelFormatError, OSError) as exc:
        raise IOSLAError(f'Kernelcache não analisável: {exc}') from exc
    return Snapshot(
        label=label, origin=origin or str(p), kind=kind,
        kexts=parse_inventory(inv.kexts), ios_version=ios_version,
        build=build, device=device, kernel_path=str(p),
        manifest_components=manifest_components or [], analysis_notes=inv.notes,
        coverage=inv.coverage,
    )


def compare_kexts(old: Snapshot, new: Snapshot) -> dict[str, Any]:
    rows: list[dict[str, Any]] = []
    for identifier in sorted(set(old.kexts) | set(new.kexts)):
        earlier = old.kexts.get(identifier)
        later = new.kexts.get(identifier)
        if earlier is None:
            status = "ADICIONADA"
        elif later is None:
            status = "REMOVIDA"
        elif earlier.version != later.version:
            status = "VERSÃO ALTERADA"
        elif earlier.dependencies != later.dependencies or earlier.personalities != later.personalities:
            status = "METADADOS ALTERADOS"
        elif earlier.region_sha256 and later.region_sha256 and earlier.region_sha256 != later.region_sha256:
            status = "REGIÃO FILESET ALTERADA"
        else:
            status = "SEM DIFERENÇAS DETECTADAS"
        deps_old = earlier.dependencies if earlier else {}
        deps_new = later.dependencies if later else {}
        rows.append({
            "id": identifier,
            "category": categorize(identifier),
            "status": status,
            "old_version": earlier.version if earlier else None,
            "new_version": later.version if later else None,
            "old_dependencies": deps_old,
            "new_dependencies": deps_new,
            "added_dependency_names": sorted(set(deps_new) - set(deps_old)),
            "removed_dependency_names": sorted(set(deps_old) - set(deps_new)),
            "old_personalities": earlier.personalities if earlier else [],
            "old_region_sha256": earlier.region_sha256 if earlier else None,
            "new_region_sha256": later.region_sha256 if later else None,
            "new_personalities": later.personalities if later else [],
            # An absent inventory entry does NOT imply missing runtime symbols.
            "references_not_listed_old": sorted(set(deps_old) - set(old.kexts)),
            "references_not_listed_new": sorted(set(deps_new) - set(new.kexts)),
        })

    return {
        "iosla_version": APP_VERSION,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "demo": old.is_demo or new.is_demo,
        "source": old.to_dict(),
        "target": new.to_dict(),
        "summary": dict(Counter(row["status"] for row in rows)),
        "comparison": rows,
        "limitations": [
            "KEXTs iguais no inventário não são necessariamente binariamente idênticas.",
            "Hash de região fileset é um recorte no kernelcache, não corresponde ao executável isolado.",
            "Metadados de arquivos Mach-O podem ser parciais; versões desconhecidas não representam incompatibilidade.",
            "Mudanças nas dependências declaradas não demonstram compatibilidade com o kernel.",
            "Referências não listadas no inventário NÃO comprovam dependências ausentes no sistema.",
            "IOSLA não aplica patches, não modifica IPSWs e não instala iOS.",
        ],
    }


def categorize(name: str) -> str:
    n = name.lower()
    if any(x in n for x in ("agx", "gpu", "graphics", "metal", "display", "iosurface")):
        return "GPU/Tela"
    if any(x in n for x in ("sep", "security", "biometric", "faceid", "image4")):
        return "Segurança"
    if any(x in n for x in ("wifi", "wlan", "bluetooth", "airport")):
        return "Conectividade"
    if any(x in n for x in ("audio", "sound", "speaker")):
        return "Áudio"
    if any(x in n for x in ("camera", "isp", "image")):
        return "Câmera"
    if any(x in n for x in ("storage", "nand", "ans", "nvme")):
        return "Armazenamento"
    return "Outros"


def export_report(report: dict[str, Any], folder: str | Path) -> tuple[Path, Path]:
    dest = Path(folder).expanduser().resolve()
    dest.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
    json_file = dest / f"IOSLA_KEXT_{timestamp}.json"
    md_file = dest / f"IOSLA_KEXT_{timestamp}.md"
    json_file.write_text(json.dumps(report, indent=2, ensure_ascii=False), encoding="utf-8")
    md_file.write_text(make_markdown(report), encoding="utf-8")
    return json_file, md_file


def make_markdown(report: dict[str, Any]) -> str:
    def safe(text: Any) -> str:
        return str(text or "-").replace("|", "\\|").replace("\n", " ")

    title = f"# IOSLA v{APP_VERSION} — Kernel & KEXT Analyzer"
    lines = [title, "", f"Gerado em: {report['generated_at']}", ""]
    if report["demo"]:
        lines.extend(["> **DEMONSTRAÇÃO:** dados sintéticos, não são KEXTs reais da Apple.", ""])
    for key, heading in (("source", "Origem"), ("target", "Destino")):
        s = report[key]
        lines.extend([f"## {heading}", "", f"- Fonte: `{safe(s['origin'])}`",
                      f"- Sistema: {safe(s['ios_version'])}", f"- Build: {safe(s['build'])}",
                      f"- Dispositivo: {safe(s['device'])}", f"- KEXTs: {s['kext_count']}",
                      f"- Cobertura: {safe(s.get('coverage'))}", ""])
    lines.extend(["## Resumo", ""])
    for label, count in report["summary"].items():
        lines.append(f"- {label}: **{count}**")
    lines.extend(["", "## Comparação de KEXTs", "",
                  "| Identificador | Categoria | Origem | Destino | Resultado |",
                  "|---|---|---|---|---|"])
    for row in report["comparison"]:
        lines.append("| " + " | ".join(safe(row[k]) for k in
                     ("id", "category", "old_version", "new_version", "status")) + " |")
    lines.extend(["", "## Limitações", ""])
    for limitation in report["limitations"]:
        lines.append(f"- {limitation}")
    return "\n".join(lines) + "\n"


            chosen=candidates[0]['vmaddr'];method='structural_legacy'
        else:
            new=ctx.get((lib,addr),{}).get('contextual_A_C',{})
            if new.get('state')=='candidato_contextual_unico' and len(new.get('candidates',[]))==1:
                chosen=new['candidates'][0].get('vmaddr');method='contextual_candidate'
        target=dstidx.get(lib,{}).get(chosen) if chosen else None
        s=source.get('v014_semantics') if source else None
        t=target.get('v014_semantics') if target else None
        if s and t:
            ap={(x['operation'],x['width'],x['base'],x['offset']) for x in s['memory_patterns']}
            bp={(x['operation'],x['width'],x['base'],x['offset']) for x in t['memory_patterns']}
            shared=len(ap&bp);diff=len(ap^bp)
            state=('insufficient_memory_samples' if not ap and not bp else
                   'inspection_truncated' if source.get('truncated') or target.get('truncated') or
                      s['memory_patterns_truncated'] or t['memory_patterns_truncated'] else
                   'observed_access_patterns_equal' if diff==0 else 'access_pattern_differences_observed')
            cf={key:{'A':s['control_flow'].get(key,0),'C':t['control_flow'].get(key,0)}
                 for key in sorted(set(s['control_flow'])|set(t['control_flow']))
                 if s['control_flow'].get(key,0)!=t['control_flow'].get(key,0)}
            mem={'shared_patterns':shared,'different_patterns':diff,
                 'examples_A_only':[list(a) for a in sorted(ap-bp)[:6]],
                 'examples_C_only':[list(a) for a in sorted(bp-ap)[:6]],
                 'truncation_or_partial':bool(source.get('truncated') or target.get('truncated'))}
        else:
            state='insufficient_binary_evidence';cf={};mem={}
        stats[state]+=1
        rows.append({'library':lib,'origin_function':addr,'destination_candidate':chosen,
           'selection_method':method,'calls':row.get('calls_from_agxg11p',0),
           'semantic_observation_state':state,'memory_comparison':mem,
           'control_flow_differences':cf,'abi_contract':'nao_demonstrado',
           'semantic_equivalence':'nao_demonstrada'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
      'mode':'comparacao semantica observacional sobre funcoes candidatas',

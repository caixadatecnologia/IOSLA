"""IOSLA: offline, read-only kernelcache parser (no Blacktop).

Parses local IM4P/IMG4, LZFSE (macOS system Compression), legacy complzss,
FAT/arm64 and modern Mach-O MH_FILESET entries. Unknown/encrypted input fails
explicitly. No patching or signing support is implemented.
"""

import ctypes
import ctypes.util
import hashlib
import plistlib
import struct
import sys
import zlib
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

MAX_INPUT = 768 * 1024 * 1024
MAX_DECODED = 768 * 1024 * 1024
MH_MAGIC_64 = b'\xcf\xfa\xed\xfe'
MH_CIGAM_64 = b'\xfe\xed\xfa\xcf'
LC_SEGMENT_64 = 0x19
LC_FILESET_ENTRY = 0x80000035  # LC_REQ_DYLD | 0x35, not just 0x35
LZFSE_ALGORITHM = 0x801
CPU_TYPE_ARM64 = 0x0100000C


class KernelFormatError(ValueError):
    """Input is unsupported or malformed (do not silently invent KEXT data)."""


@dataclass
class KernelInventory:
    format: str
    kexts: list[dict[str, Any]] = field(default_factory=list)
    notes: list[str] = field(default_factory=list)
    coverage: str = 'parcial'
    file_entries: int = 0


def _der_tlv(data: bytes, offset: int, upper: int | None = None) -> tuple[int, int, int, int]:
    upper = len(data) if upper is None else upper
    if offset < 0 or offset + 2 > upper:
        raise KernelFormatError('DER truncado (cabeçalho).')
    tag, lead = data[offset], data[offset + 1]
    if lead < 0x80:
        size, start = lead, offset + 2
    else:
        count = lead & 0x7f
        if count == 0 or count > 6 or offset + 2 + count > upper:
            raise KernelFormatError('DER: comprimento inválido.')
        size = int.from_bytes(data[offset+2:offset+2+count], 'big')
        start = offset + 2 + count
    end = start + size
    if end > upper:
        raise KernelFormatError('DER: tamanho ultrapassa o contêiner.')
    return tag, start, end, end


def _der_children(data: bytes, begin: int, end: int) -> list[tuple[int, int, int]]:
    result = []
    pos = begin
    while pos < end:
        if len(result) >= 100:
            raise KernelFormatError('DER: excesso de campos.')
        tag, b, e, pos = _der_tlv(data, pos, end)
        result.append((tag, b, e))
    return result


def _im4p_payload(data: bytes) -> tuple[bytes, str, int | None, list[str]]:
    """Return payload, component kind, expected decompressed size, diagnostics."""
    tag, begin, end, _ = _der_tlv(data, 0)
    if tag != 0x30:
        raise KernelFormatError('Não há contêiner DER IMG4/IM4P reconhecível.')
    notes: list[str] = []

    def visit(begin: int, end: int, depth: int) -> tuple[bytes, str, int | None] | None:
        children = _der_children(data, begin, end)
        if len(children) >= 4 and children[0][0] in (0x16, 0x0c, 0x13) and data[children[0][1]:children[0][2]] == b'IM4P':
            item = children[3]
            if item[0] != 0x04:
                raise KernelFormatError('IM4P encontrado mas payload não é OCTET STRING.')
            kind = data[children[1][1]:children[1][2]].decode('ascii', 'replace')
            # Optional compression parameters: SEQUENCE { INTEGER version, INTEGER unpackedSize }.
            expected = None
            for extra in children[4:]:
                if extra[0] == 0x30:
                    sub = _der_children(data, extra[1], extra[2])
                    if len(sub) >= 2 and sub[0][0] == 2 and sub[1][0] == 2:
                        size = int.from_bytes(data[sub[1][1]:sub[1][2]], 'big')
                        if 0 < size <= MAX_DECODED:
                            expected = size
                elif extra[0] == 0x04:
                    notes.append('IM4P possui OCTET STRING auxiliar (possível KBAG); sem chave não há descriptografia.')
            return data[item[1]:item[2]], kind, expected
        if depth == 0:
            return None
        for item_tag, b, e in children:
            if item_tag == 0x30:
                found = visit(b, e, depth - 1)
                if found:
                    return found
        return None

    found = visit(begin, end, 5)
    if found is None:
        raise KernelFormatError('Contêiner DER encontrado, mas IM4P não localizado (variante não reconhecida).')
    payload, kind, expected = found
    return payload, kind, expected, notes


def _macos_lzfse(payload: bytes, expected: int | None = None) -> bytes:
    if sys.platform != 'darwin':
        raise KernelFormatError('LZFSE comprimido requer o framework Compression do macOS nesta versão.')
    name = ctypes.util.find_library('compression') or '/usr/lib/libcompression.dylib'
    try:
        lib = ctypes.CDLL(name)
    except OSError as exc:
        raise KernelFormatError('Framework Compression não está disponível.') from exc
    decode = lib.compression_decode_buffer
    decode.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p,
                       ctypes.c_size_t, ctypes.c_void_p, ctypes.c_int]
    decode.restype = ctypes.c_size_t
    scratch_fn = lib.compression_decode_scratch_buffer_size
    scratch_fn.argtypes = [ctypes.c_int]
    scratch_fn.restype = ctypes.c_size_t
    scratch = ctypes.create_string_buffer(max(1, scratch_fn(LZFSE_ALGORITHM)))
    src = ctypes.create_string_buffer(payload)
    size = expected if expected else min(MAX_DECODED, max(1024 * 1024, len(payload) * 3))
    while size <= MAX_DECODED:
        dst = ctypes.create_string_buffer(size)
        written = decode(dst, size, src, len(payload), scratch, LZFSE_ALGORITHM)
        if written and written < size:
            if expected and written != expected:
                raise KernelFormatError(f'LZFSE descomprimido com {written} bytes; esperado {expected}.')
            return dst.raw[:written]
        if expected:  # explicit output length should either match or fail
            if written == expected:
                return dst.raw[:written]
            break
        if written == size:  # possibly truncated, grow
            size *= 2
        else:
            break
    raise KernelFormatError('Não foi possível descomprimir LZFSE ou resultado excede limite.')


def _uncompressed_lzfse(payload: bytes) -> bytes | None:
    """Handle the standard bvx- blocks + bvx$ terminator without a decoder."""
    if not payload.startswith(b'bvx-'):
        return None
    i, out = 0, bytearray()
    while i + 4 <= len(payload):
        magic = payload[i:i+4]
        if magic == b'bvx$':
            return bytes(out)
        if magic != b'bvx-' or i + 8 > len(payload):
            return None  # compressed block: delegate to macOS native decoder
        n = struct.unpack_from('<I', payload, i + 4)[0]
        i += 8
        if n > MAX_DECODED - len(out) or i + n > len(payload):
            raise KernelFormatError('LZFSE sem compressão: comprimento inválido.')
        out.extend(payload[i:i+n])
        i += n
    raise KernelFormatError('LZFSE sem compressão: marcador final ausente.')


def _lzss_decompress(data: bytes, expected: int) -> bytes:
    """Traditional Okumura LZSS, 4096-byte window and 18-byte lookahead."""
    N, F, threshold = 4096, 18, 2
    buf = bytearray(b' ' * N)
    r = N - F
    out = bytearray()
    pos, flags = 0, 0
    while pos < len(data) and len(out) < expected:
        flags >>= 1
        if flags & 0x100 == 0:
            flags = data[pos] | 0xff00
            pos += 1
        if flags & 1:
            if pos >= len(data):
                break
            ch = data[pos]
            pos += 1
            out.append(ch)
            buf[r] = ch
            r = (r + 1) & (N - 1)
        else:
            if pos + 1 >= len(data):
                break
            i, j = data[pos], data[pos + 1]
            pos += 2
            i |= (j & 0xf0) << 4
            count = (j & 0x0f) + threshold + 1
            for k in range(count):
                if len(out) >= expected:
                    break
                ch = buf[(i + k) & (N - 1)]
                out.append(ch)
                buf[r] = ch
                r = (r + 1) & (N - 1)
    if len(out) != expected:
        raise KernelFormatError(f'LZSS: saída truncada ({len(out)} vs {expected}).')
    return bytes(out)


def _complzss(data: bytes) -> bytes:
    if len(data) < 0x180 or not data.startswith(b'complzss'):
        raise KernelFormatError('Header complzss truncado.')
    checksum, expected, compressed = struct.unpack_from('>III', data, 8)
    if expected == 0 or expected > MAX_DECODED:
        raise KernelFormatError('Tamanho LZSS anunciado inválido ou acima do limite.')
    if compressed > len(data) - 0x180:
        raise KernelFormatError('LZSS: tamanho comprimido maior que dados presentes.')
    result = _lzss_decompress(data[0x180:0x180 + compressed], expected)
    if zlib.adler32(result) & 0xffffffff != checksum:
        raise KernelFormatError('LZSS: checksum Adler32 não confere.')
    return result


def _select_fat_arm64(data: bytes) -> bytes:
    if len(data) < 8 or data[:4] not in (b'\xca\xfe\xba\xbe', b'\xbe\xba\xfe\xca',
                                         b'\xca\xfe\xba\xbf', b'\xbf\xba\xfe\xca'):
        return data
    magic = data[:4]
    endian = '>' if magic in (b'\xca\xfe\xba\xbe', b'\xca\xfe\xba\xbf') else '<'
    is_64 = magic in (b'\xca\xfe\xba\xbf', b'\xbf\xba\xfe\xca')
    count = struct.unpack_from(endian + 'I', data, 4)[0]
    size = 32 if is_64 else 20
    if count > 64 or len(data) < 8 + size * count:
        raise KernelFormatError('Mach-O FAT: tabela de arquitetura inválida.')
    for index in range(count):
        off = 8 + size * index
        cputype = struct.unpack_from(endian + 'I', data, off)[0]
        if cputype == CPU_TYPE_ARM64:
            offset, length = struct.unpack_from(endian + ('QQ' if is_64 else 'II'), data, off + 8)
            if offset + length > len(data) or length == 0:
                raise KernelFormatError('Mach-O FAT: fatia arm64 fora dos limites.')
            return data[offset:offset + length]
    raise KernelFormatError('Mach-O FAT não contém arquitetura arm64.')


def _unwrap(raw: bytes) -> tuple[bytes, str, list[str]]:
    data, desc, notes, expected = raw, 'Mach-O direto', [], None
    if data.startswith(b'\x30'):
        data, kind, expected, notes = _im4p_payload(data)
        desc = f'IM4P ({kind})'
    if data.startswith(b'complzss'):
        data = _complzss(data)
        desc += ' / complzss LZSS'
    elif data.startswith((b'bvx2', b'bvxn', b'bvx1', b'bvx-')):
        plain = _uncompressed_lzfse(data)
        data = plain if plain is not None else _macos_lzfse(data, expected)
        if expected and len(data) != expected:
            raise KernelFormatError('LZFSE: tamanho real diferente do informado pelo IM4P.')
        desc += ' / LZFSE'
    if data[:4] in (b'\xca\xfe\xba\xbe', b'\xbe\xba\xfe\xca',
                    b'\xca\xfe\xba\xbf', b'\xbf\xba\xfe\xca'):
        data = _select_fat_arm64(data)
        desc += ' / FAT arm64'
    if not data.startswith((MH_MAGIC_64, MH_CIGAM_64)):
        if notes and any('KBAG' in n for n in notes):
            raise KernelFormatError('Payload IM4P não decodificável; possível criptografia (KBAG presente). Chave de decriptação válida necessária.')
        raise KernelFormatError('Payload não é Mach-O: formato não reconhecido, ainda compactado ou criptografado. Sem chave válida não é possível extrair KEXTs.')
    return data, desc, notes


def _cstr(data: bytes, begin: int, end: int) -> str:
    if begin < 0 or end > len(data) or begin >= end:
        return ''
    stop = data.find(b'\0', begin, end)
    return data[begin:stop if stop >= 0 else end].decode('utf-8', 'replace')


def _load_plist(data: bytes, start: int, size: int) -> dict[str, Any] | None:
    if start < 0 or size <= 0 or size > 64 * 1024 * 1024 or start + size > len(data):
        return None
    fragment = data[start:start + size]
    # XML plist may be terminated by padding from Mach-O.
    for prefix in (b'<?xml', b'<plist', b'bplist00'):
        point = fragment.find(prefix)
        if point < 0:
            continue
        view = fragment[point:]
        if prefix != b'bplist00':
            suffix = view.find(b'</plist>')
            if suffix < 0:
                continue
            view = view[:suffix + 8]
        try:
            obj = plistlib.loads(view)
            if isinstance(obj, dict):
                return obj
        except (ValueError, TypeError, OverflowError, plistlib.InvalidFileException):
            pass
    return None


def _read_macho(data: bytes, start: int = 0) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    if start < 0 or start + 32 > len(data):
        raise KernelFormatError('Mach-O truncado.')
    magic = data[start:start + 4]
    if magic not in (MH_MAGIC_64, MH_CIGAM_64):
        raise KernelFormatError('Mach-O 64 bits: assinatura inválida.')
    endian = '<' if magic == MH_MAGIC_64 else '>'
    _, cpu, subtype, filetype, ncmds, sizeofcmds, flags, reserved = struct.unpack_from(endian + 'IiiIIIII', data, start)
    if ncmds > 150000 or sizeofcmds > len(data) - start - 32:
        raise KernelFormatError('Mach-O: comandos inválidos.')
    off, limit = start + 32, start + 32 + sizeofcmds
    entries, plists = [], []
    for _ in range(ncmds):
        if off + 8 > limit:
            raise KernelFormatError('Mach-O: comando incompleto.')
        cmd, length = struct.unpack_from(endian + 'II', data, off)
        if length < 8 or off + length > limit:
            raise KernelFormatError('Mach-O: tamanho de comando inválido.')
        if cmd in (LC_FILESET_ENTRY, 0x35) and length >= 32:
            vmaddr, fileoff, nameoff, _ = struct.unpack_from(endian + 'QQII', data, off + 8)
            name = _cstr(data, off + nameoff, off + length) if 32 <= nameoff < length else ''
            if name:
                entries.append({'name': name, 'offset': fileoff})
        if cmd == LC_SEGMENT_64 and length >= 72:
            _, _, segname, vmaddr, vmsize, fileoff, filesize, maxprot, initprot, nsects, sgflags = struct.unpack_from(endian + 'II16sQQQQiiII', data, off)
            segname = segname.rstrip(b'\0').decode('ascii', 'replace')
            if nsects <= 3000 and 72 + nsects * 80 <= length:
                for i in range(nsects):
                    p = off + 72 + i * 80
                    sectname, secseg, addr, size, relative, align, reloff, nreloc, flags, reserved1, reserved2, reserved3 = struct.unpack_from(endian + '16s16sQQIIIIIIII', data, p)
                    sectname = sectname.rstrip(b'\0').decode('ascii', 'replace')
                    secseg = secseg.rstrip(b'\0').decode('ascii', 'replace')
                    if (sectname not in ('__info', '__info_plist', '__plist')
                            and not (secseg == '__PRELINK_INFO' and sectname.startswith('__info'))):
                        continue
                    # Nested filesets can store section offsets relative to root or nested Mach-O.
                    for absolute in dict.fromkeys((relative, start + relative)):
                        plist = _load_plist(data, absolute, size)
                        if plist is not None:
                            plists.append(plist)
                            break
        off += length
    return entries, plists


def _kexts_from_plist(obj: dict[str, Any]) -> list[dict[str, Any]]:
    if '_PrelinkInfoDictionary' in obj:
        nodes = obj['_PrelinkInfoDictionary']
    elif 'Kexts' in obj and isinstance(obj['Kexts'], list):
        nodes = obj['Kexts']
    else:
        nodes = [obj]
    if not isinstance(nodes, list):
        return []
    result = []
    for item in nodes:
        if not isinstance(item, dict):
            continue
        identifier = item.get('CFBundleIdentifier') or item.get('BundleIdentifier')
        if not isinstance(identifier, str) or not identifier.strip():
            continue
        deps = item.get('OSBundleLibraries', {})
        personalities = item.get('IOKitPersonalities', {})
        # Preserve somente regras textuais explícitas; não inferir correspondência
        # a partir do nome da KEXT ou de um IOKit personality label.
        match_rules = {}
        if isinstance(personalities,dict):
            for pname,pdata in personalities.items():
                if not isinstance(pdata,dict):continue
                rules={}
                for key in ('IONameMatch','IONameMatched','IOProviderClass','IOClass'):
                    val=pdata.get(key)
                    if isinstance(val,str):rules[key]=[val[:256]]
                    elif isinstance(val,list):rules[key]=[x[:256] for x in val if isinstance(x,str)][:32]
                rawprops=pdata.get('IOPropertyMatch',{})
                if isinstance(rawprops,dict):
                    rules['IOPropertyMatch']={str(k):v[:32] if isinstance(v,list) else v
                                             for k,v in rawprops.items()
                                             if isinstance(v,str) or (isinstance(v,list) and
                                             all(isinstance(x,str) for x in v))}
                if rules:match_rules[str(pname)]=rules
        result.append({
            'id': identifier,
            'version': str(item.get('CFBundleVersion', 'desconhecida')),
            'dependencies': {str(k): str(v) for k, v in deps.items()} if isinstance(deps, dict) else {},
            'io_kit_personalities': sorted(map(str, personalities)) if isinstance(personalities, dict) else [],
            'personality_matching':match_rules,
            'origin_metadata': 'plist'
        })
    return result


def parse_kernel_bytes(raw: bytes) -> KernelInventory:
    if len(raw) > MAX_INPUT:
        raise KernelFormatError('Kernelcache excede 768 MiB.')
    data, fmt, notes = _unwrap(raw)
    entries, plists = _read_macho(data)
    found: dict[str, dict[str, Any]] = {}
    for plist in plists:
        for row in _kexts_from_plist(plist):
            found[row['id']] = row
    # Metadata in the main file alone may be enough on legacy prelinked caches.
    entry_offsets = sorted(set(int(e['offset']) for e in entries if isinstance(e['offset'], int) and e['offset'] >= 0))
    nested_read, nested_errors, hashes = 0, 0, 0
    for item in entries:
        name, offset = item['name'], int(item['offset'])
        if offset <= 0 or offset + 32 > len(data):
            nested_errors += 1
            continue
        if name.startswith(('com.apple.', 'org.')) and name != 'com.apple.kernel':
            found.setdefault(name, {
                'id': name, 'version': 'desconhecida', 'dependencies': {},
                'io_kit_personalities': [], 'origin_metadata': 'fileset-entry'
            })
        try:
            nested_entries, nested_plists = _read_macho(data, offset)
            nested_read += 1
        except KernelFormatError:
            nested_errors += 1
            continue
        for plist in nested_plists:
            for row in _kexts_from_plist(plist):
                found[row['id']] = row
        # Region hash is NOT hash of an extracted, independently relocatable kext.
        if name in found:
            next_pos = next((x for x in entry_offsets if x > offset), len(data))
            if next_pos > offset:
                found[name]['fileset_region_sha256'] = hashlib.sha256(data[offset:next_pos]).hexdigest()
                hashes += 1
    if entries:
        notes.append(f'{len(entries)} entradas LC_FILESET_ENTRY; {nested_read} Mach-O internos reconhecidos.')
    if nested_errors:
        notes.append(f'{nested_errors} entradas internas não decodificadas; inventário pode estar incompleto.')
    if plists:
        notes.append(f'{len(plists)} plists de metadados encontrados no Mach-O principal.')
    notes.append('KEXTs apresentadas são evidências localizadas; nunca garantem inventário completo ou compatibilidade de ABI.')
    if hashes:
        notes.append('Hash SHA-256 identifica a região do fileset, NÃO um arquivo .kext independente.')
    if not found:
        notes.append('Nenhuma KEXT identificada. A ausência de resultados NÃO significa ausência de drivers.')
    return KernelInventory(
        format=fmt, kexts=[found[k] for k in sorted(found)], notes=notes,
        coverage='parcial' if nested_errors or not found or entries else 'metadados expostos',
        file_entries=len(entries)
    )


def parse_kernel_file(path: str | Path) -> KernelInventory:
    file = Path(path).expanduser().resolve()
    if not file.is_file():
        raise KernelFormatError('Kernelcache não encontrado.')
    if file.stat().st_size > MAX_INPUT:
        raise KernelFormatError('Kernelcache maior que 768 MiB.')
    return parse_kernel_bytes(file.read_bytes())


def export_fileset_regions(kernel_path: str | Path, directory: str | Path) -> tuple[Path, list[dict[str, Any]]]:
    """Export Mach-O fileset regions for research, NOT loadable .kext bundles.

    Regions are cut from each LC_FILESET_ENTRY fileoff to the next entry's
    fileoff (or EOF), including any intervening alignment/padding.
    No signatures, binaries, or firmware are modified.
    """
    import json
    import re

    file = Path(kernel_path).expanduser().resolve()
    if not file.is_file() or file.stat().st_size > MAX_INPUT:
        raise KernelFormatError('Kernelcache ausente ou tamanho maior que o limite.')
    raw = file.read_bytes()
    data, fmt, _ = _unwrap(raw)
    entries, _ = _read_macho(data)
    if not entries:
        raise KernelFormatError('Não há LC_FILESET_ENTRY; não é possível separar imagens fileset.')
    chosen = sorted((e for e in entries if isinstance(e.get('offset'), int)),
                    key=lambda e: e['offset'])
    starts = sorted(set(e['offset'] for e in chosen if 0 < e['offset'] < len(data)))
    folder = Path(directory).expanduser().resolve()
    folder.mkdir(parents=True, exist_ok=True)
    report: list[dict[str, Any]] = []
    for e in chosen:
        start = e['offset']
        if start <= 0 or start >= len(data) - 32:
            continue
        stop = next((x for x in starts if x > start), len(data))
        if stop <= start:
            continue
        try:
            _read_macho(data, start)
        except KernelFormatError:
            continue
        region = data[start:stop]
        digest = hashlib.sha256(region).hexdigest()
        label = re.sub(r'[^A-Za-z0-9._-]', '_', e['name'])[:110]
        name = f'{label}-{digest[:12]}.macho.bin'
        destination = folder / name
        # Avoid overwriting previously extracted data, allowing identical re-runs.
        if destination.exists():
            if destination.stat().st_size != len(region) or hashlib.sha256(destination.read_bytes()).hexdigest() != digest:
                raise KernelFormatError('Arquivo existente com o mesmo nome, mas conteúdo diferente: ' + str(destination))
        else:
            with destination.open('xb') as out:
                out.write(region)
        report.append({'id': e['name'], 'file': name,
                       'offset': start, 'length': len(region),
                       'region_sha256': digest,
                       'warning': 'Região de fileset; pode incluir padding e não é KEXT independente.'})
    if not report:
        raise KernelFormatError('Nenhuma região Mach-O reconhecível foi encontrada nas entradas fileset.')
    manifest = folder / 'fileset_regions_manifest.json'
    manifest.write_text(json.dumps({
        'source': str(file), 'format': fmt,
        'warning': 'Trechos do kernelcache para análise, não binários instaláveis nem reconstruções independentes.',
        'entries': report,
    }, ensure_ascii=False, indent=2), encoding='utf-8')
    return manifest, report



def _v011_run(self):
    ensure_home()
    while True:
        try:
            self.show()
            option=input(Style.CYAN+' Número > '+Style.RESET).strip()
            if option=='0':
                print(' IOSLA encerrado.')
                break
            if option in ('1','2','5'):
                label={'1':'ORIGEM','2':'DESTINO','5':'CONTROLE'}[option]
                self.load(label)
                self.v011_results=None
                if label=='CONTROLE' and label in self.inputs:
                    meta=self.inputs[label]['meta']
                    if not str(meta.get('ios_version','')).startswith('18.'):
                        print(' [AVISO] Controle diferente de iOS 18; comparação com ressalvas.')
                continue

def _v012_llvm_validation()->dict:
    """Opt-in independent assembly/disassembly check; never processes firmware."""
    clang=shutil.which('clang');llvm=shutil.which('llvm-objdump')
    if not clang or not llvm:
        return {'state':'unavailable','clang':bool(clang),'llvm_objdump':bool(llvm),
                'reason':'Ferramentas opcionais ausentes; autotestes de opcode permanecem disponíveis.'}
    asm='''\n.text\n.p2align 2\n.global _iosla_fixture\n_iosla_fixture:\n blraa x3,x4\n blrab x3,x4\n braa x3,x4\n brab x3,x4\n blraaz x3\n blrabz x3\n braaz x3\n brabz x3\n blr x3\n br x3\n ret\n paciasp\n autiasp\n retab\n retaa\n pacia x0,x1\n autia x0,x1\n xpaci x0\n'''
    with tempfile.TemporaryDirectory(prefix='iosla012_llvm_') as td:
        a=Path(td)/'fixture.s';o=Path(td)/'fixture.o';a.write_text(asm)
        p=subprocess.run([clang,'-target','aarch64-apple-macos11','-march=armv8.3-a',
                          '-c',str(a),'-o',str(o)],capture_output=True,text=True,timeout=25)
        if p.returncode:
            return {'state':'unavailable','reason':p.stderr[-450:]}
        dis=subprocess.run([llvm,'-d',str(o)],capture_output=True,text=True,timeout=25)
        if dis.returncode:
            return {'state':'unavailable','reason':dis.stderr[-450:]}
        import re as _re
        parsed=_re.findall(r'^\s*[0-9a-f]+:\s+([0-9a-f]{8})\s+([a-z][a-z0-9]*)',dis.stdout,_re.M|_re.I)
        observed=[(_v012_decode(int(w,16))['mnemonic'].lower(),m.lower()) for w,m in parsed]
        discrepancies=[{'iosla':a,'llvm':b} for a,b in observed if a!=b]
        return {'state':'concordante' if len(observed)==18 and not discrepancies else 'divergente',
                'checked':len(observed),'expected':18,'discrepancies':discrepancies,
                'note':'Apenas 18 instruções de fixture, não todos os opcodes ARM64e.'}



def _v014_compare_semantics(results:dict,contextual:dict,cont:dict)->dict:
    src=results.get('ORIGEM',{}).get('images',{})
    dst=results.get('DESTINO',{}).get('images',{})
    srcidx={lib:{f['vmaddr']:f for f in src.get(lib,{}).get('functions',[])} for lib in V011_TARGET_LIBRARIES}
    dstidx={lib:{f['vmaddr']:f for f in dst.get(lib,{}).get('functions',[])} for lib in V011_TARGET_LIBRARIES}
    ctx={(x.get('library'),x.get('function_origin')):x for x in contextual.get('targets',[])}
    stats=Counter();rows=[]
    for row in cont.get('targets',[])[:V014_TARGET_ROWS]:
        lib=row['library'];addr=row['origin_target_function'];source=srcidx.get(lib,{}).get(addr)
        match=row.get('a_to_c',{});candidates=match.get('candidates',[])
        chosen=None;method=None

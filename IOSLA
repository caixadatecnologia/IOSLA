    _,sec=selected
    mapping=sec.get('file_mapping',{})
    if mapping.get('state')!='resolvido':return obj
    base=sec.get('vmaddr');off=mapping.get('offset');fail=0;insns=0
    for f in obj.get('functions',[]):
        try:
            addr=int(f['vmaddr'],16);count=min(int(f['instructions_scanned']),V014_MAX_FUNCTION_INSNS)
            start=off+addr-base
            if count<0 or not _v009_within(start,4*count,len(data)):

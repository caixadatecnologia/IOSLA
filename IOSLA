# Reports are COPIED, not modified. Nothing here patches or flashes firmware.

ICORE_SCHEMA = 'icore-evidence/1.0'
ICORE_EXPORT_ROOT_NAME = 'iCore evidence'
ICORE_SINGLE_FILE_CAP = 96 * 1024 * 1024
ICORE_TOTAL_FILE_CAP = 384 * 1024 * 1024
ICORE_MAX_DRIVERS_PER_FIRMWARE = 500
ICORE_MAX_TARGET_ROWS = 5000
ICORE_COPY_CHUNK = 1024 * 1024


def _icore_sha256(file:Path)->str:
    digest=hashlib.sha256()
    with file.open('rb') as stream:
        for block in iter(lambda:stream.read(ICORE_COPY_CHUNK),b''):
            digest.update(block)
    return digest.hexdigest()


def _icore_write_json(path:Path,data:dict)->None:
    path.parent.mkdir(parents=True,exist_ok=True)
    path.write_text(json.dumps(data,ensure_ascii=False,indent=2,default=str)+'\n',encoding='utf-8')


def _icore_meta_dict(meta:dict)->dict:
    return {
        'ios_version':meta.get('ios_version'), 'build':meta.get('build'),
        'devices':meta.get('devices',[])[:16],
        'kernelcache_references':meta.get('kernel_references',[])[:32],
        'declared_components_count':len(meta.get('component_names') or []),
        'metadata_state':'from_local_ipsw_manifest' if meta else 'not_available',
    }


def _icore_report_type(name:str)->str:
    name=Path(name).name
    stem=Path(name).stem
    if stem.startswith('IOSLA_'):
        stem=stem[len('IOSLA_'):]
    return re.sub(r'_\d{8}_\d{6}_\d{6}$','',stem)


def _icore_safe_copy(src:Path,destination:Path)->str:
    """Copy with streaming hashes; source is only a locally recorded output file."""
    hasher=hashlib.sha256()
    with src.open('rb') as r, destination.open('xb') as w:
        for chunk in iter(lambda:r.read(ICORE_COPY_CHUNK),b''):
            w.write(chunk);hasher.update(chunk)
    return hasher.hexdigest()


def _icore_export(*,outputs:list[Path],inputs:dict|None=None,snapshots:dict|None=None,
                  analysis:dict|None=None,diagnostic:dict|None=None,
                  root:Path|None=None,stamp:str|None=None,
                  logs_dir:Path|None=None)->Path:
    """Immutable iCore evidence bundle. Operates on this session's source outputs only.

    No attempt is made to infer boot compatibility, recover full ABI or synthesize patches.
    If reports are missing, the importer receives explicit missing/partial statuses.
    """
    base=Path(root) if root is not None else HOME_DIR/ICORE_EXPORT_ROOT_NAME
    base.mkdir(parents=True,exist_ok=True)
    now=datetime.now(timezone.utc).isoformat()
    moment=stamp or datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    folder=base/('bundle_'+safe_name(moment,64))
    folder.mkdir(exist_ok=False)
    report_root=folder/'relatorios';report_root.mkdir()
    inventories=folder/'inventarios';inventories.mkdir()
    inputs=inputs or {};snapshots=snapshots or {};analysis=analysis or {}
    diagnostic=diagnostic or {}
    # Filenames come only from this run's generated paths. Do not search historical
    # folders and accidentally combine reports from unrelated builds.
    files=[];skipped=[];used=set();bytes_copied=0
    unique=[]
    for v in outputs:
        p=Path(v)
        if p not in unique:unique.append(p)
    for src in unique:
        try:
            if not src.is_file():
                skipped.append({'source':str(src),'reason':'not_available'});continue
            if src.suffix.lower() not in ('.json','.md','.sqlite','.html'):
                skipped.append({'source':str(src),'reason':'unsupported_extension'});continue
            if not (src.name.startswith('IOSLA_') or src.name=='iosla_v016_research.sqlite'):
                skipped.append({'source':str(src),'reason':'not_iosla_report'});continue
            sz=src.stat().st_size
            if sz>ICORE_SINGLE_FILE_CAP or sz+bytes_copied>ICORE_TOTAL_FILE_CAP:
                skipped.append({'source':str(src),'size_bytes':sz,'reason':'export_size_cap'});continue
            if src.name in used:
                skipped.append({'source':str(src),'reason':'duplicate_filename'});continue
            used.add(src.name)
            out=report_root/src.name
            sha=_icore_safe_copy(src,out)
            files.append({'relative_path':out.relative_to(folder).as_posix(),
                'type':_icore_report_type(src.name),'format':src.suffix.lstrip('.'),
                'size_bytes':sz,'sha256':sha,'source':str(src)})
            bytes_copied+=sz
        except OSError as exc:
            skipped.append({'source':str(src),'reason':'read_failed','error':str(exc)})
    # Build machine-readable records using the authoritative in-memory snapshots.
    fw={};drivers={};missing=[];kernel_files=[]
    for label in ('ORIGEM','CONTROLE','DESTINO'):
        item=inputs.get(label,{});meta=item.get('meta',{})
        snap=snapshots.get(label)
        if not item and not snap and label not in analysis:
            fw[label]={'state':'not_provided'}
            if label!='CONTROLE':missing.append('firmware_'+label.lower())
            continue
        p=Path(item['path']) if item.get('path') else None
        snap_kernel=Path(snap.kernel_path) if snap and getattr(snap,'kernel_path',None) else None
        cache_info={'path':str(snap_kernel) if snap_kernel else None,
            'size_bytes':snap_kernel.stat().st_size if snap_kernel and snap_kernel.is_file() else None,
            'sha256':None,'hash_status':'not_available','copied':False}
        if snap_kernel and snap_kernel.is_file():
            size=snap_kernel.stat().st_size
            if size<=300*1024*1024:
                cache_dir=folder/'kernelcaches';cache_dir.mkdir(exist_ok=True)
                dst=cache_dir/(label.lower()+'_'+safe_name(snap_kernel.name,90))
                sha=_icore_safe_copy(snap_kernel,dst)
                cache_info.update({'sha256':sha,'hash_status':'calculated',
                    'copied':True,'relative_path':dst.relative_to(folder).as_posix()})
                kernel_files.append({'relative_path':cache_info['relative_path'],
                    'sha256':sha,'size_bytes':size,'firmware':label})
            else:
                cache_info['hash_status']='copy_skipped_300MiB_limit'
                missing.append('kernelcache_copy_skipped_'+label.lower())
        else:
            missing.append('kernelcache_'+label.lower())
        obj={'state':'provided' if item else 'kernel_analysis_only',
            'metadata':_icore_meta_dict(meta),
            'analysis_index_available':label in analysis,
            'source_ipsw':{'path':str(p) if p else None,
                'size_bytes':p.stat().st_size if p and p.is_file() else None,
                'sha256':None,'hash_status':'not_calculated_avoids_large_ipsw_read'},
            'kernelcache':cache_info}
        if snap:
            obj['kernel_inventory_coverage']=getattr(snap,'coverage',None)
        fw[label]=obj
        if not snap:
            drivers[label]={'state':'unavailable','entries':[],'total':None}
            missing.append('kext_inventory_'+label.lower())
        else:
            entries=[]
            for identifier,driver in list(snap.kexts.items())[:ICORE_MAX_DRIVERS_PER_FIRMWARE]:
                entries.append({'identifier':identifier,'version':driver.version,
                    'dependencies':driver.dependencies,'personalities':driver.personalities,
                    'matching_rules':driver.personality_matching,
                    'region_sha256':driver.region_sha256,
                    'provenance':driver.provenance})
            drivers[label]={'state':'observed_partial','entries':entries,'total':len(snap.kexts),
                'truncated':len(snap.kexts)>len(entries),
                'note':'Inventário estático de KEXTs; não é prova de vinculação em runtime.'}
    _icore_write_json(inventories/'firmwares.json',{'schema':ICORE_SCHEMA,'firmwares':fw})
    _icore_write_json(inventories/'drivers_dependencies.json',{'schema':ICORE_SCHEMA,'firmwares':drivers})
    # Expose the contract and per-function observations in normalized, traceable form.
    reports_by_type={}
    for f in files:
        reports_by_type.setdefault(f['type'],[]).append(f['relative_path'])
    # Only parse COPIED records, not arbitrary earlier files on disk.
    def read_record(typ:str)->dict|None:
        candidates=[f for f in files if f['type']==typ and f['format']=='json']
        if not candidates:return None
        chosen=candidates[-1]
        try:
            if chosen['size_bytes']>ICORE_SINGLE_FILE_CAP:return None
            o=json.loads((folder/chosen['relative_path']).read_text(encoding='utf-8'))
            return o if isinstance(o,dict) else None
        except (OSError,ValueError,UnicodeError):return None
    abi=read_record('V016_ABI_CONTRACTS') or {}
    cont=read_record('ABI_CONTINUITY') or {}
    validated=[]
    for x in abi.get('targets',[])[:ICORE_MAX_TARGET_ROWS]:
        validated.append({'library':x.get('library'),
            'origin_function':x.get('origin_function'),
            'candidate_function':x.get('destination_candidate'),
            'observed_state':x.get('contract_evidence_state'),
            'structural_state':x.get('structural_state'),
            'calls_from_origin_driver':x.get('calls'),
            'source_report':reports_by_type.get('V016_ABI_CONTRACTS',[]),
            'abi_equivalent':None,'patch_validated':False})
    _icore_write_json(inventories/'interface_evidence.json',{
        'schema':ICORE_SCHEMA,'state':'partial_observations' if abi else 'not_available',
        'observations':validated,'total_observations_in_source':len(abi.get('targets',[])),
        'source_truncated':len(abi.get('targets',[]))>len(validated),
        'continuity_summary':cont.get('summary'),
        'note':'Semelhança estrutural ou CFG não comprova ABI, execução ou patch.'})
    audit=read_record('V016_VALIDATION_RESULTS') or {}
    ptr=read_record('V016_MACHO_REFERENCES') or {}
    hw=read_record('V016_HARDWARE_DEPENDENCIES') or {}
    _icore_write_json(inventories/'coverage_and_gaps.json',{
        'schema':ICORE_SCHEMA,
        'analysis_index_firmwares':sorted(analysis),
        'validation_summary':audit.get('summary'),
        'mach_o_reference_summary':ptr.get('summary'),
        'hardware_dependency_summary':hw.get('summary'),
        'missing_inputs':missing,
        'limitations':[
            'Resultados de ABI/CFG/Dataflow são estáticos, parciais e limitados.',
            'Sem prova de suporte de hardware, protocolo GPU ou inicialização.',
            'Logs de falha reais não coletados pelo IOSLA automaticamente.',
            'Nenhuma correção testada ou validada é fornecida neste pacote.'
        ]})
    # Only collect files explicitly placed by the user in the dedicated local inbox.
    # Never search the system for logs and never interpret matches as root causes.
    log_inbox=Path(logs_dir) if logs_dir is not None else HOME_DIR/'iCore inputs'/'logs'
    log_inbox.mkdir(parents=True,exist_ok=True)
    notice=log_inbox.parent/'LEIA-ME.txt'
    if not notice.exists():
        notice.write_text(
           'Opcional: coloque logs próprios (.ips, .log, .txt, .json, .panic) na pasta logs/ '
           'e pressione [9] novamente. Os arquivos serão COPIADOS localmente para '
           'iCore evidence. Revise dados pessoais antes de compartilhar o pacote.\n',encoding='utf-8')
    imported_logs=[];logs_skipped=[];log_bytes=0
    permitted={'.ips','.log','.txt','.json','.panic'}
    log_target=folder/'logs'
    for log_file in sorted(log_inbox.iterdir()):
        if log_file.is_symlink() or not log_file.is_file() or log_file.suffix.lower() not in permitted:
            continue
        try:
            size=log_file.stat().st_size
            if size>8*1024*1024 or log_bytes+size>32*1024*1024 or len(imported_logs)>=20:
                logs_skipped.append({'name':log_file.name,'reason':'log_limit'});continue
            log_target.mkdir(exist_ok=True)
            dest=log_target/log_file.name
            sha=_icore_safe_copy(log_file,dest)
            imported_logs.append({'relative_path':dest.relative_to(folder).as_posix(),
                'source':str(log_file),'sha256':sha,'size_bytes':size,
                'verification':'provided_by_user_not_authenticated'})
            log_bytes+=size
        except OSError as exc:
            logs_skipped.append({'name':log_file.name,'reason':type(exc).__name__})
    _icore_write_json(inventories/'failure_logs.json',{
        'schema':ICORE_SCHEMA,
        'state':'provided_unverified' if imported_logs else 'not_provided',
        'logs':imported_logs,'skipped':logs_skipped,
        'interpretation':'Raw diagnostic logs only; no attribution of cause or validated correction.'})
    _icore_write_json(inventories/'validated_fixes.json',{
        'schema':ICORE_SCHEMA,'state':'none_provided','cases':[],
        'note':'Sem correções comprovadas. Não inferir patch a partir de fingerprints.'})
    _icore_write_json(inventories/'hypotheses.json',{
        'schema':ICORE_SCHEMA,'state':'not_executable',
        'source_reports':reports_by_type.get('V016_HYPOTHESIS_VALIDATION',[]) + reports_by_type.get('V015_RESEARCH_PRIORITIES',[]),
        'patches':[], 'note':'Propostas, quando presentes em relatórios, são pesquisa e não patches aplicáveis.'})
    expected={
        'firmware_and_kernel':['RESUMO','MANIFESTOS'],
        'driver_inventory':['KEXT','PORTABILIDADE'],
        'devicetree_iokit':['DEVICETREE','EVIDENCIAS'],
        'abi_call_targets':['CALL_TARGETS','ABI_CONTINUITY','V016_ABI_CONTRACTS'],
        'cfg_dataflow':['V016_CONTROL_FLOW','V016_DATAFLOW','V016_VALIDATION_RESULTS'],
        'macho':['V016_MACHO_REFERENCES'],
        'gpu_firmware':['GPU_FIRMWARE','GPU_FIRMWARE_STATIC'],
        'hardware':['V016_HARDWARE_DEPENDENCIES','A12_HARDWARE_ATLAS'],
    }
    availability={k:{'found':[t for t in v if t in reports_by_type],
                     'missing':[t for t in v if t not in reports_by_type]}
                  for k,v in expected.items()}
    if any(v['missing'] for v in availability.values()):
        missing.append('some_analysis_reports')
    manifest={
        'schema':ICORE_SCHEMA,'iosla_version':APP_VERSION,'created_at':now,
        'bundle_id':folder.name,'generator':'IOSLA iCore relatório [9]',
        'mode':'offline_static_analysis_read_only',
        'input_provenance':'current_terminal_session_only',
        'execution_diagnostics':diagnostic,
        'firmwares':{k:{'state':v.get('state'),'metadata':v.get('metadata',{})} for k,v in fw.items()},
        'available_report_types':sorted(reports_by_type),
        'report_type_paths':reports_by_type,
        'coverage_by_category':availability,
        'files':files,'skipped_files':skipped,
        'copied_report_bytes':bytes_copied,
        'normalized_inventory_files':[],
        'kernelcache_files':kernel_files,
        'imported_logs':imported_logs,'skipped_logs':logs_skipped,
        'missing_evidence':sorted(set(missing+(['real_failure_logs'] if not imported_logs else []))),
        'compatibility_abi_proven':False,'boot_or_driver_execution_verified':False,
        'validated_patch_count':0,
        'interpretation':'Evidence package for iCore. A structural candidate is not an ABI or runtime proof.'
    }
    for file in sorted(inventories.iterdir()):
        manifest['normalized_inventory_files'].append({
            'relative_path':file.relative_to(folder).as_posix(),
            'sha256':_icore_sha256(file),'size_bytes':file.stat().st_size})
    manifest_path=folder/'manifest.json';_icore_write_json(manifest_path,manifest)
    (folder/'manifest.sha256').write_text(_icore_sha256(manifest_path)+'  manifest.json\n',encoding='utf-8')
    (folder/'LEIA-ME.txt').write_text(
        'iCore evidence — IOSLA '+APP_VERSION+'\n\n'
        'Abra manifest.json (schema '+ICORE_SCHEMA+').\n'
        'Os arquivos em relatorios/ são cópias das saídas IOSLA desta execução.\n'
        'inventarios/ contém dados estruturados para importação pelo iCore.\n'
        'kernelcaches/ contém cópias dos kernelcaches disponíveis (até 300 MiB por arquivo).\n'
        'logs/ contém somente arquivos colocados voluntariamente em iCore inputs/logs/.\n'
        'Confira sha256 e cobertura antes de usar; inventários podem ser parciais.\n'
        'Não há patches, correções validadas nem garantia de compatibilidade.\n',encoding='utf-8')
    # Latest pointer is informational and atomically replaced. Existing bundles persist.
    latest=base/'LATEST.json'; temporary=base/'LATEST.tmp'
    _icore_write_json(temporary,{'schema':ICORE_SCHEMA,'bundle_id':folder.name,
        'manifest_path':folder.name+'/manifest.json','created_at':now,
        'manifest_sha256':_icore_sha256(manifest_path)})
    temporary.replace(latest)
    return folder


def _v017_icore_report(self)->Path|None:
    if self.last_summary is None or 'ORIGEM' not in self.inputs or 'DESTINO' not in self.inputs:
        print(' [iCore] Selecione [1] e [2] e execute [3] antes de gerar o relatório.')
        return None
    if not self.generated:
        print(' [iCore] Nenhum relatório desta sessão; execute [3] primeiro.')
        return None
    print(' [iCore] Exportando evidências da análise atual...')
    directory=_icore_export(
        outputs=self.generated,inputs=self.inputs,snapshots=self.snapshots,
        analysis=getattr(self,'v011_results',None),
        diagnostic={'summary_generated_at':self.last_summary.get('generated_at'),
                    'v011_errors':getattr(self,'v011_errors',{}),
                    'analysis_status':self.last_summary.get('kernel_and_kext_analysis')})
    print(' [iCore] Pasta criada:',directory)
    print(' [iCore] Manifesto:',directory/'manifest.json')
    print(' [iCore] Evidências parciais; nenhum patch gerado.')
    return directory


_v017_show_prev=Terminal.show

def _v017_show(self)->None:
    _v017_show_prev(self)
Terminal.show=_v017_show


def _v017_run(self)->None:
    ensure_home()
    while True:
        try:
            self.show()
            opt=input(Style.CYAN+' Número > '+Style.RESET).strip()
            if opt=='0':print(' IOSLA encerrado.');return
            if opt in ('1','2','5'):
                label={'1':'ORIGEM','2':'DESTINO','5':'CONTROLE'}[opt]
                self.load(label);self.v011_results=None
            elif opt=='3':self.analyze()
            elif opt=='4':self.results()
            elif opt=='6':_v008_deep_interactive(self)
            elif opt in ('7','8'):
                if opt=='8':print(' [INFO] [8] é o atalho legado de [7].')
                _v012_unified_lab(self,reuse=True)
            elif opt=='9':_v017_icore_report(self)
            else:print(' [AVISO] Escolha 0 a 7 ou 9. [8] é atalho legado.')
        except (EOFError,KeyboardInterrupt):print('\n IOSLA encerrado.');return
        except (IOSLAError,KernelFormatError,OSError,ValueError,zipfile.BadZipFile,
                sqlite3.Error,TypeError,KeyError) as exc:
            print(Style.RED+' [ERRO] '+str(exc)+Style.RESET)
Terminal.run=_v017_run


def _v017_self_test()->None:
    with tempfile.TemporaryDirectory(prefix='iosla017_') as td:
        root=Path(td)
        reports=root/'produced';reports.mkdir()
        s1=reports/'IOSLA_V016_ABI_CONTRACTS_20261013_113000_100001.json'
        s2=reports/'IOSLA_V016_VALIDATION_RESULTS_20261013_113000_100002.json'
        s3=reports/'IOSLA_ABI_CONTINUITY_20261013_113000_100003.json'
        s4=reports/'IOSLA_V016_MACHO_REFERENCES_20261013_113000_100004.json'
        s5=reports/'IOSLA_KEXT_20261013_113000_100005.json'
        _icore_write_json(s1,{'targets':[{'library':'com.example.IOGPU',
            'origin_function':'0x1000','destination_candidate':'0x2000',
            'contract_evidence_state':'limited_observations_equal',
            'structural_state':'estrutura_candidata_unica','calls':2}]})
        _icore_write_json(s2,{'summary':{'coverage_complete':False}})
        _icore_write_json(s3,{'summary':{'targets_identified':1}})
        _icore_write_json(s4,{'summary':{'totals':{'exact_executable_pointers':7}}})
        _icore_write_json(s5,{'summary':{'same':2}})
        small_kernel=root/'synthetic_kernelcache'
        small_kernel.write_bytes(struct.pack('<II',0xfeedfacf,0x1234))
        snaps={'ORIGEM':Snapshot('ORIGEM',str(root),'test',
             {'com.example.GPU':Kext('com.example.GPU','1.0',
             {'com.example.IOGPU':'1.0'})},kernel_path=str(small_kernel),coverage='synthetic_only')}
        test_logs=root/'iCore inputs'/'logs'
        test_logs.mkdir(parents=True,exist_ok=True)
        (test_logs/'synthetic-crash.log').write_text('TEST ONLY: simulated error',encoding='utf-8')
        a=_icore_export(outputs=[s1,s2,s3,s4,s5],inputs={
            'ORIGEM':{'meta':{'ios_version':'18.TEST','build':'22T1','devices':['iPhone11,2']}},
            'DESTINO':{'meta':{'ios_version':'27.TEST','build':'24T1','devices':['iPhone12,1']}}},
            snapshots=snaps,root=root/'iCore evidence',stamp='test1',logs_dir=root/'iCore inputs'/'logs')
        b=_icore_export(outputs=[s1,s2,s3,s4,s5],inputs={},root=root/'iCore evidence',stamp='test2',logs_dir=root/'iCore inputs'/'logs')
        assert a!=b and a.exists() and b.exists()
        manifest=json.loads((a/'manifest.json').read_text())
        assert manifest['schema']==ICORE_SCHEMA and manifest['iosla_version']==APP_VERSION
        assert len(manifest['files'])==5
        assert len(manifest['kernelcache_files'])==1
        assert _icore_sha256(a/manifest['kernelcache_files'][0]['relative_path'])==manifest['kernelcache_files'][0]['sha256']
        assert len(manifest['imported_logs'])==1
        assert _icore_sha256(a/manifest['imported_logs'][0]['relative_path'])==manifest['imported_logs'][0]['sha256']
        assert manifest['coverage_by_category']['macho']['found']==['V016_MACHO_REFERENCES']
        assert manifest['validated_patch_count']==0 and not manifest['compatibility_abi_proven']
        assert 'failure_logs' in [p.stem for p in (a/'inventarios').glob('*.json')]
        rows=json.loads((a/'inventarios'/'interface_evidence.json').read_text())
        assert rows['observations'][0]['abi_equivalent'] is None
        assert rows['observations'][0]['patch_validated'] is False
        for f in manifest['files']+manifest['normalized_inventory_files']:
            assert _icore_sha256(a/f['relative_path'])==f['sha256']
        latest=json.loads((root/'iCore evidence'/'LATEST.json').read_text())
        assert latest['bundle_id']==b.name
        assert latest['manifest_sha256']==_icore_sha256(b/'manifest.json')
        # Sources are never modified by export.
        assert json.loads(s1.read_text())['targets'][0]['origin_function']=='0x1000'
        # A missing optional file never turns into an observed zero.
        gap=json.loads((a/'inventarios'/'coverage_and_gaps.json').read_text())
        assert 'kext_inventory_destino' in gap['missing_inputs']
        assert json.loads((a/'inventarios'/'failure_logs.json').read_text())['state']=='provided_unverified'
        # Menu [9] is registered and does not silently reuse historical reports.
        term=Terminal()
        assert _v017_icore_report(term) is None
    print('IOSLA v0.0.17 — iCore relatório, integridade e ausência de inferências: OK.')



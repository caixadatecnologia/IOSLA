def _v014_validation(results:dict,ptr:dict,semantic:dict,atlas:dict)->dict:
    issues=[];count=0
    for label,sc in results.items():
        for name,img in sc.get('images',{}).items():
            for fn in img.get('functions',[]):
                if 'v014_semantics' not in fn:continue
                count+=1
                s=fn['v014_semantics']
                if s['instruction_count']!=fn.get('instructions_scanned'):
                    issues.append({'firmware':label,'image':name,'function':fn['vmaddr'],
                       'issue':'instruction_count_mismatch'})
                if sum(r['count'] for r in s['memory_patterns'])>s['instruction_count']:
                    issues.append({'firmware':label,'image':name,'function':fn['vmaddr'],
                       'issue':'memory_count_exceeds_instructions'})
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
       'mode':'auditoria de consistencia de evidencias, sem validação ABI',
       'summary':{'functions_checked':count,'inconsistencies_found':len(issues),
                  'pointer_images_audited':len(ptr['images']),
                  'semantic_targets':semantic['summary']['targets'],
                  'hardware_subsystems':atlas['summary']['subsystems']},
       'issues':issues[:100],
       'limitations':['Verificacao de consistencia nao substitui comparacao independente de instrucoes.',
                      'Ausencia de inconsistencias nao confirma exatidao dos dados.']}



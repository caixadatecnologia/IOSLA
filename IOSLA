import sqlite3
from collections import deque
from html import escape as _html_escape

V016_MAX_INSN = 384
V016_MAX_FUNCTIONS_PER_IMAGE = 3000
V016_MAX_BLOCKS = 120
V016_MAX_EDGES = 240
V016_MAX_STEPS = 2000
V016_MAX_EVENTS = 60
V016_REPORT_ROWS = 1200
V016_HTML_ROWS = 450
V016_REPORT_TYPES = (
    'V016_CONTROL_FLOW','V016_DATAFLOW','V016_ABI_CONTRACTS',
    'V016_FUNCTION_ALIGNMENT','V016_MACHO_REFERENCES',

    lines=['# IOSLA v'+APP_VERSION+' — '+report.get('mode','Análise experimental'),'','**Somente leitura; ABI, compatibilidade e boot não comprovados.**','','## Resumo','',
       '```json',json.dumps(report.get('summary',{}),ensure_ascii=False,indent=2),'```','']
    for key in ('targets','images','candidates','subsystems','payloads','issues'):
        rows=report.get(key)

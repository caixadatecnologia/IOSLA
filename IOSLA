# ==========================================================================
# IOSLA v0.0.9 — MACH-O FILESET MAPPING & ABI RECOVERY
# This analyzer is offline, read-only; it never patches, signs or boots firmware.
# ==========================================================================

V009_MAX_COMMANDS = 8192
V009_MAX_SECTION_HASH = 32 * 1024 * 1024
V009_MAX_SEGMENTS = 512
V009_MAX_SECTIONS = 8192


def _v009_within(point: int, size: int, limit: int) -> bool:
    return isinstance(point, int) and isinstance(size, int) and 0 <= point <= limit and 0 <= size <= limit - point


def _v009_choose_coordinate(data: bytes, start: int, segments: list[dict], endian: str) -> dict:
    """Establish one fileset offset convention using evidence at the Mach-O header.

    A child fileset image's segments may be stored FAR outside the next
    LC_FILESET_ENTRY offset.  Only its load command header is limited by the
    neighbouring image start.  Do not guess from a distant segment's bytes.
    """
    text_segments = [s for s in segments if s['name'] == '__TEXT' and s['filesize'] >= 32]
    methods = {'fileset_absoluto': lambda s: s['fileoff'],
               'imagem_relativa': lambda s: start + s['fileoff']}
    found = []
    for kind, callback in methods.items():
        for seg in text_segments:
            point = callback(seg)
            if point == start and _v009_within(point, 32, len(data)) and data[point:point+4] in (MH_MAGIC_64, MH_CIGAM_64):
                found.append(kind)
    if start == 0 and found:
        # At the root, both coordinate systems are numerically identical.
        return {'state': 'resolvido', 'model': 'fileset_absoluto', 'anchor_models': sorted(set(found)),
                'anchor_offset': start}
    if len(set(found)) == 1:
        return {'state': 'resolvido', 'model': found[0], 'anchor_models': found, 'anchor_offset': start}
    if len(set(found)) > 1:
        return {'state': 'ambiguidade_entre_modelos', 'model': None, 'anchor_models': sorted(set(found))}
    return {'state': 'ancora_texto_nao_confirmada', 'model': None, 'anchor_models': []}


def _v009_map(data: bytes, image_start: int, coordinate: dict,
              offset: int, length: int, *, max_hash: int = V009_MAX_SECTION_HASH,
              containment: dict | None = None) -> dict:
    result = {'state': 'inconclusivo', 'chosen_model': coordinate.get('model'),
              'offset': None, 'hash_sha256': None, 'candidate_offsets': {}}
    if length < 0 or offset < 0:
        result['state'] = 'valor_invalido'
        return result
    model = coordinate.get('model')
    if coordinate.get('state') != 'resolvido' or model not in ('fileset_absoluto','imagem_relativa'):
        result['state'] = 'sistema_de_offsets_nao_determinado'
        return result
    candidate = offset if model == 'fileset_absoluto' else image_start + offset
    if not _v009_within(candidate, length, len(data)):
        result['state'] = 'fora_do_kernelcache_decodificado'
        return result
    if containment is not None:
        first, total = containment['offset'], containment['length']
        if not (first <= candidate and candidate + length <= first + total):
            result['state'] = 'fora_do_segmento_declarado'
            return result
    result['offset'] = candidate
    result['candidate_offsets'][model] = candidate
    if length > max_hash:
        result['state'] = 'resolvido_sem_hash_limite'
    else:
        result['state'] = 'resolvido'
        result['hash_sha256'] = hashlib.sha256(memoryview(data)[candidate:candidate+length]).hexdigest()
    return result


def _v009_scan_image(data: bytes, name: str, start: int, stop: int) -> dict:
    result = {'identifier': name, 'image_offset': start, 'image_region_end': stop,
              'status': 'indisponivel', 'coordinate_system': {}, 'mappings': {},
              'sections': {}, 'load_commands': {}, 'function_starts': {'state': 'comando_ausente'},
              'notes': [], 'binary_abi_proven': False}
    if not (0 <= start < stop <= len(data)) or stop - start < 32:
        result['notes'].append('Cabeçalho fora dos limites da entrada fileset.')
        return result
    magic = data[start:start+4]
    if magic not in (MH_MAGIC_64, MH_CIGAM_64):
        result['notes'].append('Assinatura Mach-O ausente na entrada fileset.')
        return result
    endian = '<' if magic == MH_MAGIC_64 else '>'
    try:
        h = struct.unpack_from(endian+'IiiIIIII', data, start)
    except struct.error:
        return result
    result.update({'cpu_type': h[1], 'cpu_subtype': h[2], 'macho_filetype': h[3]})
    commands, cmdsize = h[4], h[5]
    if commands > V009_MAX_COMMANDS or cmdsize > stop-start-32:
        result['status'] = 'load_commands_invalidos'
        return result
    pos, end = start+32, start+32+cmdsize
    segments = []
    sections = []
    links = []
    for _ in range(commands):
        if pos + 8 > end:
            result['status'] = 'load_commands_truncados'
            return result
        cmd, size = struct.unpack_from(endian+'II', data, pos)
        if size < 8 or pos+size > end:
            result['status'] = 'load_commands_invalidos'
            return result
        if cmd == LC_SEGMENT_64:
            if size < 72 or len(segments) >= V009_MAX_SEGMENTS:
                result['status'] = 'segmentos_invalidos'
                return result
            name16 = _v008_str16(data[pos+8:pos+24])
            vmaddr, vmsize, fileoff, filesize = struct.unpack_from(endian+'QQQQ', data, pos+24)
            nsects = struct.unpack_from(endian+'I', data, pos+64)[0]
            if nsects > V009_MAX_SECTIONS or 72+nsects*80 > size:
                result['status'] = 'secoes_invalidas'
                return result
            segments.append({'name': name16, 'vmaddr': vmaddr, 'vmsize': vmsize,
                             'fileoff': fileoff, 'filesize': filesize})
            for j in range(nsects):
                p = pos+72+j*80
                sn = _v008_str16(data[p:p+16])
                sg = _v008_str16(data[p+16:p+32])
                vm, length = struct.unpack_from(endian+'QQ',data,p+32)
                off = struct.unpack_from(endian+'I',data,p+48)[0]
                flags = struct.unpack_from(endian+'I',data,p+64)[0]
                if sn in ('__text','__unwind_info','__eh_frame','__const','__cstring'):
                    sections.append({'key':sg+','+sn,'segment':name16,'name':sn,
                                     'vmaddr':vm,'size':length,'fileoff':off,'flags':flags})
        elif cmd in (V008_LC_FUNCTION_STARTS, V008_LC_DATA_IN_CODE,
                     V008_LC_DYLD_CHAINED_FIXUPS,V008_LC_DYLD_EXPORTS_TRIE,V008_LC_CODE_SIGNATURE):
            if size >= 16:
                off, n = struct.unpack_from(endian+'II',data,pos+8)
                nm = {V008_LC_FUNCTION_STARTS:'LC_FUNCTION_STARTS',
                      V008_LC_DATA_IN_CODE:'LC_DATA_IN_CODE',
                      V008_LC_DYLD_CHAINED_FIXUPS:'LC_DYLD_CHAINED_FIXUPS',
                      V008_LC_DYLD_EXPORTS_TRIE:'LC_DYLD_EXPORTS_TRIE',
                      V008_LC_CODE_SIGNATURE:'LC_CODE_SIGNATURE'}[cmd]
                links.append((nm,off,n))
        pos += size
    result['status'] = 'macho_lido'
    coords = _v009_choose_coordinate(data,start,segments,endian)
    result['coordinate_system'] = coords
    for s in segments:
        filem = (_v009_map(data,start,coords,s['fileoff'],s['filesize'])
                 if s['filesize'] else {'state':'sem_dados'})
        result['mappings'][s['name']] = {**s,'file_mapping':filem}
    for s in sections:
        seg = next((x for x in segments if x['name'] == s['segment']),None)
        if seg is None or s['vmaddr'] < seg['vmaddr'] or s['size'] > seg['vmsize'] or s['vmaddr']-seg['vmaddr'] > seg['vmsize']-s['size']:
            mapping = {'state':'secao_fora_do_intervalo_virtual_do_segmento'}
        elif s['fileoff'] != seg['fileoff']+(s['vmaddr']-seg['vmaddr']):
            mapping = {'state':'offset_da_secao_inconsistente_com_segmento'}
        else:
            segmap = result['mappings'][seg['name']]['file_mapping']
            if segmap['state'] not in ('resolvido','resolvido_sem_hash_limite'):
                mapping = {'state':'segmento_nao_mapeado'}
            else:
                mapping = _v009_map(data,start,coords,s['fileoff'],s['size'],
                                    containment={'offset':segmap['offset'],'length':seg['filesize']})
        result['sections'][s['key']] = {'size':s['size'],'vmaddr':s['vmaddr'],
                                      'flags':s['flags'],'file_mapping':mapping}
    linkedit = result['mappings'].get('__LINKEDIT',{}).get('file_mapping')
    linkedit_info = result['mappings'].get('__LINKEDIT')
    for nm,off,n in links:
        if linkedit and linkedit.get('state') in ('resolvido','resolvido_sem_hash_limite'):
            containment={'offset':linkedit['offset'],'length':linkedit_info['filesize']}
        else:
            containment=None
        m = _v009_map(data,start,coords,off,n,max_hash=V009_MAX_SECTION_HASH,containment=containment)
        if containment is None and m['state']=='resolvido':
            m['validation_note']='Sem __LINKEDIT validado; localização apenas pelo modelo de offsets'
        result['load_commands'][nm]={'data_size':n,'file_mapping':m}
        if nm=='LC_FUNCTION_STARTS':
            result['function_starts']={'state':m['state'],'data_size':n}
            if m['state']=='resolvido':
                start_at = m['offset']
                fs = _v008_parse_starts(data[start_at:start_at+n])
                result['function_starts']={**fs,'data_size':n,'mapping':m['chosen_model'],
                                           'file_offset':start_at}
                main_text=next((x for x in segments if x['name']=='__TEXT'),None)
                if main_text and fs.get('count',0):
                    result['function_starts']['base_vmaddr']=main_text['vmaddr']
                    result['function_starts']['first_vmaddr']=main_text['vmaddr']+fs['first_delta_address']
                    result['function_starts']['last_vmaddr']=main_text['vmaddr']+fs['last_delta_address']
    if result['coordinate_system']['state'] != 'resolvido':
        result['notes'].append('Modelo de offsets não ancorado no cabeçalho Mach-O; não foram calculados hashes.')
    result['notes'].append('Segmentos podem estar fora da região contígua da entrada fileset; validação usa o kernelcache inteiro.')
    result['notes'].append('Hashes e contagem de funções não comprovam compatibilidade ABI.')
    return result


def _v009_scan_decoded(data: bytes, description: str) -> dict:
    entries, _ = _read_macho(data)
    byoff = {0:'com.apple.kernel'}
    for item in entries:
        pos = item.get('offset')
        if isinstance(pos,int) and 0 < pos < len(data) and pos not in byoff:
            byoff[pos]=str(item.get('name','unknown'))
    positions=sorted(byoff)
    if len(positions)>ABI_MAX_IMAGES:
        raise KernelFormatError('Mais imagens Mach-O do que o limite permitido.')
    images={}
    for i,start in enumerate(positions):
        stop=positions[i+1] if i+1<len(positions) else len(data)
        images[byoff[start]]=_v009_scan_image(data,byoff[start],start,stop)
    mapped_text = sum(any(k.endswith(',__text') and v.get('file_mapping',{}).get('state')=='resolvido'
                          for k,v in row['sections'].items()) for row in images.values())
    functions = sum(row.get('function_starts',{}).get('state')=='delimitado' for row in images.values())
    return {'format':description,'decoded_bytes':len(data),'images_analyzed':len(images),
            'images':images,'summary':{'images_with_mapped_text':mapped_text,
                                       'images_with_decoded_function_starts':functions},
            'limits':{'max_section_hash_bytes':V009_MAX_SECTION_HASH,'max_commands':V009_MAX_COMMANDS},
            'warnings':['Segmentos fileset são mapeados em coordenadas do kernelcache inteiro, confirmadas pelo cabeçalho __TEXT.',
                        'Correspondência ou diferença de bytes não determina ABI, funcionalidade ou boot.']}


# The original CLI calls _v008_scan_kernel; use v0.0.9 decode while retaining CLI compatibility.
def _v009_scan_kernel(path: str | Path) -> dict:
    p=Path(path).expanduser().resolve()
    if p.stat().st_size>MAX_INPUT:
        raise KernelFormatError('Kernelcache excede tamanho máximo suportado.')
    data,fmt,notes=_unwrap(p.read_bytes())
    report=_v009_scan_decoded(data,fmt)
    report['path']=str(p)
    report['parser_notes']=notes
    return report

_v008_scan_decoded=_v009_scan_decoded
_v008_scan_kernel=_v009_scan_kernel


def _v009_best_text(img:dict|None)->tuple[str,dict]|None:
    if not img:
        return None
    sections=img.get('sections',{})
    for name in ('__TEXT_EXEC,__text','__TEXT,__text'):
        if name in sections and sections[name].get('file_mapping',{}).get('state')=='resolvido':
            return name,sections[name]
    for name in ('__TEXT_EXEC,__text','__TEXT,__text'):
        if name in sections:
            return name,sections[name]
    return None


def _v009_outcome(a:dict|None,b:dict|None)->dict:
    if a is None or b is None:
        return {'state':'imagem_nao_observada_em_ambos'}
    aa,bb=_v009_best_text(a),_v009_best_text(b)
    if aa is None or bb is None:
        return {'state':'secao_executavel_nao_declarada_em_ambos'}
    one,two=aa[1]['file_mapping'],bb[1]['file_mapping']
    if one.get('state')!='resolvido' or two.get('state')!='resolvido':
        return {'state':'mapeamento_executavel_inconclusivo',
                'origem':one.get('state'), 'destino':two.get('state'),
                'origin_section':aa[0],'target_section':bb[0]}
    state='bytes_iguais' if one['hash_sha256']==two['hash_sha256'] and aa[1]['size']==bb[1]['size'] else 'bytes_diferentes'
    return {'state':state,'origin_section':aa[0],'target_section':bb[0],
            'origin_sha256':one['hash_sha256'],'target_sha256':two['hash_sha256'],
            'origin_size':aa[1]['size'],'target_size':bb[1]['size'],
            'interpretation':'Diferença/igualdade de bytes não indica compatibilidade ou incompatibilidade ABI.'}

_v008_section_outcome=_v009_outcome


def _v009_make_delta(scans:dict[str,dict])->dict:
    ai=scans.get('ORIGEM',{}).get('images',{})
    bi=scans.get('DESTINO',{}).get('images',{})
    ci=scans.get('CONTROLE',{}).get('images',{})
    ids=sorted(set(ai)|set(bi)|set(ci))
    pairs=[]
    for identifier in ids:
        row={}
        for k,images in (('origin',ai),('target',bi),('control',ci)):
            img=images.get(identifier)
            main=_v009_best_text(img)
            row[k]=({'status':img['status'],'coordinate_system':img.get('coordinate_system'),
                     'function_starts':img['function_starts'],
                     'text_section':main[0] if main else None,
                     'text_mapping':main[1]['file_mapping']['state'] if main else None}
                    if img else None)
        row.update({'identifier':identifier,'text_comparison':_v009_outcome(ai.get(identifier),bi.get(identifier)),
                    'origin_vs_control':_v009_outcome(ai.get(identifier),ci.get(identifier)) if 'CONTROLE' in scans else None,
                    'control_vs_target':_v009_outcome(ci.get(identifier),bi.get(identifier)) if 'CONTROLE' in scans else None})
        pairs.append(row)
    return {'iosla_version':APP_VERSION,'generated_at':datetime.now(timezone.utc).isoformat(),
            'mode':'Mach-O Fileset Mapping & ABI 2.0: evidências estruturais somente leitura',
            'summary':{'images_compared':len(pairs),
                       'states':dict(Counter(r['text_comparison']['state'] for r in pairs)),
                       'origin_images':len(ai),'target_images':len(bi),'control_images':len(ci),
                       'origin_vs_control_states':dict(Counter(r['origin_vs_control']['state'] for r in pairs)) if 'CONTROLE' in scans else {},
                       'control_vs_target_states':dict(Counter(r['control_vs_target']['state'] for r in pairs)) if 'CONTROLE' in scans else {},
                       'mapped_executable_sections_by_image':{label:scan.get('summary',{}).get('images_with_mapped_text',0)
                                                              for label,scan in scans.items()},
                       'function_starts_decoded_by_image':{label:scan.get('summary',{}).get('images_with_decoded_function_starts',0)
                                                           for label,scan in scans.items()}},
            'scans':{label:{'path':row.get('path'),'format':row.get('format'),'images_analyzed':row.get('images_analyzed'),
                            'summary':row.get('summary',{}),'parser_notes':row.get('parser_notes',[])}
                     for label,row in scans.items()},
            'images':pairs,

def _v007_snapshot_from_kext_report(data: dict, side: str) -> Snapshot:
    entry = data.get(side, {})
    if not isinstance(entry, dict):
        raise IOSLAError('Arquivo KEXT inválido: campo ' + side + ' ausente.')
    return Snapshot('ORIGEM' if side == 'source' else 'DESTINO',
                    entry.get('origin', 'relatorio'), 'report', parse_inventory(entry.get('kexts', [])),
                    ios_version=entry.get('ios_version', '?'), build=entry.get('build', '?'),
                    device=entry.get('device', '?'))


def _v007_from_reports(argv: list[str]) -> None:
    if len(argv) not in (4, 6):
        raise IOSLAError('Uso: --portability-from-reports KEXT.json EVIDENCIAS.json [ADT_ORIGEM.im4p ADT_DESTINO.im4p]')
    kexts = json.loads(Path(argv[2]).expanduser().read_text(encoding='utf-8'))
    prior = json.loads(Path(argv[3]).expanduser().read_text(encoding='utf-8'))
    if not isinstance(kexts, dict) or not isinstance(prior, dict):
        raise IOSLAError('Os dois relatórios devem conter objetos JSON.')
    snaps = {'ORIGEM': _v007_snapshot_from_kext_report(kexts, 'source'),
             'DESTINO': _v007_snapshot_from_kext_report(kexts, 'target')}
    trees = {}
    if len(argv) == 6:
        for label, name in (('ORIGEM', argv[4]), ('DESTINO', argv[5])):
            trees[label] = parse_apple_devicetree(Path(name).expanduser().read_bytes())
    report = make_portability_research({}, snaps, prior, prior.get('macho_structure'), decoded_trees=trees)
    ensure_home()
    jp, md = export_portability(report, REPORT_ROOT)
    print('Relatórios gerados:', jp, md, sep='\n - ')
    print('Teste cruzado de DeviceTree:', report['summary']['target_devicetree_test_executed'])
    if not trees:
        print('Modo relatórios: sem ADT decodificado, as associações do destino permanecem não avaliadas.')


